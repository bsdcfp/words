@media (max-width: 360px) {
  .view {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .hero-panel,
  .question-panel,
  .result-panel,
  .study-card,
  .audio-panel,
  .report-panel,
  .empty-state,
  .detail-card {
