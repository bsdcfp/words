}

.focus-primary {
  min-height: 116rpx;
  border-radius: 999rpx;
}

.focus-stack,
.review-stack {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.reveal-card {
  width: 100%;
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.reveal-card.ghost {
  min-height: 116rpx;
  border-radius: 26rpx;
  align-items: center;
  justify-content: center;
