}

.focus-reveal {
  min-height: 88rpx;
  border-radius: 26rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2c2b26;
  background: #fffdf9;
  border: 2rpx solid rgba(122, 98, 60, 0.1);
  font-size: 30rpx;
