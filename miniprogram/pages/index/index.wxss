/* ambient landscape at the page bottom: background layer (z -1), no layout height */
.level-landscape {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 300rpx;
  opacity: 0.85;
  pointer-events: none;
  z-index: -1;
}

.edge-wrong .focus-card {
  animation: edgeShake 300ms ease;
}

@keyframes edgeShake {
  0%, 100% {
    transform: translateX(0);
  }
  30% {
    transform: translateX(-8rpx);
  }
  70% {
    transform: translateX(8rpx);
  }
}

