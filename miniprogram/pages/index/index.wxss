}

.study-focus-card {
  display: grid;
  gap: 20rpx;
  padding: 38rpx 34rpx;
}

.study-focus-card .study-word {
  margin: 18rpx 0 0;
  font-size: 72rpx;
  letter-spacing: -2rpx;
}

.study-focus-card .meaning {
  margin: 0;
}

.study-tool-row {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tool-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
  min-height: 66rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  color: #665d55;
