.app-shell {
  min-height: 100vh;
  background: linear-gradient(180deg, #d5bea3 0%, #ded4c6 100%);
  overflow-x: hidden;
}

.view {
  width: 100%;
  max-width: 720px;
  min-height: 100vh;
  margin: 0 auto;
  padding: calc(env(safe-area-inset-top) + 32rpx) 28rpx calc(env(safe-area-inset-bottom) + 184rpx);
  box-sizing: border-box;
}

.topbar {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.topbar.compact {
  justify-content: flex-start;
}

.page-title,
.hero-title,
.test-word,
.study-word,
.detail-word {
  display: block;
  color: #221f1c;
  font-weight: 900;
  line-height: 1.18;
}

.page-title {
  font-size: 44rpx;
}

.eyebrow,
.section-label,
.muted,
.hint,
.option-sub {
  display: block;
  color: #776d64;
}

.eyebrow,
.section-label {
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.hero-panel,
.question-panel,
.result-panel,
.study-card,
.audio-panel,
.report-panel,
.empty-state,
.detail-card {
  background: rgba(255, 255, 255, 0.46);
  border: 2rpx solid rgba(54, 45, 39, 0.14);
  border-radius: 16rpx;
  padding: 36rpx;
  box-shadow: 0 28rpx 68rpx rgba(62, 48, 38, 0.16);
  box-sizing: border-box;
}

.hero-title {
  max-width: 100%;
  margin-bottom: 36rpx;
  font-size: 48rpx;
  word-break: break-word;
}

.primary-button,
.secondary-button,
.list-button,
.option-card,
.icon-button,
.text-link,
.segmented-button,
.sound-button,
.speaker-tile,
.sound-mini,
.select-toggle,
.word-link {
  border: 0;
  line-height: 1.2;
  margin: 0;
  box-sizing: border-box;
  max-width: 100%;
}

button::after {
  border: 0;
}

.primary-button,
.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 96rpx;
  border-radius: 16rpx;
  padding: 0 36rpx;
  font-weight: 900;
}

.primary-button {
  background: #0d8f7a;
  color: #fff;
}

.primary-button[disabled] {
  opacity: 0.45;
}

.primary-button.disabled {
  opacity: 0.38;
}

.primary-button.small {
  min-height: 84rpx;
}

.hero-panel .primary-button,
.result-panel .primary-button,
.report-panel .primary-button,
.empty-state .primary-button {
  min-width: 300rpx;
  margin: 0 auto;
}

.secondary-button {
  background: rgba(255, 255, 255, 0.72);
  color: #07705f;
}

.icon-button {
  display: flex;
  flex: 0 0 84rpx;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  min-width: 84rpx;
  max-width: 84rpx;
  height: 84rpx;
  padding: 0;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.54);
  color: #221f1c;
  font-size: 48rpx;
  text-align: center;
}

.topbar.compact .icon-button {
  flex: 0 0 84rpx;
  width: 84rpx;
  min-width: 84rpx;
  max-width: 84rpx;
}

.coach-strip,
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin: 28rpx 0;
}

.stats-grid {
  grid-template-columns: repeat(3, 1fr);
}

.coach-strip view,
.metric,
.info-strip view,
.copy-card,
.review-summary {
  border: 2rpx solid rgba(54, 45, 39, 0.14);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.56);
  padding: 24rpx;
  box-sizing: border-box;
}

.coach-strip text:first-child,
.strong,
.card-title {
  display: block;
  font-weight: 900;
}

.info-strip,
.action-list,
.option-stack,
.word-list,
.review-stack {
  display: grid;
  width: 100%;
  gap: 24rpx;
  margin: 28rpx 0;
}

.metric {
  text-align: center;
}

.metric text:first-child {
  display: block;
  font-size: 42rpx;
  font-weight: 900;
}

.metric text:last-child {
  display: block;
  color: #776d64;
  font-size: 24rpx;
}

.list-button {
  width: 100%;
  min-width: 0;
  justify-self: stretch;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  min-height: 148rpx;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  background: #f6f2ec;
  text-align: left;
}

.list-button text:first-child {
  display: block;
  font-weight: 900;
}

.list-button text:last-child {
  display: block;
  color: #776d64;
  font-size: 24rpx;
  text-align: right;
  word-break: break-word;
}

.progress-label {
  margin-left: auto;
  color: #776d64;
  font-weight: 900;
}

.test-word,
.study-word,
.detail-word {
  margin: 24rpx 0;
  font-size: 64rpx;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.option-card {
  display: block;
  width: 100%;
  min-height: 108rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #fff;
  color: #221f1c;
  text-align: left;
  font-weight: 800;
  white-space: normal;
  overflow: hidden;
  word-break: break-word;
}

.option-card.correct {
  background: #d9f2e9;
  color: #07705f;
}

.option-card.wrong {
  background: #f6d4d2;
  color: #a94240;
}

.option-card.muted-card {
  opacity: 0.45;
}

.option-pos {
  margin-right: 10rpx;
  color: #0d8f7a;
}

.unknown-button {
  width: 100%;
  margin-top: 24rpx;
}

.counter-bar,
.bottom-actions {
  position: fixed;
  left: 50%;
  bottom: calc(env(safe-area-inset-bottom) + 28rpx);
  width: calc(100vw - 56rpx);
  max-width: 720px;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(246, 242, 236, 0.94);
  box-shadow: 0 20rpx 48rpx rgba(62, 48, 38, 0.16);
  box-sizing: border-box;
}

.precheck-actions {
  display: grid;
  grid-template-columns: 92rpx minmax(0, 1fr) minmax(0, 1fr);
  align-items: center;
}

.precheck-view {
  position: relative;
  height: 100vh;
  min-height: 0;
  overflow: hidden;
  padding-bottom: 0;
}

.precheck-view .topbar {
  min-height: 68rpx;
  gap: 18rpx;
  margin-bottom: 16rpx;
}

.precheck-view .icon-button {
  flex-basis: 64rpx;
  width: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  font-size: 38rpx;
}

.precheck-view .page-title {
  font-size: 38rpx;
  letter-spacing: -1rpx;
}

.precheck-scroll {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 132rpx);
  right: 0;
  bottom: calc(env(safe-area-inset-bottom) + 154rpx);
  left: 0;
  height: auto;
  min-height: 0;
  overflow-x: hidden;
  box-sizing: border-box;
}

.precheck-view .word-list {
  width: 100%;
  box-sizing: border-box;
  gap: 14rpx;
  margin: 0;
  padding: 0 52rpx 22rpx;
}

.precheck-list {
  width: 100%;
  min-width: 0;
  overflow-x: hidden;
  box-sizing: border-box;
}

.precheck-view .precheck-actions {
  width: calc(100vw - 104rpx);
  max-width: 668px;
  grid-template-columns: 76rpx minmax(0, 1fr) minmax(0, 1fr);
  padding: 14rpx 16rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(30, 55, 49, 0.98), rgba(13, 143, 122, 0.92));
  box-shadow: 0 22rpx 54rpx rgba(22, 39, 35, 0.28);
}

.bottom-actions.two {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  align-items: stretch;
}

.bottom-actions.status-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 176rpx;
  align-items: center;
}

.status-actions text {
  display: block;
  min-width: 0;
  color: #776d64;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-word;
}

.status-actions .goal-hint {
  margin-top: 4rpx;
  color: #0d8f7a;
  font-size: 22rpx;
  font-weight: 800;
}

.bottom-actions .primary-button,
.bottom-actions .secondary-button {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  padding: 0 20rpx;
  overflow: hidden;
}

.pill {
  min-width: 72rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  color: #fff;
  text-align: center;
  font-weight: 900;
}

.green {
  background: #0d8f7a;
}

.red {
  background: #cf5f5d;
}

.blue {
  background: #4f87c7;
}

.vocab-number {
  display: block;
  margin: 24rpx 0;
  font-size: 96rpx;
  font-weight: 900;
  color: #0d8f7a;
}

.precheck-row,
.review-card {
  padding: 28rpx;
  border: 2rpx solid rgba(54, 45, 39, 0.14);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.62);
  box-sizing: border-box;
}

.precheck-row {
  display: grid;
  gap: 22rpx;
}

.precheck-view .precheck-row {
  width: 100%;
  min-width: 0;
  gap: 10rpx;
  padding: 16rpx 22rpx;
  border-color: rgba(54, 45, 39, 0.1);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.58);
  box-shadow: 0 14rpx 36rpx rgba(62, 48, 38, 0.08);
  overflow: hidden;
}

.precheck-head {
  display: grid;
  grid-template-columns: 44rpx minmax(0, 1fr) 68rpx;
  align-items: center;
  gap: 18rpx;
}

.precheck-view .precheck-head {
  grid-template-columns: 34rpx minmax(0, 1fr) 52rpx;
  gap: 14rpx;
  min-width: 0;
}

.precheck-row.picked {
  border-color: #0d8f7a;
}

.index {
  color: #776d64;
  font-weight: 900;
}

.precheck-view .index {
  font-size: 28rpx;
}

.select-toggle,
.sound-mini {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #fff;
  color: #0d8f7a;
  font-weight: 900;
}

.select-toggle {
  width: 64rpx;
  height: 64rpx;
}

.precheck-view .select-toggle {
  width: 52rpx;
  height: 52rpx;
  font-size: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(13, 143, 122, 0.1);
}

.select-toggle.on {
  background: #0d8f7a;
  color: #fff;
}

.sound-mini {
  width: 124rpx;
  min-width: 124rpx;
  height: 72rpx;
  font-size: 26rpx;
}

.word-link {
  display: block;
  min-width: 0;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.84);
  text-align: center;
  font-size: 40rpx;
  font-weight: 900;
  overflow-wrap: anywhere;
  line-height: 1.15;
}

.precheck-view .word-link {
  padding: 8rpx 20rpx;
  font-size: 32rpx;
  background: rgba(255, 255, 255, 0.92);
}

.meaning-inline {
  display: block;
  padding-left: 62rpx;
  color: #776d64;
  font-size: 32rpx;
  font-weight: 800;
  word-break: break-word;
}

.meaning-inline text {
  margin-right: 10rpx;
  color: #0d8f7a;
}

.precheck-view .meaning-inline {
  padding-left: 48rpx;
  font-size: 25rpx;
  line-height: 1.3;
}

.segmented {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.precheck-view .segmented {
  gap: 12rpx;
  min-width: 0;
}

.segmented-button {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #f6f2ec;
  color: #776d64;
  font-weight: 800;
  box-sizing: border-box;
}

.precheck-view .segmented-button {
  min-height: 54rpx;
  border-radius: 14rpx;
  background: rgba(255, 251, 244, 0.76);
  font-size: 26rpx;
}

.segmented .selected {
  background: #d9f2e9;
  color: #07705f;
}

.segmented .danger {
  background: #f6d4d2;
  color: #a94240;
}

.selection-count {
  display: block;
  color: #221f1c;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: center;
}

.precheck-view .selection-count {
  padding: 8rpx 6rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
  font-size: 23rpx;
}

.precheck-view .bottom-actions .primary-button,
.precheck-view .bottom-actions .secondary-button {
  min-height: 72rpx;
  font-size: 28rpx;
}

.precheck-view .bottom-actions .secondary-button {
  background: rgba(255, 255, 255, 0.92);
  color: #0b6f61;
}

.precheck-view .bottom-actions .primary-button {
  background: #f4d98b;
  color: #173b34;
}

.precheck-view .bottom-actions .primary-button.disabled {
  background: rgba(255, 255, 255, 0.3);
  color: rgba(255, 255, 255, 0.68);
  opacity: 1;
}

.memory-image {
  display: grid;
  gap: 10rpx;
  margin: 24rpx 0;
  padding: 28rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(13, 143, 122, 0.16), rgba(229, 140, 67, 0.2));
}

.memory-mark {
  color: #07705f;
  font-weight: 900;
}

.speaker-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  margin: 16rpx 0;
  border-radius: 999rpx;
  background: #221f1c;
  color: #fff;
  font-weight: 900;
}

.sound-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 148rpx;
  min-height: 58rpx;
  margin: 4rpx 0 8rpx;
  padding: 0 26rpx;
  border: 2rpx solid rgba(13, 143, 122, 0.22);
  border-radius: 999rpx;
  background: rgba(13, 143, 122, 0.1);
  color: #07705f;
  font-size: 25rpx;
  font-weight: 900;
}

.speaker-tile {
  width: 200rpx;
  height: 200rpx;
  border-radius: 56rpx;
  font-size: 36rpx;
}

.ipa {
  display: block;
  margin: 10rpx 0;
  color: #776d64;
}

.meaning {
  display: block;
  margin: 16rpx 0;
  font-size: 34rpx;
  font-weight: 900;
  word-break: break-word;
}

.meaning text {
  margin-right: 12rpx;
  color: #0d8f7a;
}

.text-link {
  display: inline-block;
  padding: 0;
  background: transparent;
  color: #07705f;
  text-align: left;
  font-weight: 900;
}

.centered {
  display: block;
  margin: 24rpx auto 0;
}

.review-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.review-copy {
  flex: 1;
  min-width: 0;
}

.review-card text {
  display: block;
  min-width: 0;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.review-summary {
  display: grid;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.report-ring {
  display: flex;
  width: 220rpx;
  height: 220rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: #0d8f7a;
  color: #fff;
  font-size: 56rpx;
  font-weight: 900;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 10;
  padding: calc(env(safe-area-inset-top) + 64rpx) 28rpx calc(env(safe-area-inset-bottom) + 28rpx);
  background: rgba(34, 31, 28, 0.42);
  box-sizing: border-box;
}

.transition-mask {
  position: fixed;
  inset: 0;
  z-index: 9;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(34, 31, 28, 0.18);
  box-sizing: border-box;
}

.transition-card {
  display: grid;
  gap: 10rpx;
  min-width: 0;
  width: calc(100vw - 104rpx);
  max-width: 616px;
  padding: 36rpx 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 24rpx;
  background: rgba(255, 251, 244, 0.92);
  box-shadow: 0 24rpx 72rpx rgba(34, 31, 28, 0.22);
  text-align: center;
  box-sizing: border-box;
}

.transition-card text:first-child {
  color: #221f1c;
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 900;
  word-break: break-word;
}

.transition-card text:last-child {
  color: #776d64;
  font-size: 26rpx;
  line-height: 1.3;
  font-weight: 800;
  word-break: break-word;
}

.notice-mask {
  background: rgba(34, 31, 28, 0.18);
}

.detail-card {
  position: relative;
  width: 100%;
  max-width: 680px;
  max-height: 84vh;
  margin: 0 auto;
  overflow: auto;
  background: #f6f2ec;
}

.close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
}

.empty-state {
  display: grid;
  gap: 24rpx;
  text-align: center;
}

.home-view,
.profile-view {
  padding-bottom: calc(env(safe-area-inset-bottom) + 148rpx);
}

.profile-chip,
.level-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.58);
  color: #221f1c;
  font-size: 26rpx;
  font-weight: 900;
}

.plan-panel,
.profile-hero,
.profile-card,
.level-panel,
.study-focus-card,
.boot-error-card {
  width: 100%;
  min-width: 0;
  border: 2rpx solid rgba(54, 45, 39, 0.12);
  border-radius: 24rpx;
  background: rgba(255, 251, 244, 0.62);
  box-shadow: 0 24rpx 60rpx rgba(62, 48, 38, 0.13);
  box-sizing: border-box;
}

.plan-panel {
  display: grid;
  gap: 24rpx;
  padding: 40rpx 36rpx;
}

.boot-error-card {
  display: grid;
  gap: 18rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.72);
}

.plan-panel .hero-title {
  margin-bottom: 0;
}

.plan-copy {
  display: block;
  color: #665d55;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
}

.plan-panel .primary-button {
  width: 100%;
  margin: 6rpx 0 0;
}

.plan-grid,
.profile-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin: 24rpx 0;
}

.plan-grid view,
.profile-grid view {
  min-width: 0;
  padding: 24rpx 12rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.48);
  text-align: center;
  box-sizing: border-box;
}

.plan-grid text:first-child,
.profile-grid text:first-child {
  display: block;
  color: #221f1c;
  font-size: 42rpx;
  font-weight: 900;
}

.plan-grid text:last-child,
.profile-grid text:last-child {
  display: block;
  color: #776d64;
  font-size: 23rpx;
  font-weight: 800;
}

.today-card {
  display: grid;
  gap: 16rpx;
}

.today-card view {
  padding: 26rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.42);
  box-sizing: border-box;
}

.tab-bar {
  position: fixed;
  left: 50%;
  bottom: calc(env(safe-area-inset-bottom) + 22rpx);
  z-index: 7;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  width: calc(100vw - 56rpx);
  max-width: 680px;
  padding: 10rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 24rpx;
  background: rgba(37, 76, 68, 0.92);
  box-shadow: 0 20rpx 54rpx rgba(22, 39, 35, 0.24);
  transform: translateX(-50%);
  box-sizing: border-box;
}

.tab-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  border-radius: 18rpx;
  color: rgba(255, 255, 255, 0.78);
  font-weight: 900;
}

.tab-item.active {
  background: rgba(255, 255, 255, 0.92);
  color: #0b6f61;
}

.profile-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 34rpx;
}

.profile-book {
  display: block;
  margin-bottom: 10rpx;
  color: #221f1c;
  font-size: 42rpx;
  font-weight: 900;
}

.profile-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.profile-card {
  display: grid;
  gap: 24rpx;
  padding: 30rpx;
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.week-row {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 10rpx;
}

.week-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.56);
  color: #776d64;
  font-size: 24rpx;
  font-weight: 900;
}

.week-dot.active {
  background: rgba(13, 143, 122, 0.16);
  color: #07705f;
}

.profile-list {
  display: grid;
  gap: 18rpx;
  margin-top: 24rpx;
}

.level-panel {
  display: grid;
  gap: 30rpx;
  padding: 34rpx;
}

.level-group {
  display: grid;
  gap: 16rpx;
}

.level-title {
  color: #776d64;
  font-size: 28rpx;
  font-weight: 900;
}

.level-options {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.level-option {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 74rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #221f1c;
  font-size: 26rpx;
  font-weight: 900;
}

.study-view {
  padding-bottom: calc(env(safe-area-inset-bottom) + 168rpx);
}

.study-focus-card {
  display: grid;
  gap: 20rpx;
  padding: 38rpx 34rpx;
}

.study-focus-card .study-word {
  margin: 18rpx 0 0;
  font-size: 72rpx;
  letter-spacing: -2rpx;
}

.study-focus-card .meaning {
  margin: 0;
}

.study-tool-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.tool-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 66rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  color: #665d55;
  font-size: 25rpx;
  font-weight: 900;
}

.tool-button.active,
.tool-button.primary {
  background: #0d8f7a;
  color: #fff;
}

.audio-view {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-bottom: calc(env(safe-area-inset-bottom) + 168rpx);
}

.audio-minimal {
  display: grid;
  gap: 28rpx;
  padding: 38rpx 34rpx;
}

.audio-minimal .speaker-tile {
  width: 168rpx;
  height: 168rpx;
  min-height: 168rpx;
  margin: 0 auto;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #0d8f7a;
  box-shadow: 0 18rpx 42rpx rgba(13, 143, 122, 0.14);
  font-size: 30rpx;
}

.audio-minimal .option-stack {
  margin: 0;
  gap: 18rpx;
}

.audio-tools {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.audio-tools view {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.56);
  color: #07705f;
  font-weight: 900;
}

@media (max-width: 360px) {
  .view {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .hero-panel,
  .question-panel,
  .result-panel,
  .study-card,
  .audio-panel,
  .report-panel,
  .empty-state,
  .detail-card {
    padding: 28rpx;
  }

  .hero-title {
    font-size: 42rpx;
  }

  .page-title {
    font-size: 40rpx;
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .list-button {
    align-items: stretch;
    flex-direction: column;
  }

  .bottom-actions .primary-button,
  .bottom-actions .secondary-button {
    width: 100%;
  }

  .test-word,
  .study-word,
  .detail-word {
    font-size: 56rpx;
  }
}

@media (min-width: 520px) {
  .view {
    padding-left: 40rpx;
    padding-right: 40rpx;
  }

  .hero-title {
    font-size: 56rpx;
  }

  .page-title {
    font-size: 48rpx;
  }

  .hero-panel,
  .question-panel,
  .result-panel,
  .study-card,
  .audio-panel,
  .report-panel,
  .empty-state,
  .detail-card {
    padding: 44rpx;
  }

  .coach-strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .info-strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
