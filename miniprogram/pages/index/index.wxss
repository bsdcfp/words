/* V2 visual system: reference-driven overrides */
.app-shell {
  --v2-bg: #071216;
  --v2-panel: rgba(13, 27, 31, 0.88);
  --v2-panel-2: rgba(17, 35, 39, 0.78);
  --v2-card: rgba(255, 255, 255, 0.055);
  --v2-border: rgba(138, 232, 215, 0.2);
  --v2-text: #f6f2e8;
  --v2-muted: rgba(246, 242, 232, 0.62);
  --v2-green: #65d6bf;
  --v2-green-deep: #216f65;
  --v2-amber: #d58a43;
  --v2-amber-light: #efb45c;
  --v2-danger: #c76b4e;
  display: block;
  min-height: 100vh;
  background:
    radial-gradient(circle at 54% 18%, rgba(72, 187, 166, 0.14), transparent 32%),
    radial-gradient(circle at 0% 80%, rgba(213, 138, 67, 0.12), transparent 36%),
    linear-gradient(180deg, #081316 0%, #061013 100%);
  color: var(--v2-text);
}

.app-shell.learning-light {
  --v2-bg: #f8f5ec;
  --v2-panel: rgba(255, 253, 247, 0.86);
  --v2-panel-2: rgba(245, 241, 231, 0.78);
  --v2-card: rgba(255, 255, 255, 0.72);
  --v2-border: rgba(43, 95, 84, 0.16);
  --v2-text: #17313a;
  --v2-muted: rgba(23, 49, 58, 0.58);
  --v2-green: #347d70;
  --v2-green-deep: #2b6f65;
  --v2-amber: #e2a13c;
  --v2-amber-light: #efb85d;
  --v2-danger: #b76547;
  background:
    radial-gradient(circle at 20% 18%, rgba(52, 125, 112, 0.1), transparent 28%),
    radial-gradient(circle at 92% 78%, rgba(226, 161, 60, 0.14), transparent 34%),
    linear-gradient(180deg, #fbf8ef 0%, #efe8d9 100%);
  color: var(--v2-text);
}

.app-shell .view {
  color: var(--v2-text);
}

.app-shell .page-title,
.app-shell .hero-title,
.app-shell .test-word,
.app-shell .study-word,
.app-shell .detail-word,
.app-shell .card-title {
  color: var(--v2-text);
}

.app-shell .muted,
.app-shell .eyebrow,
.app-shell .section-label,
.app-shell .progress-label {
  color: var(--v2-muted);
}

.home-view {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  padding: calc(env(safe-area-inset-top) + 44rpx) 42rpx calc(env(safe-area-inset-bottom) + 190rpx);
  background: transparent;
}

.home-hero {
  display: grid;
  justify-items: center;
  gap: 14rpx;
  margin: 10rpx 0 34rpx;
  text-align: center;
}

.home-hero .page-title {
  font-size: 40rpx;
  letter-spacing: 0;
}

.book-illustration {
  position: relative;
  width: 210rpx;
  height: 148rpx;
  margin-bottom: 8rpx;
}

.book-illustration view:nth-child(1),
.book-illustration view:nth-child(2) {
  position: absolute;
  bottom: 14rpx;
  width: 92rpx;
  height: 74rpx;
  border: 2rpx solid rgba(101, 214, 191, 0.28);
  background:
    linear-gradient(135deg, rgba(246, 242, 232, 0.16), rgba(101, 214, 191, 0.08));
  box-shadow: 0 20rpx 54rpx rgba(0, 0, 0, 0.22);
}

.book-illustration view:nth-child(1) {
  left: 18rpx;
  border-radius: 8rpx 22rpx 16rpx 8rpx;
  transform: skewY(9deg) rotate(-7deg);
}

.book-illustration view:nth-child(2) {
  right: 18rpx;
  border-radius: 22rpx 8rpx 8rpx 16rpx;
  transform: skewY(-9deg) rotate(7deg);
}

.book-illustration view:nth-child(3) {
  position: absolute;
  left: 88rpx;
  bottom: 20rpx;
  width: 34rpx;
  height: 92rpx;
  border-radius: 10rpx;
  background: linear-gradient(180deg, var(--v2-green), rgba(101, 214, 191, 0.22));
}

.book-progress-card,
.plan-panel,
.home-action-card,
.profile-hero,
.profile-card,
.level-panel,
.month-panel,
.question-panel,
.result-panel,
.report-panel,
.review-summary,
.review-card,
.empty-state {
  border: 2rpx solid var(--v2-border);
  border-radius: 24rpx;
  background: var(--v2-panel);
  box-shadow: 0 28rpx 80rpx rgba(0, 0, 0, 0.26);
}

.app-shell.learning-light .book-progress-card,
.app-shell.learning-light .plan-panel,
.app-shell.learning-light .home-action-card,
.app-shell.learning-light .profile-hero,
.app-shell.learning-light .profile-card,
.app-shell.learning-light .level-panel,
.app-shell.learning-light .month-panel,
.app-shell.learning-light .question-panel,
.app-shell.learning-light .result-panel,
.app-shell.learning-light .report-panel,
.app-shell.learning-light .review-summary,
.app-shell.learning-light .review-card,
.app-shell.learning-light .empty-state {
  box-shadow: 0 20rpx 60rpx rgba(49, 63, 49, 0.12);
}

.book-progress-card {
  display: grid;
  gap: 18rpx;
  padding: 26rpx 28rpx;
}

.book-name {
  display: block;
  color: var(--v2-text);
  font-size: 28rpx;
  font-weight: 900;
}

.progress-track {
  width: 100%;
  height: 8rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(246, 242, 232, 0.12);
}

.app-shell.learning-light .progress-track {
  background: rgba(23, 49, 58, 0.1);
}

.progress-track view {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--v2-green), var(--v2-amber-light));
}

.progress-meta {
  color: var(--v2-muted);
  font-size: 22rpx;
  font-weight: 800;
}

.plan-panel {
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 30rpx 30rpx 28rpx;
  background:
    radial-gradient(circle at 88% 22%, rgba(213, 138, 67, 0.2), transparent 28%),
    var(--v2-panel);
}

.plan-panel::after {
  display: none;
}

.plan-panel .hero-title {
  font-size: 38rpx;
  letter-spacing: 0;
}

.flag-row {
  display: flex;
  gap: 12rpx;
  color: var(--v2-amber);
  font-size: 48rpx;
  line-height: 1;
}

.flag-row .done {
  color: var(--v2-green);
}

.flag-row .todo {
  color: var(--v2-amber);
}

.plan-copy {
  color: var(--v2-muted);
  font-size: 25rpx;
  line-height: 1.55;
}

.primary-button {
  border-radius: 999rpx;
  background: linear-gradient(180deg, var(--v2-amber-light), var(--v2-amber));
  color: #fff7eb;
  box-shadow: 0 16rpx 40rpx rgba(213, 138, 67, 0.24);
}

.secondary-button {
  border: 2rpx solid var(--v2-border);
  border-radius: 999rpx;
  background: rgba(246, 242, 232, 0.06);
  color: var(--v2-green);
}

.plan-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin: 22rpx 0;
}

.plan-grid view,
.profile-grid view {
  border: 2rpx solid var(--v2-border);
  background: var(--v2-card);
}

.plan-grid text:first-child,
.profile-grid text:first-child {
  color: var(--v2-green);
  font-size: 38rpx;
}

.plan-grid text:last-child,
.profile-grid text:last-child {
  color: var(--v2-muted);
}

.home-action-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 42rpx;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 46rpx;
  padding: 24rpx 28rpx;
}

.tab-bar {
  border-color: var(--v2-border);
  background: rgba(5, 14, 17, 0.86);
}

.app-shell.learning-light .tab-bar {
  background: rgba(255, 253, 247, 0.9);
}

.tab-item {
  color: var(--v2-muted);
}

.tab-item.active {
  background: rgba(101, 214, 191, 0.14);
  color: var(--v2-green);
}

.entry-arrow {
  background: rgba(101, 214, 191, 0.12);
  color: var(--v2-green) !important;
}

.precheck-view {
  background: transparent;
}

.precheck-view .topbar,
.sticky-view .topbar {
  background:
    linear-gradient(180deg, rgba(7, 18, 22, 0.98) 0%, rgba(7, 18, 22, 0.78) 70%, rgba(7, 18, 22, 0) 100%);
}

.app-shell.learning-light .precheck-view .topbar,
.app-shell.learning-light .sticky-view .topbar {
  background:
    linear-gradient(180deg, rgba(248, 245, 236, 0.98) 0%, rgba(248, 245, 236, 0.78) 70%, rgba(248, 245, 236, 0) 100%);
}

.precheck-view .precheck-card-single {
  border-color: var(--v2-border);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.035)),
    var(--v2-panel);
  box-shadow:
    0 26rpx 80rpx rgba(0, 0, 0, 0.32),
    inset 0 -14rpx 0 rgba(0, 0, 0, 0.12);
}

.app-shell.learning-light .precheck-view .precheck-card-single {
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(246, 242, 232, 0.74));
  box-shadow: 0 24rpx 64rpx rgba(49, 63, 49, 0.14);
}

.precheck-view .precheck-card-single .word-link {
  color: var(--v2-text);
  font-family: Georgia, "Times New Roman", serif;
  font-weight: 600;
}

.precheck-view .segmented-button.known,
.precheck-view .segmented-button.unfamiliar {
  border: 0;
  background: transparent;
  color: var(--v2-green);
}

.precheck-view .segmented-button.unfamiliar {
  color: var(--v2-danger);
}

.precheck-view .precheck-actions {
  border-color: var(--v2-border);
  background: rgba(5, 14, 17, 0.92);
}

.app-shell.learning-light .precheck-view .precheck-actions {
  background: rgba(255, 253, 247, 0.94);
}

.precheck-view .selection-count {
  background: transparent;
  color: var(--v2-muted);
}

.learning-view.learning-dark,
.focus-flow.learning-dark {
  background:
    radial-gradient(circle at 72% 28%, rgba(101, 214, 191, 0.13), transparent 36%),
    linear-gradient(180deg, #071216 0%, #040b0d 100%);
}

.focus-card .study-word,
.focus-card .test-word {
  font-family: Georgia, "Times New Roman", serif;
  color: var(--v2-text);
  font-weight: 600;
}

.focus-card .ipa {
  color: var(--v2-muted);
}

.focus-card .meaning {
  color: var(--v2-text);
}

.focus-card .meaning text,
.option-pos {
  color: var(--v2-green);
}

.focus-dot.done,
.focus-dot.current {
  border-color: var(--v2-green);
  background: var(--v2-green);
}

.focus-dot.current {
  box-shadow: 0 0 0 8rpx rgba(101, 214, 191, 0.12);
}

.focus-primary {
  max-width: 560rpx;
  margin: 0 auto;
}

.focus-reveal,
.meaning-recall-prompt,
.meaning-word-reveal.visible {
  border: 2rpx solid var(--v2-border);
  background: var(--v2-panel-2);
  color: var(--v2-text);
}

.focus-speaker {
  border: 2rpx solid rgba(101, 214, 191, 0.46);
  background:
    radial-gradient(circle, rgba(101, 214, 191, 0.18), rgba(101, 214, 191, 0.04));
  box-shadow:
    0 0 0 20rpx rgba(101, 214, 191, 0.06),
    0 0 80rpx rgba(101, 214, 191, 0.28);
}

.profile-view {
  padding: calc(env(safe-area-inset-top) + 24rpx) 34rpx calc(env(safe-area-inset-bottom) + 136rpx);
  background: transparent;
}

.profile-view .topbar {
  margin-bottom: 22rpx;
}

.profile-hero {
  padding: 24rpx;
}

.profile-book {
  color: var(--v2-text);
  font-size: 32rpx;
}

.level-pill,
.profile-chip,
.icon-button {
  background: rgba(101, 214, 191, 0.12);
  color: var(--v2-green);
}

.profile-card,
.profile-list {
  margin-top: 18rpx;
}

.level-option {
  border-color: var(--v2-border);
  background: var(--v2-card);
  color: var(--v2-text);
  box-shadow: none;
}

.level-option.enabled,
.level-option.selected {
  border-color: rgba(101, 214, 191, 0.42);
  background: rgba(101, 214, 191, 0.1);
}

.level-option.disabled {
  color: var(--v2-muted);
  background: rgba(255, 255, 255, 0.035);
}

.action-entry {
  border-color: var(--v2-border);
  background: var(--v2-card);
}

.action-entry::before {
  background: var(--v2-green);
}

.month-calendar,
.month-picker,
.month-switch view,
.month-day,
.week-dot,
.today-card view,
.copy-card,
.metric {
  border-color: var(--v2-border);
  background: var(--v2-card);
  color: var(--v2-text);
}

.report-panel.celebration-panel {
  background:
    radial-gradient(circle at 50% 14%, rgba(213, 138, 67, 0.22), transparent 28%),
    var(--v2-panel);
}

.celebration-panel .report-ring {
  background:
    radial-gradient(circle at 36% 28%, rgba(255, 255, 255, 0.36), transparent 34%),
    linear-gradient(145deg, var(--v2-green-deep), var(--v2-amber));
  color: #fff7eb;
}

/* V2 icon elements: deterministic WXML/CSS shapes instead of emoji or text glyphs. */
.ui-icon {
  position: relative;
  display: inline-flex;
  width: 36rpx;
  height: 36rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  color: currentColor;
  box-sizing: border-box;
}

.ui-icon::before,
.ui-icon::after {
  position: absolute;
  display: block;
  content: "";
  box-sizing: border-box;
}

.icon-button .ui-icon {
  color: inherit;
}

.icon-back,
.icon-chevron {
  width: 28rpx;
  height: 28rpx;
}

.icon-back::before,
.icon-chevron::before {
  width: 16rpx;
  height: 16rpx;
  border-top: 5rpx solid currentColor;
  border-right: 5rpx solid currentColor;
  border-radius: 3rpx;
}

.icon-back::before {
  transform: rotate(-135deg);
}

.icon-chevron::before {
  transform: rotate(45deg);
}

.entry-arrow.ui-icon {
