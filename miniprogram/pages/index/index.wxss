  background:
    radial-gradient(circle at 50% 12%, rgba(120, 168, 150, 0.08), transparent 28%),
    linear-gradient(180deg, #fcf9f3 0%, #f7f2e8 50%, #f2ecdf 100%);
}

.focus-pause-handle {
  position: fixed;
  z-index: 16;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 34rpx;
  min-height: 320rpx;
  border-radius: 0 16rpx 16rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: rgba(44, 43, 38, 0.42);
  background: rgba(255, 255, 255, 0.6);
  font-size: 20rpx;
}

.focus-progress {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.focus-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(77, 132, 120, 0.18);
}

.focus-dot.done {
  background: #4d8478;
}

.focus-dot.current {
  background: #4d8478;
