/* V2 UI layer rewrite: clean visual system over the existing study engine. */

page,
view,
text,
image {
  box-sizing: border-box;
}

.app-shell {
  min-height: 100vh;
  color: #141413;
  background:
    radial-gradient(circle at 16% 2%, rgba(103, 216, 200, 0.2), transparent 28%),
    radial-gradient(circle at 88% 20%, rgba(255, 194, 116, 0.2), transparent 26%),
    linear-gradient(180deg, #fffaf1 0%, #f8f5ec 42%, #efe4d6 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif;
}

.view {
  position: relative;
  min-height: 100vh;
  padding: 36rpx 36rpx 168rpx;
  overflow: hidden;
}

.sticky-view {
  overflow: visible;
}

.muted {
  display: block;
  color: #6e6a62;
  font-size: 24rpx;
  line-height: 1.55;
}

.section-label {
  display: block;
  color: #0f8f7a;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.card-title {
  display: block;
  color: #141413;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
}

.strong {
  font-weight: 900;
}

.primary-button,
.secondary-button {
  min-height: 88rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 34rpx;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1;
}

.primary-button {
  color: #ffffff;
  background: linear-gradient(135deg, #0f8f7a 0%, #67d8c8 100%);
  box-shadow: 0 18rpx 34rpx rgba(15, 143, 122, 0.22);
}

.secondary-button {
  color: #0f8f7a;
  background: #ffffff;
  border: 2rpx solid rgba(15, 143, 122, 0.22);
}

.home-cta-pressed,
.action-entry-pressed,
.level-option-pressed,
.test-option-pressed,
.review-card-pressed {
  opacity: 0.84;
  transform: scale(0.985);
}

.ui-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  flex: 0 0 36rpx;
}

.icon-chevron::before {
  content: "";
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  top: 9rpx;
  left: 8rpx;
  border-top: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.icon-back::before {
  content: "";
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  top: 7rpx;
  left: 11rpx;
  border-left: 5rpx solid currentColor;
  border-bottom: 5rpx solid currentColor;
  transform: rotate(45deg);
}

.icon-close::before,
.icon-close::after {
  content: "";
  position: absolute;
  width: 28rpx;
  height: 4rpx;
  top: 16rpx;
  left: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.icon-close::before {
  transform: rotate(45deg);
}

.icon-close::after {
  transform: rotate(-45deg);
}

.icon-check::before {
  content: "";
  position: absolute;
  width: 20rpx;
  height: 11rpx;
  top: 8rpx;
  left: 7rpx;
  border-left: 5rpx solid currentColor;
  border-bottom: 5rpx solid currentColor;
  transform: rotate(-45deg);
}

.icon-calendar::before,
.icon-bell::before,
.icon-settings::before,
.icon-level::before {
  content: "";
  position: absolute;
  inset: 6rpx;
  border-radius: 10rpx;
  border: 4rpx solid currentColor;
}

.home-icon,
.asset-row-icon,
.asset-sound-icon,
.asset-listening-icon {
  display: block;
}

.home-view {
  padding-bottom: 190rpx;
}

.home-topline {
  position: relative;
  z-index: 2;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.home-book-select,
.home-streak,
.home-avatar {
  min-height: 64rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  color: #0a1613;
  background: rgba(255, 255, 255, 0.74);
  border: 2rpx solid rgba(255, 255, 255, 0.76);
  box-shadow: 0 10rpx 26rpx rgba(120, 96, 70, 0.1);
}

.home-book-select {
  flex: 1;
  padding: 0 18rpx 0 12rpx;
  gap: 12rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.home-book-select .ui-icon,
.entry-arrow {
  color: #0f8f7a;
}

.book-cover-mini,
.home-avatar {
  width: 64rpx;
  height: 64rpx;
  justify-content: center;
}

.book-cover-image,
.avatar-icon,
.tab-icon-image {
  width: 40rpx;
  height: 40rpx;
}

.muted-tab-icon {
  opacity: 0.46;
  filter: grayscale(0.25);
}

.home-streak {
  padding: 0 18rpx;
  gap: 10rpx;
  font-size: 24rpx;
  color: #6e6a62;
}

.streak-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #d97757;
  box-shadow: 0 0 0 8rpx rgba(217, 119, 87, 0.14);
}

.home-welcome-panel {
  position: relative;
  z-index: 2;
  padding: 22rpx 6rpx 0;
}

.home-welcome-title,
.home-welcome-subtitle {
  display: block;
  font-weight: 900;
  letter-spacing: -0.04em;
}

.home-welcome-title {
  color: #0f8f7a;
  font-size: 70rpx;
}

.home-welcome-subtitle {
  margin-top: 8rpx;
  color: #141413;
  font-size: 54rpx;
  line-height: 1.12;
}

.home-welcome-mark {
  width: 116rpx;
  height: 12rpx;
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: #d97757;
}

.asset-desk-scene {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 330rpx;
  margin: 18rpx 0 -12rpx;
  border-radius: 42rpx;
}

.home-main-card,
.profile-card,
.month-panel,
.level-panel,
.question-panel,
.result-panel,
.review-card,
.report-panel,
.detail-card,
.focus-pause-card {
  position: relative;
  z-index: 2;
  border-radius: 42rpx;
  background: rgba(255, 252, 246, 0.9);
  border: 2rpx solid rgba(255, 255, 255, 0.86);
  box-shadow: 0 24rpx 54rpx rgba(120, 96, 70, 0.13);
}

.home-main-card {
  margin-top: 30rpx;
  padding: 36rpx;
}

.home-normal-card {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.home-card-section {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.section-title-row,
.card-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.section-icon,
.card-icon-image {
  width: 44rpx;
  height: 44rpx;
}

.target-line {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.target-number,
.progress-large,
.vocab-number {
  color: #141413;
  font-size: 72rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: -0.06em;
}

.target-unit {
  color: #6e6a62;
  font-size: 28rpx;
  font-weight: 800;
}

.flag-row {
  display: flex;
  gap: 12rpx;
}

.icon-flag {
  width: 42rpx;
  height: 42rpx;
}

.home-divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(15, 143, 122, 0.2), transparent);
}

.home-progress-body {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.home-progress-copy {
  flex: 1;
}

.progress-number-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  color: #6e6a62;
  font-size: 28rpx;
  font-weight: 800;
}

.progress-track {
  width: 100%;
  height: 14rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(15, 143, 122, 0.14);
}

.progress-track view {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #0f8f7a, #67d8c8);
}

.home-progress-art {
  width: 160rpx;
  height: 150rpx;
}

.first-run-panel {
  margin-top: 8rpx;
}

.first-run-book-name {
  display: block;
  margin-top: 24rpx;
  color: #141413;
  font-size: 46rpx;
  font-weight: 900;
}

.first-run-progress-row {
  margin-top: 18rpx;
}

.home-continue {
  position: relative;
  z-index: 3;
  margin-top: 30rpx;
}

.first-run-cta {
  margin-top: 34rpx;
}

.home-first-note {
  position: relative;
  z-index: 2;
  margin-top: 20rpx;
  text-align: center;
  color: #6e6a62;
  font-size: 24rpx;
}

.home-action-card {
  position: relative;
  z-index: 2;
  min-height: 112rpx;
  margin-top: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 34rpx;
  display: grid;
  grid-template-columns: 56rpx 1fr auto;
  align-items: center;
  column-gap: 18rpx;
  background: #ffffff;
  border: 2rpx solid rgba(15, 143, 122, 0.14);
  box-shadow: 0 18rpx 36rpx rgba(120, 96, 70, 0.1);
}

.home-action-title {
  color: #141413;
  font-size: 28rpx;
  font-weight: 900;
}

.home-action-subtitle {
  grid-column: 2;
  color: #6e6a62;
  font-size: 23rpx;
}

.card-icon {
  width: 54rpx;
  height: 54rpx;
}

.asset-landscape {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 120rpx;
  width: 100%;
  height: 270rpx;
  opacity: 0.72;
  pointer-events: none;
}

.bottom-tab-bar {
  position: fixed;
  z-index: 20;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  min-height: 104rpx;
  padding: 12rpx;
  border-radius: 36rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 44rpx rgba(120, 96, 70, 0.18);
}

.tab-item {
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #6e6a62;
  font-size: 24rpx;
  font-weight: 800;
}

.tab-item.active {
  color: #0f8f7a;
  background: #f0f9f4;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 12;
  min-height: 92rpx;
  margin: -10rpx -12rpx 24rpx;
  padding: 8rpx 12rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr auto;
  align-items: center;
  gap: 14rpx;
  border-radius: 0 0 34rpx 34rpx;
  background: rgba(248, 245, 236, 0.88);
}

.topbar.compact {
  grid-template-columns: 72rpx 1fr auto;
}

.page-title,
.progress-label {
  color: #141413;
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: -0.04em;
}

.icon-button {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #141413;
  background: rgba(255, 255, 255, 0.78);
  border: 2rpx solid rgba(255, 255, 255, 0.84);
}

.icon-button.compact {
  width: 58rpx;
  height: 58rpx;
  border-radius: 20rpx;
}

.profile-view {
  padding-bottom: 190rpx;
}

.profile-toolbar-spacer {
  width: 72rpx;
}

.profile-toolbar-icons {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #0f8f7a;
}

.profile-hero {
  padding: 30rpx;
  border-radius: 42rpx;
  display: grid;
  grid-template-columns: 142rpx 1fr auto;
  gap: 22rpx;
  align-items: center;
  background: linear-gradient(135deg, #ffffff 0%, #f0f9f4 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 24rpx 54rpx rgba(120, 96, 70, 0.13);
}

.profile-book-art,
.asset-card-illustration {
  width: 142rpx;
  height: 142rpx;
}

.profile-book {
  display: block;
  margin: 8rpx 0;
  color: #141413;
  font-size: 38rpx;
  font-weight: 900;
}

.level-pill,
.pill {
  border-radius: 999rpx;
  padding: 12rpx 18rpx;
  color: #0f8f7a;
  background: rgba(15, 143, 122, 0.1);
  font-size: 24rpx;
  font-weight: 900;
}

.profile-grid,
.stats-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.profile-grid view,
.stats-grid .metric {
  min-height: 116rpx;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.76);
  border: 2rpx solid rgba(255, 255, 255, 0.82);
}

.metric-value {
  color: #0f8f7a;
  font-size: 36rpx;
  font-weight: 900;
}

.metric-label {
  margin-top: 6rpx;
  color: #6e6a62;
  font-size: 22rpx;
}

.profile-card,
.profile-list,
.month-panel {
  margin-top: 24rpx;
  padding: 28rpx;
}

.profile-card .card-row,
.month-panel .card-row {
  justify-content: space-between;
}

.inline-options {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.level-options.single {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.level-option {
  min-height: 108rpx;
  border-radius: 30rpx;
  padding: 20rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #ffffff;
  border: 2rpx solid rgba(15, 143, 122, 0.12);
}

.level-option.compact {
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
}

.level-option.enabled {
  color: #141413;
}

.level-option.disabled {
  color: #a89880;
  background: rgba(255, 255, 255, 0.42);
}

.level-option.selected {
  border-color: #0f8f7a;
  background: #f0f9f4;
}

.level-option-label {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
}

.level-option-status {
  display: block;
  margin-top: 6rpx;
  color: #6e6a62;
  font-size: 22rpx;
}

.level-kind,
.level-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 18rpx;
  color: #0f8f7a;
  background: rgba(15, 143, 122, 0.1);
}

.level-check {
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-card,
.action-entry,
.list-button,
.profile-test-entry {
  position: relative;
}

.profile-test-grid {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.profile-test-entry,
.list-button {
  min-height: 112rpx;
  border-radius: 30rpx;
  padding: 20rpx;
  display: grid;
  grid-template-columns: 54rpx 1fr auto;
  gap: 14rpx;
  align-items: center;
  background: #ffffff;
  border: 2rpx solid rgba(15, 143, 122, 0.12);
}

.entry-title {
  color: #141413;
  font-size: 28rpx;
  font-weight: 900;
}

.entry-meta {
  color: #6e6a62;
  font-size: 22rpx;
}

.profile-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: transparent;
  box-shadow: none;
  border: 0;
  padding-left: 0;
  padding-right: 0;
}

.week-row,
.month-calendar {
  margin-top: 20rpx;
}

.week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.week-dot {
  min-height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6e6a62;
  background: rgba(15, 143, 122, 0.07);
  font-size: 20rpx;
}

.week-dot.active {
  color: #ffffff;
  background: #0f8f7a;
}

.week-summary {
  margin-top: 16rpx;
}

.month-hero-panel,
.question-panel,
.result-panel {
  padding: 34rpx;
}

.asset-month-illustration,
.asset-panel-illustration,
.asset-result-illustration {
  display: block;
  width: 190rpx;
  height: 160rpx;
  margin: 0 auto 12rpx;
}

.month-picker,
.month-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.month-title {
  color: #141413;
  font-size: 40rpx;
  font-weight: 900;
}

.month-picker-action,
.level-test-link {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #0f8f7a;
  font-size: 24rpx;
  font-weight: 900;
}

.month-switch {
  margin-top: 20rpx;
  color: #6e6a62;
  font-size: 24rpx;
  font-weight: 800;
}

.month-calendar {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.month-weekday {
  text-align: center;
  color: #a89880;
  font-size: 20rpx;
  font-weight: 800;
}

.month-day {
  min-height: 78rpx;
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6e6a62;
  background: rgba(255, 255, 255, 0.68);
}

.month-day.blank {
  opacity: 0;
}

.month-day.active {
  color: #ffffff;
  background: #0f8f7a;
}

.month-day-meta {
  margin-top: 2rpx;
  font-size: 18rpx;
}

.trend-bars {
  height: 150rpx;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  align-items: end;
  gap: 12rpx;
}

.trend-bar {
  height: 130rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  gap: 8rpx;
  color: #a89880;
  font-size: 18rpx;
}

.trend-bar view {
  width: 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #67d8c8, #0f8f7a);
}

.stage-test-copy {
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.asset-row-icon {
  width: 52rpx;
  height: 52rpx;
}

.asset-row-icon.large {
  width: 112rpx;
  height: 112rpx;
}

.stage-skill-row {
  margin: 24rpx 0;
  display: flex;
  gap: 10rpx;
}

.stage-skill-row text {
  flex: 1;
  text-align: center;
  border-radius: 999rpx;
  padding: 12rpx 4rpx;
  color: #0f8f7a;
  background: rgba(15, 143, 122, 0.09);
  font-size: 22rpx;
  font-weight: 800;
}

.stage-note {
  margin-top: 16rpx;
  text-align: center;
}

.level-view,
.test-view,
.test-result-view,
.wrong-book-view,
.celebration-view,
.month-progress-view {
  padding-top: 22rpx;
}

.level-topbar {
  grid-template-columns: 72rpx 1fr 88rpx;
}

.text-link,
.skip-link {
  color: #0f8f7a;
  font-size: 24rpx;
  font-weight: 900;
}

.level-panel {
  padding: 32rpx;
}

.level-subtitle {
  display: block;
  text-align: center;
  color: #141413;
  font-size: 44rpx;
  font-weight: 900;
}

.ornament-line {
  width: 120rpx;
  height: 10rpx;
  margin: 18rpx auto 28rpx;
  border-radius: 999rpx;
  background: #d97757;
}

.question-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.test-word,
.detail-word,
.study-word {
  display: block;
  color: #141413;
  font-size: 76rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: -0.06em;
  word-break: break-word;
}

.option-stack {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.option-card,
.test-option {
  min-height: 88rpx;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  color: #141413;
  background: #ffffff;
  border: 2rpx solid rgba(15, 143, 122, 0.12);
  font-size: 30rpx;
  font-weight: 800;
}

.unknown-button {
  margin-top: 4rpx;
}

.counter-bar {
  margin-top: 22rpx;
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.pill.green {
  color: #0f8f7a;
}

.pill.red {
  color: #d95757;
  background: rgba(217, 87, 87, 0.1);
}

.pill.blue {
  color: #2b7e70;
}

.result-panel {
  text-align: center;
}

.vocab-number {
  display: block;
  margin: 12rpx 0 22rpx;
  color: #0f8f7a;
  font-size: 104rpx;
}

.vocab-number.compact {
  margin: 0;
  font-size: 48rpx;
}

.copy-card,
.usage-card,
.memory-image {
  margin-top: 18rpx;
  border-radius: 30rpx;
  padding: 24rpx;
  text-align: left;
  color: #4f463f;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(15, 143, 122, 0.1);
  font-size: 26rpx;
  line-height: 1.55;
}

.precheck-view {
  min-height: 100vh;
  padding: 32rpx 32rpx 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 50% 18%, rgba(255, 194, 116, 0.22), transparent 30%),
    linear-gradient(180deg, #fffaf1, #efe4d6);
}

.precheck-title {
  position: absolute;
  top: 34rpx;
  left: 36rpx;
  color: #141413;
  font-size: 42rpx;
  font-weight: 900;
}

.asset-swipe-arrows {
  position: absolute;
  top: 134rpx;
  right: 36rpx;
  width: 126rpx;
  height: 126rpx;
  opacity: 0.76;
}

.precheck-stage-card {
  position: relative;
  width: 100%;
  min-height: 640rpx;
  border-radius: 54rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 252, 246, 0.94);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 34rpx 74rpx rgba(120, 96, 70, 0.18);
  transition: transform 180ms ease, opacity 180ms ease;
}

.precheck-stage-card.exit-known {
  opacity: 0;
  transform: translateY(-160rpx) scale(0.94) rotate(-4deg);
}

.precheck-stage-card.exit-unfamiliar {
  opacity: 0;
  transform: translateY(160rpx) scale(0.94) rotate(4deg);
}

.precheck-word {
  max-width: 620rpx;
  color: #141413;
  font-size: 82rpx;
  font-weight: 900;
  line-height: 1.05;
  text-align: center;
  word-break: break-word;
}

.precheck-audio-dot {
  width: 82rpx;
  height: 82rpx;
  margin-top: 34rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f9f4;
}

.precheck-audio-dot image {
  width: 54rpx;
  height: 54rpx;
}

.precheck-hints {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 30rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.precheck-hint {
  min-height: 86rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #6e6a62;
  background: rgba(15, 143, 122, 0.08);
  font-size: 26rpx;
  font-weight: 900;
}

.precheck-hint.known {
  color: #0f8f7a;
}

.precheck-hint.unfamiliar {
  color: #d97757;
  background: rgba(217, 119, 87, 0.1);
}

.precheck-bottom-status {
  position: fixed;
  left: 36rpx;
  right: 36rpx;
  bottom: 34rpx;
  min-height: 98rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  color: #ffffff;
  background: rgba(15, 143, 122, 0.96);
  box-shadow: 0 18rpx 44rpx rgba(15, 143, 122, 0.24);
}

.precheck-status-main {
  font-size: 34rpx;
  font-weight: 900;
}

.precheck-status-sub {
  font-size: 24rpx;
  opacity: 0.8;
}

.learning-view {
  min-height: 100vh;
  padding: 36rpx 34rpx 44rpx;
  overflow: hidden;
}

.focus-flow,
.learning-view.learning-light {
  color: #141413;
  background:
    radial-gradient(circle at 50% 14%, rgba(103, 216, 200, 0.18), transparent 28%),
    linear-gradient(180deg, #fffaf1 0%, #f8f5ec 48%, #efe4d6 100%);
}

.learning-view.learning-dark {
  color: #fff9ef;
  background:
    radial-gradient(circle at 50% 18%, rgba(103, 216, 200, 0.18), transparent 28%),
    linear-gradient(180deg, #141413 0%, #071216 100%);
}

.focus-pause-handle {
  position: fixed;
  z-index: 16;
  left: 0;
  top: 48%;
  width: 52rpx;
  min-height: 160rpx;
  border-radius: 0 24rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: rgba(20, 20, 19, 0.5);
  background: rgba(255, 255, 255, 0.64);
  font-size: 20rpx;
}

.learning-dark .focus-pause-handle {
  color: rgba(255, 249, 239, 0.55);
  background: rgba(255, 249, 239, 0.1);
}

.focus-progress {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.focus-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(15, 143, 122, 0.16);
}

.focus-dot.done {
  background: #0f8f7a;
}

.focus-dot.current {
  background: #d97757;
  box-shadow: 0 0 0 10rpx rgba(217, 119, 87, 0.14);
}

.learning-dark .focus-dot {
  background: rgba(255, 249, 239, 0.18);
}

.learning-dark .focus-dot.done {
  background: #67d8c8;
}

.focus-card {
  width: 100%;
  min-height: 660rpx;
  margin-top: 92rpx;
  border-radius: 58rpx;
  padding: 56rpx 38rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: rgba(255, 252, 246, 0.94);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  box-shadow: 0 34rpx 78rpx rgba(120, 96, 70, 0.16);
}

.learning-dark .focus-card {
  background: rgba(19, 40, 34, 0.9);
  border-color: rgba(103, 216, 200, 0.14);
  box-shadow: none;
}

.study-focus-card {
  min-height: 700rpx;
}

.review-focus-card,
.audio-focus-card {
  min-height: 520rpx;
}

.audio-minimal {
  min-height: 520rpx;
}

.audio-panel {
  margin-top: 92rpx;
}

.audio-view {
  display: block;
}

.study-word {
  color: inherit;
  font-size: 92rpx;
}

.ipa {
  display: block;
  margin-top: 22rpx;
  color: #8c8378;
  font-size: 30rpx;
  font-weight: 700;
}

.learning-dark .ipa {
  color: rgba(255, 249, 239, 0.58);
}

.meaning {
  display: block;
  margin-top: 28rpx;
  color: #141413;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.35;
}

.learning-dark .meaning {
  color: #fff9ef;
}

.meaning text,
.option-pos {
  margin-right: 10rpx;
  color: #0f8f7a;
  font-weight: 900;
}

.sound-orb,
.speaker-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f0f9f4;
  border: 2rpx solid rgba(15, 143, 122, 0.12);
}

.sound-orb.small {
  width: 92rpx;
  height: 92rpx;
  margin-top: 34rpx;
}

.asset-sound-icon {
  width: 66rpx;
  height: 66rpx;
}

.read-pulse.active {
  animation: pulse 1.2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.08);
  }
}

.study-hint {
  display: block;
  margin-top: 26rpx;
  color: #6e6a62;
  font-size: 24rpx;
  font-weight: 800;
}

.learning-dark .study-hint {
  color: rgba(255, 249, 239, 0.62);
}

.focus-actions {
  position: fixed;
  z-index: 15;
  left: 34rpx;
  right: 34rpx;
  bottom: 34rpx;
}

.focus-primary {
  min-height: 96rpx;
  border-radius: 34rpx;
}

.learning-dark .primary-button {
  color: #141413;
  background: #d97757;
  box-shadow: 0 18rpx 34rpx rgba(217, 119, 87, 0.16);
}

.focus-stack,
.review-stack {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.reveal-card {
  width: 100%;
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.reveal-card.ghost {
  min-height: 116rpx;
  border-radius: 28rpx;
  align-items: center;
  justify-content: center;
  color: #a89880;
  background: rgba(15, 143, 122, 0.06);
  font-size: 24rpx;
}

.focus-reveal {
  min-height: 86rpx;
  border-radius: 28rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #141413;
  background: #ffffff;
  border: 2rpx solid rgba(15, 143, 122, 0.1);
  font-size: 30rpx;
  font-weight: 900;
}

.learning-dark .focus-reveal {
  color: #fff9ef;
  background: rgba(255, 249, 239, 0.08);
}

.focus-reveal.correct,
.focus-reveal.is-correct {
  border-color: rgba(15, 143, 122, 0.36);
  background: #f0f9f4;
}

.option-line {
  display: block;
  line-height: 1.25;
}

.speaker-tile.focus-speaker {
  width: 188rpx;
  height: 188rpx;
  margin-bottom: 28rpx;
  background: radial-gradient(circle, #ffffff 0%, #f0f9f4 100%);
  box-shadow: 0 20rpx 44rpx rgba(15, 143, 122, 0.14);
}

.asset-listening-icon {
  width: 134rpx;
  height: 134rpx;
}

.audio-playing-text {
  color: #141413;
  font-size: 36rpx;
  font-weight: 900;
}

.learning-dark .audio-playing-text {
  color: #fff9ef;
}

.audio-answer-reveal {
  margin-top: 32rpx;
}

.meaning-recall-prompt {
  width: 100%;
  border-radius: 34rpx;
  padding: 30rpx;
  color: #141413;
  background: #f0f9f4;
  font-size: 36rpx;
  font-weight: 900;
}

.meaning-word-reveal {
  width: 100%;
  min-height: 180rpx;
  margin-top: 28rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.7);
}

.recall-placeholder {
  color: #8c8378;
  font-size: 28rpx;
  font-weight: 800;
}

.focus-topbar {
  display: none;
}

.wrong-book-view .review-summary,
.asset-summary {
  min-height: 150rpx;
  border-radius: 38rpx;
  padding: 28rpx;
  display: grid;
  grid-template-columns: 88rpx 1fr;
  column-gap: 18rpx;
  align-items: center;
  background: #ffffff;
  border: 2rpx solid rgba(15, 143, 122, 0.12);
  box-shadow: 0 18rpx 42rpx rgba(120, 96, 70, 0.1);
}

.asset-summary image {
  grid-row: span 2;
  width: 88rpx;
  height: 88rpx;
}

.summary-title {
  color: #141413;
  font-size: 40rpx;
  font-weight: 900;
}

.summary-subtitle {
  color: #6e6a62;
  font-size: 24rpx;
}

.wrong-book-view .review-stack {
  margin-top: 22rpx;
}

.review-card {
  min-height: 138rpx;
  padding: 24rpx;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 18rpx;
  align-items: center;
}

.review-copy text {
  display: block;
}

.review-ipa {
  display: block;
  margin-top: 6rpx;
  color: #8c8378;
  font-size: 24rpx;
}

.sound-mini {
  min-width: 108rpx;
  height: 78rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #0f8f7a;
  background: #f0f9f4;
  font-size: 20rpx;
  font-weight: 900;
}

.sound-mini image {
  width: 42rpx;
  height: 42rpx;
}

.empty-state {
  min-height: 280rpx;
  border-radius: 42rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  color: #6e6a62;
  background: rgba(255, 255, 255, 0.72);
}

.celebration-view {
  text-align: center;
}

.celebration-panel {
  padding: 44rpx 34rpx;
}

.asset-confetti,
.asset-complete-glow {
  position: absolute;
  left: 50%;
  top: 12rpx;
  width: 300rpx;
  height: 180rpx;
  transform: translateX(-50%);
  opacity: 0.9;
}

.asset-complete-glow {
  top: 74rpx;
  opacity: 0.48;
}

.report-ring {
  position: relative;
  z-index: 2;
  width: 210rpx;
  height: 210rpx;
  margin: 42rpx auto 28rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  box-shadow: 0 18rpx 46rpx rgba(120, 96, 70, 0.12);
}

.report-ring image {
  width: 82rpx;
  height: 82rpx;
}

.report-ring text {
  margin-top: 8rpx;
  color: #0f8f7a;
  font-size: 38rpx;
  font-weight: 900;
}

.modal-mask,
.transition-mask {
  position: fixed;
  z-index: 80;
  inset: 0;
  padding: 44rpx 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(20, 20, 19, 0.42);
}

.detail-card {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  padding: 38rpx;
}

.detail-card .close {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
}

.detail-word {
  margin-top: 18rpx;
}

.memory-image {
  background: linear-gradient(135deg, rgba(15, 143, 122, 0.1), rgba(217, 119, 87, 0.1));
}

.usage-section {
  margin-top: 16rpx;
}

.usage-title {
  display: block;
  color: #0f8f7a;
  font-size: 24rpx;
  font-weight: 900;
}

.usage-chip {
  margin-top: 10rpx;
  border-radius: 22rpx;
  padding: 14rpx 18rpx;
  background: #f0f9f4;
}

.usage-chip text,
.usage-example-en,
.usage-example-cn,
.usage-ai-label {
  display: block;
  color: #4f463f;
  font-size: 25rpx;
  line-height: 1.5;
}

.usage-example-en {
  margin-top: 10rpx;
  font-weight: 800;
}

.usage-example-cn,
.usage-ai-label {
  margin-top: 8rpx;
  color: #6e6a62;
}

.focus-pause-mask {
  align-items: flex-end;
}

.focus-pause-card {
  width: 100%;
  padding: 34rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pause-count {
  display: block;
  margin-bottom: 10rpx;
  text-align: center;
  color: #141413;
  font-size: 34rpx;
  font-weight: 900;
}

.notice-mask {
  background: rgba(20, 20, 19, 0.24);
}

.transition-card {
  min-width: 520rpx;
  max-width: 640rpx;
  border-radius: 34rpx;
  padding: 34rpx 38rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  text-align: center;
  color: #141413;
  background: rgba(255, 252, 246, 0.94);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 24rpx 54rpx rgba(120, 96, 70, 0.16);
  font-size: 32rpx;
  font-weight: 900;
}

.transition-hint {
  color: #6e6a62;
  font-size: 24rpx;
  font-weight: 800;
}

.boot-error-card {
  border-radius: 34rpx;
  padding: 28rpx;
  background: #fff7eb;
  border: 2rpx solid rgba(217, 87, 87, 0.16);
}

.edge-wrong .focus-card {
  animation: edgeShake 300ms ease;
}

@keyframes edgeShake {
  0%, 100% {
    transform: translateX(0);
  }
  30% {
    transform: translateX(-8rpx);
  }
  70% {
    transform: translateX(8rpx);
  }
}
