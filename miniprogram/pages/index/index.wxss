  border-radius: 40rpx;
  background: var(--spec-card);
  box-shadow: 0 24rpx 70rpx rgba(44, 36, 24, 0.12);
  box-sizing: border-box;
}

.home-normal-card {
  min-height: 742rpx;
}

.home-card-section {
  display: grid;
  gap: 18rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.home-divider {
  height: 2rpx;
  margin: 36rpx 0;
  background: var(--spec-border);
}

.section-label {
  color: var(--spec-label) !important;
  font-size: 24rpx !important;
  font-weight: 600 !important;
}

.target-line {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
  color: var(--spec-text);
}

.target-number {
  font-size: 96rpx;
  font-weight: 900;
  line-height: 0.95;
}

.target-unit {
  padding-bottom: 8rpx;
  color: var(--spec-secondary);
  font-size: 40rpx;
  font-weight: 700;
}

.flag-row {
  display: flex !important;
  justify-content: space-between;
  gap: 16rpx !important;
  width: 100%;
  margin-top: 8rpx;
}

.flag-row .icon-flag {
  width: 108rpx;
  height: 124rpx;
  color: var(--spec-success);
}

.flag-row .icon-flag.todo {
  opacity: 0.92;
}

.home-progress-body {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 166rpx;
  align-items: end;
  gap: 22rpx;
}

.home-progress-copy {
  display: grid;
  min-width: 0;
  gap: 18rpx;
}

.home-progress-art {
  width: 166rpx;
  height: 166rpx;
  align-self: center;
  justify-self: end;
  opacity: 0.96;
  filter: drop-shadow(0 16rpx 20rpx rgba(44, 36, 24, 0.16));
}

.progress-number-row {
  display: grid;
  grid-template-columns: auto auto 1fr;
  align-items: baseline;
  gap: 12rpx;
  color: var(--spec-secondary);
  font-size: 34rpx;
  font-weight: 900;
}

.progress-number-row text:last-child {
  justify-self: end;
}

.progress-large {
  color: var(--spec-success-bright);
  font-size: 64rpx;
  line-height: 1;
}

.progress-track {
  height: 12rpx !important;
  border-radius: 6rpx !important;
  background: var(--spec-progress-track) !important;
}

.progress-track view {
  background: var(--spec-progress-fill) !important;
}

.home-continue {
  position: relative;
  z-index: 2;
  width: 670rpx;
  max-width: 100%;
  min-height: 88rpx !important;
  margin: 32rpx auto 24rpx;
  border-radius: 24rpx !important;
  background: linear-gradient(135deg, #d4935a, #c4823a) !important;
  color: #ffffff !important;
  font-size: 32rpx;
  font-weight: 900;
  box-shadow: 0 16rpx 48rpx rgba(212, 147, 90, 0.3) !important;
}

.home-cta-pressed,
.home-link-pressed,
.action-entry-pressed {
  opacity: 0.82;
}

.home-action-card {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 54rpx minmax(0, 1fr) auto 36rpx !important;
  align-items: center;
  gap: 18rpx;
  width: 670rpx;
  max-width: 100%;
  min-height: 96rpx;
  margin: 0 auto;
  padding: 0 32rpx;
  border: 2rpx solid var(--spec-border);
  border-radius: 28rpx;
  background: var(--spec-hint);
  color: var(--spec-text);
  box-shadow: 0 18rpx 50rpx rgba(44, 36, 24, 0.08);
  box-sizing: border-box;
}

.home-action-card text:nth-of-type(1) {
  font-size: 28rpx;
  font-weight: 900;
}

.home-action-card text:nth-of-type(2) {
  color: var(--spec-label);
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.home-landscape {
  position: absolute;
  right: -40rpx;
  bottom: calc(env(safe-area-inset-bottom) + 118rpx);
  left: -40rpx;
  height: 330rpx;
  opacity: 0.7;
  pointer-events: none;
  background:
    radial-gradient(ellipse at 18% 100%, rgba(94, 138, 106, 0.28) 0 16%, transparent 17%),
    radial-gradient(ellipse at 86% 98%, rgba(94, 138, 106, 0.22) 0 22%, transparent 23%),
    radial-gradient(ellipse at 50% 105%, rgba(94, 138, 106, 0.18) 0 30%, transparent 31%),
    linear-gradient(180deg, transparent 0%, rgba(94, 138, 106, 0.12) 100%);
}

.tab-bar {
  position: fixed !important;
  right: 40rpx !important;
  left: 40rpx !important;
  z-index: 20 !important;
  bottom: 24rpx !important;
  display: grid !important;
  grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  gap: 0 !important;
  width: auto !important;
  max-width: 670rpx !important;
  min-height: 120rpx;
  margin: 0 auto !important;
  padding: 12rpx 0 !important;
  border: 1rpx solid var(--spec-border) !important;
  border-radius: 44rpx !important;
  background: rgba(255, 255, 255, 0.96) !important;
  box-shadow: 0 18rpx 50rpx rgba(44, 36, 24, 0.12) !important;
