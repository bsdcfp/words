}

.audio-view {
  padding-bottom: calc(env(safe-area-inset-bottom) + 168rpx);
}

.audio-minimal {
  display: grid;
  gap: 28rpx;
  min-height: 520rpx;
  padding: 38rpx 34rpx;
  align-content: start;
}

.audio-minimal .speaker-tile {
  width: 168rpx;
  height: 168rpx;
  min-height: 168rpx;
  margin: 0 auto;
  border-radius: 44rpx;
  background: rgba(250, 249, 245, 0.88);
  color: #4f623c;
  box-shadow: 0 18rpx 42rpx rgba(120, 140, 93, 0.14);
  font-size: 30rpx;
}

.audio-minimal .option-stack {
  margin: 0;
  gap: 18rpx;
}

.review-answer-reveal {
  margin-top: 8rpx;
}

.audio-recall-hint {
  display: block;
  color: #6e6a62;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
  text-align: center;
}

.audio-answer-reveal {
  margin-top: 8rpx;
}

.meaning-recall-card {
  justify-items: stretch;
}

.meaning-recall-prompt {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 28rpx 30rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.76);
  color: #141413;
  font-size: 34rpx;
  font-weight: 900;
}

.meaning-word-reveal {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 168rpx;
  border-radius: 30rpx;
  background: rgba(120, 140, 93, 0.12);
  text-align: center;
}

.meaning-word-reveal.visible {
