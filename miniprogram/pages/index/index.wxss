.app-shell.learning-light .first-run-home .home-landscape {
  opacity: 0.5;
}

.app-shell:not(.learning-light) .home-view,
.app-shell.learning-dark .home-view {
  background:
    radial-gradient(circle at 50% 18%, rgba(122, 191, 168, 0.12), transparent 36%),
    linear-gradient(180deg, #0b1a17, #0b1a17) !important;
}

.app-shell:not(.learning-light) .home-main-card,
.app-shell.learning-dark .home-main-card,
.app-shell:not(.learning-light) .home-action-card,
.app-shell.learning-dark .home-action-card {
  box-shadow: none;
}

.app-shell:not(.learning-light) .home-progress-art view,
.app-shell.learning-dark .home-progress-art view {
  border-color: rgba(122, 191, 168, 0.28);
  background:
    linear-gradient(90deg, rgba(255, 249, 239, 0.08), transparent 34%),
    linear-gradient(145deg, rgba(94, 138, 122, 0.16), rgba(94, 138, 122, 0.04));
