    transform: scale(1);
  }
  50% {
    transform: scale(1.08);
  }
}

.study-hint {
  display: block;
  margin-top: 26rpx;
  color: #9b9488;
  font-size: 24rpx;
  font-weight: 600;
}

.focus-actions {
  position: fixed;
