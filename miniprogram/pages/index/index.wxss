/* listening reveal sheet (Reference 11) */
.reveal-sheet {
  width: 100%;
  margin-top: 40rpx;
  padding: 28rpx 30rpx 30rpx;
  border-radius: 32rpx;
  background: rgba(255, 253, 249, 0.92);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 16rpx 40rpx rgba(122, 98, 60, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.reveal-sheet-head {
  display: flex;
  align-items: center;
  justify-content: center;
}

.reveal-sheet-title {
  display: flex;
  align-items: center;
  color: #9b9488;
  font-size: 26rpx;
  font-weight: 600;
}

.reveal-sheet-title::before,
.reveal-sheet-title::after {
  content: "";
  width: 48rpx;
  height: 2rpx;
  margin: 0 16rpx;
  background: rgba(122, 98, 60, 0.2);
}

.reveal-sheet-arrow {
  width: 20rpx;
  height: 20rpx;
  margin: 14rpx 0 0;
  border-right: 3rpx solid #b6ae9f;
  border-bottom: 3rpx solid #b6ae9f;
  transform: rotate(45deg);
}

.reveal-sheet-meaning {
  margin-top: 0;
  color: #2c2b26;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.3;
}

.reveal-sheet.revealed .reveal-sheet-arrow {
  opacity: 0.4;
}

/* listening page: spread content vertically (orb up top, reveal sheet near button) */
/* shared "spread" learning layout: orb up top, landscape centred, meaning sheet
   fixed above the button. Used by both 听音辨义 and 识记. */
.learn-spread {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100vh;
  box-sizing: border-box;
  /* bottom padding reserves the fixed button (96 + 116 + ~10px gap) */
  padding: 36rpx 34rpx 232rpx;
  overflow: hidden;
}

.learn-spread .focus-progress {
  flex: 0 0 auto;
}

.learn-spread .focus-card {
  flex: 0 0 auto;
  min-height: auto;
  margin-top: 90rpx;
}

/* landscape: background layer anchored in the lower-middle, below the text and
   above the reveal-sheet area. Out of flow — takes no layout height and never
   moves when the reveal sheet appears. */
.learn-spread .learn-landscape-band {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 380rpx;
  width: 100%;
  height: 300rpx;
  margin: 0;
  opacity: 0.9;
  z-index: -1;
}

/* meaning sheet: fixed just above the button and OUT of flow, layered above the
   landscape. Because it is out of flow, the landscape (background) does not move
   when the meaning appears after 2s — the flow stays uninterrupted. */
.learn-spread .reveal-sheet {
  position: fixed;
  left: 34rpx;
  right: 34rpx;
  bottom: 232rpx;
  width: auto;
  margin: 0;
  z-index: 4;
}

.learn-spread .focus-actions {
  bottom: 96rpx;
}

.audio-bottom-hint {
  position: fixed;
  z-index: 15;
  left: 0;
  right: 0;
  bottom: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #b6ae9f;
  font-size: 24rpx;
}

.audio-hint-bulb {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  border: 2rpx solid #c7bfae;
}

.meaning-recall-prompt {
  width: 100%;
  border-radius: 30rpx;
  padding: 30rpx;
  color: #2c2b26;
  background: rgba(77, 132, 120, 0.1);
  font-size: 36rpx;
  font-weight: 700;
}

.meaning-word-reveal {
  width: 100%;
  min-height: 180rpx;
  margin-top: 28rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.66);
}

.recall-placeholder {
  color: #9b9488;
  font-size: 28rpx;
  font-weight: 700;
}

.focus-topbar {
