/* ---------- Pre-learning scan (Reference 06) ---------- */
/* fit-to-screen, no page scroll: fixed viewport height + flexible card */
.precheck-view {
  position: relative;
  height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 40rpx 206rpx;
  justify-content: flex-start;
  overflow: hidden;
}

.precheck-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 6rpx;
}

.precheck-title {
  position: static;
  color: #2c2b26;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.precheck-leaf {
  width: 46rpx;
  height: 28rpx;
}

.precheck-leaf.right {
  transform: scaleX(-1);
}

.precheck-ripple {
  display: block;
  margin: 0 auto;
  width: 198rpx;
  height: 120rpx;
  opacity: 0.55;
}

.precheck-ripple-top {
  margin-top: 16rpx;
  margin-bottom: 48rpx;
}

.precheck-ripple-bottom {
  position: relative;
  z-index: 2;
  margin-top: 48rpx;
}

.precheck-arrow-img {
  width: 80rpx;
  height: 156rpx;
}

.precheck-deck {
  position: relative;
  z-index: 2;
  width: 100%;
  margin-top: 0;
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  align-items: stretch;
  justify-content: center;
}

.precheck-stage-card {
  position: relative;
  z-index: 2;
  width: 100%;
  min-height: 0;
  height: 100%;
  max-height: 100%;
  border-radius: 48rpx;
  background: #fdfaf3;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 30rpx 70rpx rgba(122, 98, 60, 0.16);
}

.precheck-stage-card::before,
.precheck-stage-card::after {
  content: "";
  position: absolute;
  z-index: -1;
  left: 2%;
  right: 2%;
  top: 14rpx;
  bottom: -14rpx;
  border-radius: 48rpx;
  background: #fbf7ee;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 20rpx 48rpx rgba(122, 98, 60, 0.08);
  transform: rotate(-2.6deg);
  transform-origin: center;
}

.precheck-stage-card::after {
  z-index: -2;
  top: 24rpx;
  bottom: -24rpx;
  background: #f6f1e6;
  transform: rotate(3.2deg);
}

.precheck-word {
  margin-top: 40rpx;
}

.precheck-audio-dot {
  width: 96rpx;
  height: 96rpx;
  margin-top: 44rpx;
  background: transparent;
  border: 0;
  box-shadow: none;
}

.precheck-speaker-img {
  width: 64rpx;
  height: 64rpx;
}

.precheck-hints {
  position: static;
  width: 100%;
  margin-top: 76rpx;
  padding: 0;
  display: flex;
  align-items: stretch;
  justify-content: center;
}

.precheck-hint,
.precheck-hint.known,
.precheck-hint.unfamiliar {
  flex: 1;
  min-height: auto;
  background: transparent;
  border: 0;
  border-radius: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  padding: 8rpx 0;
}

.precheck-arrow-img.arrow-up {
  transform: rotate(10deg);
}

.precheck-arrow-img.arrow-down {
  transform: rotate(10deg);
}

.precheck-hint-divider {
  width: 2rpx;
  align-self: stretch;
  margin: 8rpx 0;
  background: rgba(122, 98, 60, 0.14);
}

.precheck-arrow {
  width: 10rpx;
  height: 84rpx;
  border-radius: 999rpx;
  position: relative;
}

.precheck-arrow.up {
  background: linear-gradient(180deg, #4d8478, #76a892);
}

.precheck-arrow.up::before {
  content: "";
  position: absolute;
  top: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-bottom: 26rpx solid #4d8478;
}

.precheck-arrow.down {
  background: linear-gradient(180deg, #ecb05a, #d97b34);
}

.precheck-arrow.down::before {
  content: "";
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-top: 26rpx solid #d97b34;
}

.precheck-hint-main {
  color: #2c2b26;
  font-size: 34rpx;
  font-weight: 700;
}

.precheck-hint.known .precheck-hint-main,
.precheck-hint.known .precheck-hint-sub {
  color: #3f7e70;
}

.precheck-hint.unfamiliar .precheck-hint-main,
.precheck-hint.unfamiliar .precheck-hint-sub {
  color: #d97b34;
}

.precheck-hint-sub {
  font-size: 34rpx;
  font-weight: 700;
}

.precheck-bottom-status {
  z-index: 3;
  min-height: 188rpx;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 0;
  align-items: center;
  padding: 0 44rpx calc(env(safe-area-inset-bottom));
  background: rgba(252, 249, 243, 0.94);
  border-top: 2rpx solid rgba(122, 98, 60, 0.12);
  box-shadow: none;
  color: #2c2b26;
}

.precheck-status-left {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.precheck-status-label {
  color: #6b6459;
  font-size: 28rpx;
  font-weight: 700;
}

.precheck-status-num {
  color: #3f7e70;
  font-size: 48rpx;
  font-weight: 800;
}

.precheck-status-total {
  color: #9b9488;
  font-size: 28rpx;
  font-weight: 700;
}

.precheck-status-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.precheck-status-sub {
  color: #4a443b;
  font-size: 32rpx;
  font-weight: 700;
  opacity: 1;
}

.precheck-status-book {
  width: 116rpx;
  height: 116rpx;
}

.precheck-landscape {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 384rpx;
  opacity: 0.96;
  pointer-events: none;
  z-index: -1;
}
