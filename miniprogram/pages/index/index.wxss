/* ---------- Pre-learning scan ---------- */
.precheck-view {
  min-height: 100vh;
  padding: 32rpx 32rpx 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 50% 16%, rgba(232, 166, 76, 0.1), transparent 30%),
    linear-gradient(180deg, #fcf9f3, #f2ecdf);
}

.precheck-title {
  position: absolute;
  top: 36rpx;
  left: 36rpx;
  color: #2c2b26;
  font-size: 40rpx;
  font-weight: 800;
}

.asset-swipe-arrows {
  position: absolute;
  top: 140rpx;
  right: 40rpx;
  width: 120rpx;
  height: 120rpx;
  opacity: 0.8;
}

.precheck-stage-card {
  position: relative;
  width: 100%;
  min-height: 640rpx;
  border-radius: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fffdf9;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 28rpx 64rpx rgba(122, 98, 60, 0.16);
  transition: transform 180ms ease, opacity 180ms ease;
}

.precheck-stage-card.exit-known {
  opacity: 0;
  transform: translateY(-160rpx) scale(0.94) rotate(-4deg);
}

.precheck-stage-card.exit-unfamiliar {
  opacity: 0;
  transform: translateY(160rpx) scale(0.94) rotate(4deg);
}

.precheck-word {
  max-width: 620rpx;
  color: #2c2b26;
  font-size: 84rpx;
  font-weight: 700;
  line-height: 1.05;
  text-align: center;
  word-break: break-word;
}

.precheck-audio-dot {
  width: 80rpx;
  height: 80rpx;
  margin-top: 34rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(77, 132, 120, 0.1);
}

.precheck-audio-dot image {
  width: 50rpx;
  height: 50rpx;
}

.precheck-hints {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 30rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.precheck-hint {
  min-height: 88rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #9b9488;
  background: rgba(77, 132, 120, 0.08);
  font-size: 26rpx;
  font-weight: 800;
}

.precheck-hint.known {
  color: #3f7e70;
}

.precheck-hint.unfamiliar {
  color: #d97b34;
  background: rgba(223, 131, 60, 0.1);
}

.precheck-bottom-status {
  position: fixed;
  left: 36rpx;
  right: 36rpx;
  bottom: 36rpx;
  min-height: 96rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  color: #fffaf0;
  background: #4d8478;
  box-shadow: 0 16rpx 40rpx rgba(77, 132, 120, 0.24);
}

.precheck-status-main {
  font-size: 34rpx;
  font-weight: 800;
}

.precheck-status-sub {
  font-size: 24rpx;
  opacity: 0.82;
}

/* ---------- Learning (focus flow) ---------- */
.learning-view {
  min-height: 100vh;
  padding: 36rpx 34rpx 44rpx;
  overflow: hidden;
}

.focus-flow,
.learning-view.learning-light,
.learning-view.learning-dark {
