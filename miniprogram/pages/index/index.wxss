page {
  min-height: 100%;
  background: #d9c4ad;
  color: #1f1e1a;
  font-family: "PingFang SC", sans-serif;
}

.diagnostic-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.diagnostic-card {
  width: 100%;
  padding: 48rpx;
  border-radius: 28rpx;
  background: #fff8ef;
  box-shadow: 0 20rpx 60rpx rgba(88, 67, 43, 0.14);
  box-sizing: border-box;
}

.eyebrow,
.desc,
.time,
.title {
  display: block;
}

.eyebrow {
  color: #756f66;
  font-size: 24rpx;
  font-weight: 800;
}

.title {
  margin-top: 18rpx;
  color: #1f1e1a;
  font-size: 44rpx;
  font-weight: 900;
}

.desc {
  margin-top: 24rpx;
  color: #625b52;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.55;
}

.time {
  margin-top: 32rpx;
  color: #15977f;
  font-size: 30rpx;
  font-weight: 900;
}
