  max-width: 560rpx;
  margin: 36rpx auto 0;
}

.focus-flow .meaning-recall-prompt {
  max-width: 600rpx;
  justify-content: center;
  background: transparent;
  color: #faf9f5;
  text-align: center;
}

.focus-flow .meaning-word-reveal {
  width: 100%;
  max-width: 600rpx;
  margin-top: 40rpx;
  background: rgba(250, 249, 245, 0.08);
}

.focus-flow .meaning-word-reveal.visible {
