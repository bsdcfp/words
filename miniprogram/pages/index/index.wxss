/* V2 light UI — aligned to page-references-v2-imagegen/light.
   Palette: warm paper background, amber/gold primary button,
   muted sage-green accents & numbers, soft white cards, serif headwords. */

page,
view,
text,
image {
  box-sizing: border-box;
}

/* ---------- Design tokens ---------- */
.app-shell {
  min-height: 100vh;
  color: #2c2b26;
  background:
    radial-gradient(circle at 16% 4%, rgba(120, 168, 150, 0.08), transparent 30%),
    radial-gradient(circle at 88% 14%, rgba(232, 166, 76, 0.07), transparent 28%),
    linear-gradient(180deg, #fcf9f3 0%, #f7f2e8 56%, #f2ecdf 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif;
}

.view {
  position: relative;
  /* each page is its own stacking context so landscapes can sit at z -1:
     above the page background, below every component */
  z-index: 0;
  min-height: 100vh;
  padding: 36rpx 36rpx 168rpx;
  overflow: hidden;
}

.sticky-view {
  overflow: visible;
}

.muted {
  display: block;
  color: #9b9488;
  font-size: 24rpx;
  line-height: 1.55;
}

.section-label {
  display: block;
  color: #4d8478;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.card-title {
  display: block;
  color: #2c2b26;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
}

.strong {
  font-weight: 800;
}

/* serif headwords to match reference typography */
.serif,
.study-word,
.test-word,
.detail-word,
.precheck-word {
  font-family: "Georgia", "Times New Roman", "Songti SC", serif;
}

/* ---------- Buttons ---------- */
.primary-button,
.secondary-button {
  min-height: 92rpx;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 34rpx;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1;
}

.primary-button {
  color: #fffaf0;
  background: linear-gradient(180deg, #edb45f 0%, #e29a36 100%);
  box-shadow: 0 16rpx 32rpx rgba(224, 154, 52, 0.28);
}

.secondary-button {
  color: #4d8478;
  background: #fffdf9;
  border: 2rpx solid rgba(77, 132, 120, 0.26);
}

.home-cta-pressed,
.action-entry-pressed,
.level-option-pressed,
.test-option-pressed,
.review-card-pressed {
  opacity: 0.9;
  transform: scale(0.985);
}

/* ---------- Line icons ---------- */
.ui-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  flex: 0 0 36rpx;
}

.icon-chevron::before {
  content: "";
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  top: 9rpx;
  left: 8rpx;
  border-top: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.icon-back::before {
  content: "";
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  top: 7rpx;
  left: 11rpx;
  border-left: 5rpx solid currentColor;
  border-bottom: 5rpx solid currentColor;
  transform: rotate(45deg);
}

.icon-close::before,
.icon-close::after {
  content: "";
  position: absolute;
  width: 28rpx;
  height: 4rpx;
  top: 16rpx;
  left: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.icon-close::before {
  transform: rotate(45deg);
}

.icon-close::after {
  transform: rotate(-45deg);
}

.icon-check::before {
  content: "";
  position: absolute;
  width: 20rpx;
  height: 11rpx;
  top: 8rpx;
  left: 7rpx;
  border-left: 5rpx solid currentColor;
  border-bottom: 5rpx solid currentColor;
  transform: rotate(-45deg);
}

.icon-calendar::before,
.icon-bell::before,
.icon-settings::before,
.icon-level::before {
  content: "";
  position: absolute;
  inset: 6rpx;
  border-radius: 10rpx;
  border: 4rpx solid currentColor;
}

.home-icon,
.asset-row-icon,
.asset-sound-icon,
.asset-listening-icon {
  display: block;
}

/* ---------- Home ---------- */
.home-view {
  padding-bottom: 200rpx;
}

/* one unified top capsule: book entry on the left, streak chip on the right */
.home-topline {
  position: relative;
  z-index: 2;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 10rpx 8rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 8rpx 22rpx rgba(122, 98, 60, 0.08);
}

.home-book-select {
  flex: 1;
  min-height: 60rpx;
  gap: 12rpx;
  display: flex;
  align-items: center;
  color: #2c2b26;
  font-size: 27rpx;
  font-weight: 700;
}

.home-book-select .ui-icon,
.entry-arrow {
  color: #b6ae9f;
}

.book-cover-mini {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.book-cover-image {
  width: 40rpx;
  height: 40rpx;
}

/* streak pill — warm orange */
.home-streak {
  min-height: 60rpx;
  padding: 0 22rpx;
  gap: 10rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  color: #d97b34;
  font-size: 24rpx;
  font-weight: 700;
  background: rgba(223, 131, 60, 0.12);
}

.streak-dot {
  position: relative;
  width: 16rpx;
  height: 18rpx;
  border-radius: 50% 50% 50% 50% / 65% 65% 40% 40%;
  background: linear-gradient(180deg, #f0a64a, #df6f2c);
  transform: rotate(-8deg);
}

/* first-run welcome */
.home-welcome-panel {
  position: relative;
  z-index: 2;
  padding: 36rpx 6rpx 0;
  text-align: center;
}

.home-welcome-title,
.home-welcome-subtitle {
  display: block;
  letter-spacing: -0.02em;
}

.home-welcome-title {
  color: #22211e;
  font-size: 84rpx;
  font-weight: 800;
}

.home-welcome-subtitle {
  margin-top: 10rpx;
  color: #45433f;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.home-welcome-mark {
  width: 92rpx;
  height: 8rpx;
  margin: 18rpx auto 0;
  border-radius: 999rpx;
  background: #5a8c7d;
}

/* full-bleed desk illustration */
.asset-desk-scene {
  position: relative;
  z-index: 1;
  display: block;
  width: auto;
  height: 500rpx;
  margin: 24rpx -36rpx 0;
  border-radius: 0;
}

/* shared card surface */
.home-main-card,
.profile-card,
.month-panel,
.level-panel,
.question-panel,
.result-panel,
.review-card,
.report-panel,
.detail-card,
.focus-pause-card {
  position: relative;
  z-index: 2;
  border-radius: 36rpx;
  background: #fffdf9;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(122, 98, 60, 0.1);
}

.home-main-card {
  margin-top: 28rpx;
  padding: 36rpx;
}

.home-normal-card {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.home-card-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section-title-row,
.card-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.section-icon,
.card-icon-image {
  width: 40rpx;
  height: 40rpx;
}

.target-line {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.target-number,
.progress-large,
.vocab-number {
  color: #3f7e70;
  font-size: 76rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: -0.04em;
}

.target-unit {
  color: #6b6459;
  font-size: 30rpx;
  font-weight: 700;
}

/* 今日目标: label + count on the left, flags on the right (wrap into rows) */
.goal-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.goal-left {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.goal-flags {
  flex: 0 1 auto;
  max-width: 300rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 14rpx;
}

.icon-flag {
  width: 56rpx;
  height: 56rpx;
}

.home-divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(77, 132, 120, 0.16), transparent);
}

.home-progress-body {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.home-progress-copy {
  flex: 1;
}

.progress-number-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  color: #6b6459;
  font-size: 28rpx;
  font-weight: 700;
}

.progress-number-row .progress-large {
  font-size: 64rpx;
}

.progress-track {
  width: 100%;
  height: 14rpx;
  margin-top: 22rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(77, 132, 120, 0.14);
}

.progress-track view {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #4d8478, #6fa893);
}

.home-progress-art {
  width: 150rpx;
  height: 142rpx;
}

.first-run-panel {
  margin-top: 10rpx;
}

.first-run-book-name {
  display: block;
  margin-top: 22rpx;
  color: #2c2b26;
  font-size: 44rpx;
  font-weight: 800;
}

.first-run-progress-row {
  margin-top: 18rpx;
}

.first-run-progress-row text:last-child {
  margin-left: auto;
}

.first-run-book-name + .first-run-progress-row {
  margin-top: 22rpx;
}

.cta-chevron {
  margin-left: 10rpx;
  color: #fffaf0;
}

.home-continue {
  position: relative;
  z-index: 3;
  margin-top: 32rpx;
}

.first-run-cta {
  margin-top: 34rpx;
}

.home-first-note {
  position: relative;
  z-index: 2;
  margin-top: 20rpx;
  text-align: center;
  color: #9b9488;
  font-size: 24rpx;
}

/* error/review entry card */
.home-action-card {
  position: relative;
  z-index: 2;
  min-height: 108rpx;
  margin-top: 22rpx;
  padding: 22rpx 26rpx;
  border-radius: 28rpx;
  display: grid;
  grid-template-columns: 52rpx 1fr auto;
  align-items: center;
  column-gap: 18rpx;
  background: #fffdf9;
  border: 2rpx solid rgba(122, 98, 60, 0.08);
  box-shadow: 0 12rpx 30rpx rgba(122, 98, 60, 0.08);
}

.home-action-title {
  color: #2c2b26;
  font-size: 28rpx;
  font-weight: 800;
}

.home-action-subtitle {
  grid-column: 2;
  color: #9b9488;
  font-size: 23rpx;
}

.card-icon {
  width: 48rpx;
  height: 48rpx;
}

/* bottom ink-wash landscape strip */
.asset-landscape {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 116rpx;
  width: 100%;
  height: 300rpx;
  /* background layer: above the page colour, below all components,
     takes no layout height */
  z-index: -1;
  opacity: 0.85;
  pointer-events: none;
  /* fade the top edge so the landscape blends into the page (no hard seam) */
  -webkit-mask-image: linear-gradient(180deg, transparent 0, rgba(0, 0, 0, 1) 36%);
  mask-image: linear-gradient(180deg, transparent 0, rgba(0, 0, 0, 1) 36%);
}

/* ---------- Flat bottom tab bar ---------- */
.bottom-tab-bar {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 110rpx;
  padding: 10rpx 0 calc(constant(safe-area-inset-bottom));
  padding-bottom: calc(env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: rgba(255, 253, 249, 0.96);
  border-top: 2rpx solid rgba(122, 98, 60, 0.1);
  box-shadow: 0 -6rpx 24rpx rgba(122, 98, 60, 0.06);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 10rpx 0;
  color: #a8a193;
  font-size: 22rpx;
  font-weight: 600;
}

.tab-item.active {
  color: #3f7e70;
}

.tab-icon-image {
  width: 44rpx;
  height: 44rpx;
}

.muted-tab-icon {
  opacity: 0.5;
  filter: grayscale(0.35);
}

/* ---------- Top bars ---------- */
.topbar {
  position: sticky;
  top: 0;
  z-index: 12;
  min-height: 88rpx;
  margin: 0 -36rpx 22rpx;
  padding: 8rpx 24rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr auto;
  align-items: center;
  gap: 14rpx;
  /* opaque, same tone as the page background so scrolled content
     never shows through behind the title; spans the full width */
  background: #fcf9f3;
}

/* seamless cover above the stuck bar: hides the sliver of content that can
   peek out between the viewport top and the sticky bar */
.topbar::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 100%;
  height: 88rpx;
  background: #fcf9f3;
}

.topbar.compact {
  grid-template-columns: 72rpx 1fr auto;
}

.page-title,
.progress-label {
  color: #2c2b26;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
  text-align: center;
}

.icon-button {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5a544a;
  background: rgba(255, 255, 255, 0.7);
  border: 2rpx solid rgba(255, 255, 255, 0.82);
}

.icon-button.compact {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
}

/* ---------- Profile ---------- */
.profile-view {
  padding-bottom: 200rpx;
}

.profile-toolbar-spacer {
  width: 72rpx;
}

.profile-toolbar-icons {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #8a8478;
}

.profile-hero {
  padding: 28rpx;
  border-radius: 36rpx;
  display: grid;
  grid-template-columns: 132rpx 1fr auto;
  gap: 22rpx;
  align-items: center;
  background: #fffdf9;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(122, 98, 60, 0.1);
}

.profile-book-art,
.asset-card-illustration {
  width: 132rpx;
  height: 132rpx;
}

.profile-book {
  display: block;
  margin: 8rpx 0;
  color: #2c2b26;
  font-size: 36rpx;
  font-weight: 800;
}

.level-pill,
.pill {
  border-radius: 999rpx;
  padding: 12rpx 18rpx;
  color: #3f7e70;
  background: rgba(77, 132, 120, 0.12);
  font-size: 24rpx;
  font-weight: 800;
}

.profile-grid,
.stats-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.profile-grid view,
.stats-grid .metric {
  min-height: 120rpx;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fffdf9;
  border: 2rpx solid rgba(122, 98, 60, 0.07);
}

.metric-value {
  color: #3f7e70;
  font-size: 38rpx;
  font-weight: 800;
}

.metric-label {
  margin-top: 6rpx;
  color: #9b9488;
  font-size: 22rpx;
}

.profile-card,
.profile-list,
.month-panel {
  margin-top: 24rpx;
  padding: 28rpx;
}

.profile-card .card-row,
.month-panel .card-row {
  justify-content: space-between;
}

.inline-options {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.level-options.single {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.level-option {
  min-height: 104rpx;
  border-radius: 28rpx;
  padding: 20rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #fffdf9;
  border: 2rpx solid rgba(122, 98, 60, 0.1);
}

.level-option.compact {
  min-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
}

.level-option.enabled {
  color: #2c2b26;
}

.level-option.disabled {
  color: #b6ae9f;
  background: rgba(255, 255, 255, 0.5);
}

.level-option.selected {
  border-color: #4d8478;
  background: rgba(77, 132, 120, 0.1);
}

.level-option-label {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
}

.level-option-status {
  display: block;
  margin-top: 6rpx;
  color: #9b9488;
  font-size: 22rpx;
}

.level-kind,
.level-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  color: #4d8478;
  background: rgba(77, 132, 120, 0.12);
}

.level-check {
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-card,
.action-entry,
.list-button,
.profile-test-entry {
  position: relative;
}

.profile-test-grid {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.profile-test-entry,
.list-button {
  min-height: 112rpx;
  border-radius: 28rpx;
  padding: 20rpx;
  display: grid;
  grid-template-columns: 52rpx 1fr auto;
  gap: 14rpx;
  align-items: center;
  background: #fffdf9;
  border: 2rpx solid rgba(122, 98, 60, 0.1);
}

.entry-title {
  color: #2c2b26;
  font-size: 28rpx;
  font-weight: 800;
}

.entry-meta {
  color: #9b9488;
  font-size: 22rpx;
}

.profile-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: transparent;
  box-shadow: none;
  border: 0;
  padding-left: 0;
  padding-right: 0;
}

.week-row,
.month-calendar {
  margin-top: 20rpx;
}

.week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.week-dot {
  min-height: 78rpx;
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #9b9488;
  background: rgba(77, 132, 120, 0.06);
  font-size: 20rpx;
}

.week-dot.active {
  color: #fffaf0;
  background: #4d8478;
}

.week-summary {
  margin-top: 16rpx;
}

/* ---------- Month progress ---------- */
.month-hero-panel,
.question-panel,
.result-panel {
  padding: 34rpx;
}

.asset-month-illustration,
.asset-panel-illustration,
.asset-result-illustration {
  display: block;
  width: 184rpx;
  height: 156rpx;
  margin: 0 auto 12rpx;
}

.month-picker,
.month-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.month-title {
  color: #2c2b26;
  font-size: 38rpx;
  font-weight: 800;
}

.month-picker-action,
.level-test-link {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #4d8478;
  font-size: 24rpx;
  font-weight: 800;
}

.month-switch {
  margin-top: 20rpx;
  color: #9b9488;
  font-size: 24rpx;
  font-weight: 700;
}

.month-calendar {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.month-weekday {
  text-align: center;
  color: #b6ae9f;
  font-size: 20rpx;
  font-weight: 700;
}

.month-day {
  min-height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6b6459;
  background: rgba(255, 255, 255, 0.6);
}

.month-day.blank {
  opacity: 0;
}

.month-day.active {
  color: #fffaf0;
  background: #4d8478;
}

.month-day-meta {
  margin-top: 2rpx;
  font-size: 18rpx;
}

.trend-bars {
  height: 160rpx;
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  align-items: end;
  gap: 12rpx;
}

.trend-bar {
  height: 140rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  gap: 8rpx;
  color: #b6ae9f;
  font-size: 18rpx;
}

.trend-bar view {
  width: 26rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #6fa893, #4d8478);
}

.stage-test-copy {
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.asset-row-icon {
  width: 50rpx;
  height: 50rpx;
}

.asset-row-icon.large {
  width: 108rpx;
  height: 108rpx;
}

.stage-skill-row {
  margin: 24rpx 0;
