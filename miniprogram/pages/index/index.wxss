}

.focus-card {
  position: relative;
  z-index: 2;
  width: 100%;
  min-height: 640rpx;
  margin-top: 84rpx;
  border-radius: 52rpx;
  padding: 56rpx 38rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: transparent;
  border: 0;
  box-shadow: none;
}

/* bottom ink-wash landscape for the focus learning pages: background layer */
.focus-landscape {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 540rpx;
  opacity: 0.92;
