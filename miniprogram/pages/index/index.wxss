}

.focus-reveal.correct,
.focus-reveal.is-correct {
  border-color: rgba(77, 132, 120, 0.4);
  background: rgba(77, 132, 120, 0.1);
}

.focus-reveal.wrong {
  border-color: rgba(208, 106, 74, 0.4);
  background: rgba(208, 106, 74, 0.08);
}

.focus-reveal.muted-card {
  opacity: 0.55;
}

.option-line {
  display: block;
  line-height: 1.25;
}

.speaker-tile.focus-speaker {
  width: 230rpx;
  height: 230rpx;
  margin-bottom: 30rpx;
  background: radial-gradient(circle, #ffffff 0%, rgba(77, 132, 120, 0.1) 100%);
  /* concentric ripple rings like the listening reference */
  box-shadow:
    0 0 0 14rpx rgba(77, 132, 120, 0.06),
    0 0 0 34rpx rgba(77, 132, 120, 0.04),
    0 0 0 58rpx rgba(77, 132, 120, 0.025),
    0 18rpx 44rpx rgba(77, 132, 120, 0.16);
}

.asset-listening-icon {
