}

.recall-placeholder {
  color: #8c8378;
  font-size: 28rpx;
  font-weight: 900;
}

.audio-tools {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.audio-tools view {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.56);
  color: #4f623c;
  font-weight: 900;
}

.focus-flow .focus-card,
.learning-dark .focus-card,
.learning-dark .focus-card.audio-panel,
.learning-dark .focus-card.study-focus-card {
