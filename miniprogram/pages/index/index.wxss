  color: #faf9f5;
}

.learning-view.learning-light {
  background:
    radial-gradient(circle at 50% 32%, rgba(15, 143, 122, 0.14) 0%, rgba(250, 249, 245, 0.2) 36%, rgba(250, 249, 245, 0) 62%),
    linear-gradient(180deg, #faf9f5 0%, #e8e6dc 100%);
  color: #141413;
}

.focus-flow {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 100vh;
  padding-top: calc(env(safe-area-inset-top) + 56rpx);
  padding-bottom: calc(env(safe-area-inset-bottom) + 168rpx);
  overflow: hidden;
}

.focus-flow::after {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 0;
  content: "";
  background: rgba(217, 87, 87, 0);
  box-shadow: none;
  pointer-events: none;
  transition: width 160ms ease, background 160ms ease, box-shadow 160ms ease;
}

.focus-flow.edge-wrong::after {
  width: 18rpx;
  background: rgba(217, 87, 87, 0.45);
  box-shadow: -18rpx 0 70rpx rgba(217, 87, 87, 0.42);
}

.focus-progress {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 28rpx);
  left: 50%;
  z-index: 2;
  display: flex;
  max-width: calc(100% - 80rpx);
  gap: 10rpx;
  transform: translateX(-50%);
}

.focus-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(250, 249, 245, 0.22);
  background: transparent;
}

.focus-dot.done {
  border-color: #0f8f7a;
  background: #0f8f7a;
}

.focus-dot.current {
  border-color: #d97757;
  background: #d97757;
  animation: focusPulse 1.2s ease-in-out infinite;
}

.focus-dot.audio.current {
  border-color: #faf9f5;
  background: #faf9f5;
}

.focus-dot.recall.current {
  border-color: #f1a184;
  background: #f1a184;
}

.focus-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 52vh;
  padding: 32rpx 10rpx;
  background: transparent;
  border: 0;
  box-shadow: none;
  text-align: center;
  box-sizing: border-box;
}

.focus-stack {
  width: 100%;
}

.focus-card .study-word,
.focus-card .test-word {
  max-width: 100%;
  color: #faf9f5;
  font-size: 92rpx;
  line-height: 1.05;
  letter-spacing: -3rpx;
  word-break: break-word;
}

.focus-card .ipa {
  margin-top: 22rpx;
  color: rgba(250, 249, 245, 0.58);
  font-size: 30rpx;
  font-weight: 800;
}

.focus-card .meaning {
  margin-top: 30rpx;
  color: rgba(250, 249, 245, 0.74);
  font-size: 34rpx;
  font-weight: 900;
}

.focus-reveal,
.meaning-recall-prompt,
.meaning-word-reveal {
  animation: revealUp 150ms ease-out;
}

.focus-reveal {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  padding: 22rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(250, 249, 245, 0.1);
  color: #faf9f5;
  font-size: 34rpx;
  font-weight: 900;
}

.focus-actions {
  position: fixed;
  right: 36rpx;
  bottom: calc(env(safe-area-inset-bottom) + 42rpx);
  left: 36rpx;
  z-index: 3;
}

.focus-primary {
  min-height: 92rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
}

.read-pulse {
  width: 14rpx;
  height: 14rpx;
  margin-top: 34rpx;
  border-radius: 999rpx;
  background: rgba(250, 249, 245, 0.18);
}

.read-pulse.active {
  background: #0f8f7a;
  animation: focusPulse 1.2s ease-in-out infinite;
}

.audio-focus-card {
  gap: 42rpx;
}

.focus-speaker {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  min-height: 168rpx;
  border-radius: 999rpx;
}

.focus-speaker::before {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 44rpx;
  height: 44rpx;
  content: "";
  border-radius: 999rpx;
  background: #faf9f5;
  box-shadow:
    0 0 0 22rpx rgba(250, 249, 245, 0.1),
    0 0 0 48rpx rgba(15, 143, 122, 0.14);
  transform: translate(-50%, -50%);
  animation: focusPulse 1.4s ease-in-out infinite;
}

.focus-pause-mask {
  z-index: 30;
}

.focus-pause-card {
  display: grid;
  gap: 18rpx;
  width: min(620rpx, calc(100vw - 96rpx));
  padding: 42rpx;
  border-radius: 34rpx;
  background: rgba(250, 249, 245, 0.94);
  box-shadow: 0 40rpx 120rpx rgba(0, 0, 0, 0.34);
}

.pause-count {
  display: block;
  margin-bottom: 12rpx;
  color: #141413;
  font-size: 36rpx;
  font-weight: 900;
  text-align: center;
}

@keyframes focusPulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.72;
  }
  50% {
    transform: scale(1.32);
    opacity: 1;
  }
}

@keyframes revealUp {
  from {
    opacity: 0;
    transform: translateY(28rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

