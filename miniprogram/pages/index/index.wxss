.app-shell {
  min-height: 100vh;
  background: #020b0f !important;
  overflow-x: hidden;
  color: #fff9ef !important;
}

.view {
  width: 100%;
  max-width: 720px;
  min-height: 100vh;
  margin: 0 auto;
  padding: calc(env(safe-area-inset-top) + 32rpx) 28rpx calc(env(safe-area-inset-bottom) + 184rpx);
  box-sizing: border-box;
  background: transparent !important;
  color: #fff9ef !important;
}

.topbar {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.topbar.compact {
  justify-content: flex-start;
}

.study-topbar {
  gap: 18rpx;
}

.study-page-title {
  flex: 1 1 auto;
  min-width: 0;
  text-align: center;
  font-size: 38rpx;
}

.study-topbar .progress-label {
  flex: 0 0 auto;
}

.sticky-view {
  padding-top: calc(env(safe-area-inset-top) + 144rpx);
}

.sticky-view .topbar {
  position: fixed;
  top: 0;
  left: 50%;
  z-index: 8;
  width: 100%;
  max-width: 720px;
  min-height: calc(env(safe-area-inset-top) + 112rpx);
  margin: 0;
  padding: calc(env(safe-area-inset-top) + 16rpx) 28rpx 16rpx;
  transform: translateX(-50%);
  background:
    linear-gradient(180deg, rgba(250, 249, 245, 0.98) 0%, rgba(250, 249, 245, 0.9) 72%, rgba(250, 249, 245, 0) 100%);
  box-sizing: border-box;
}

.page-title,
.hero-title,
.test-word,
.study-word,
.detail-word {
  display: block;
  color: #141413;
  font-weight: 900;
  line-height: 1.18;
}

.page-title {
  font-size: 44rpx;
}

.eyebrow,
.section-label,
.muted,
.hint,
.option-sub {
  display: block;
  color: #6e6a62;
}

.eyebrow,
.section-label {
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.hero-panel,
.question-panel,
.result-panel,
.study-card,
.audio-panel,
.report-panel,
.empty-state,
.detail-card {
  background: rgba(250, 249, 245, 0.72);
  border: 2rpx solid rgba(20, 20, 19, 0.12);
  border-radius: 16rpx;
  padding: 36rpx;
  box-shadow: 0 28rpx 68rpx rgba(20, 20, 19, 0.16);
  box-sizing: border-box;
}

.hero-title {
  max-width: 100%;
  margin-bottom: 36rpx;
  font-size: 48rpx;
  word-break: break-word;
}

.primary-button,
.secondary-button,
.list-button,
.option-card,
.icon-button,
.text-link,
.segmented-button,
.sound-button,
.speaker-tile,
.sound-mini,
.select-toggle,
.word-link {
  border: 0;
  line-height: 1.2;
  margin: 0;
  box-sizing: border-box;
  max-width: 100%;
}

button::after {
  border: 0;
}

.primary-button,
.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 96rpx;
  border-radius: 16rpx;
  padding: 0 36rpx;
  font-weight: 900;
}

.primary-button {
  background: #d97757;
  color: #141413;
}

.primary-button[disabled] {
  opacity: 0.45;
}

.primary-button.disabled {
  opacity: 0.38;
}

.primary-button.small {
  min-height: 84rpx;
}

.hero-panel .primary-button,
.result-panel .primary-button,
.report-panel .primary-button,
.empty-state .primary-button {
  min-width: 300rpx;
  margin: 0 auto;
}

.secondary-button {
  background: rgba(250, 249, 245, 0.82);
  color: #4f623c;
}

.icon-button {
  display: flex;
  flex: 0 0 84rpx;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  min-width: 84rpx;
  max-width: 84rpx;
  height: 84rpx;
  padding: 0;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.54);
  color: #141413;
  font-size: 48rpx;
  text-align: center;
}

.topbar.compact .icon-button {
  flex: 0 0 84rpx;
  width: 84rpx;
  min-width: 84rpx;
  max-width: 84rpx;
}

.coach-strip,
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin: 28rpx 0;
}

.stats-grid {
  grid-template-columns: repeat(3, 1fr);
}

.coach-strip view,
.metric,
.info-strip view,
.copy-card,
.review-summary {
  border: 2rpx solid rgba(20, 20, 19, 0.14);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.56);
  padding: 24rpx;
  box-sizing: border-box;
}

.coach-strip text:first-child,
.strong,
.card-title {
  display: block;
  font-weight: 900;
}

.info-strip,
.action-list,
.option-stack,
.word-list,
.review-stack {
  display: grid;
  width: 100%;
  gap: 24rpx;
  margin: 28rpx 0;
}

.metric {
  text-align: center;
}

.metric text:first-child {
  display: block;
  font-size: 42rpx;
  font-weight: 900;
}

.metric text:last-child {
  display: block;
  color: #6e6a62;
  font-size: 24rpx;
}

.list-button {
  width: 100%;
  min-width: 0;
  justify-self: stretch;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  min-height: 148rpx;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  background: #faf9f5;
  text-align: left;
}

.action-entry {
  position: relative;
  grid-template-columns: minmax(0, 1fr) auto 42rpx;
  border: 2rpx solid rgba(217, 119, 87, 0.34);
  background:
    linear-gradient(135deg, rgba(217, 119, 87, 0.12), rgba(250, 249, 245, 0.9));
  box-shadow: 0 16rpx 34rpx rgba(20, 20, 19, 0.08);
}

.action-entry::before {
  content: "";
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 8rpx;
  border-radius: 999rpx;
  background: #d97757;
}

.action-entry text:nth-child(2) {
  color: #6e6a62;
  font-size: 24rpx;
  text-align: right;
  word-break: break-word;
}

.action-entry-pressed {
  transform: scale(0.985);
  opacity: 0.86;
}

.list-button text:first-child {
  display: block;
  font-weight: 900;
}

.list-button text:last-child {
  display: block;
  color: #6e6a62;
  font-size: 24rpx;
  text-align: right;
  word-break: break-word;
}

.entry-arrow {
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: #d97757;
  color: #141413 !important;
  font-size: 34rpx !important;
  font-weight: 900;
  line-height: 1;
}

.progress-label {
  margin-left: auto;
  color: #6e6a62;
  font-weight: 900;
}

.test-word,
.study-word,
.detail-word {
  margin: 24rpx 0;
  font-size: 64rpx;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.option-card {
  display: block;
  width: 100%;
  min-height: 108rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #faf9f5;
  color: #141413;
  text-align: left;
  font-weight: 800;
  white-space: normal;
  overflow: hidden;
  word-break: break-word;
}

.test-option {
  display: flex;
  align-items: center;
  min-height: 118rpx;
  border: 2rpx solid rgba(120, 140, 93, 0.28);
  border-left: 10rpx solid #788c5d;
  background:
    linear-gradient(135deg, rgba(120, 140, 93, 0.16), rgba(232, 230, 220, 0.86));
  box-shadow: 0 14rpx 30rpx rgba(20, 20, 19, 0.08);
  font-size: 32rpx;
}

.test-option-pressed {
  transform: scale(0.985);
  opacity: 0.86;
}

.option-card.correct {
  background: rgba(120, 140, 93, 0.22);
  color: #4f623c;
}

.option-card.wrong {
  background: rgba(217, 119, 87, 0.22);
  color: #8f412b;
}

.option-card.muted-card {
  opacity: 0.45;
}

.answer-option {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 24rpx 28rpx;
}

.option-line {
  display: block;
  min-width: 0;
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.option-pos {
  margin-right: 10rpx;
  color: #788c5d;
}

.unknown-button {
  width: 100%;
  margin-top: 24rpx;
}

.counter-bar,
.bottom-actions {
  position: fixed;
  left: 50%;
  bottom: calc(env(safe-area-inset-bottom) + 28rpx);
  width: calc(100vw - 56rpx);
  max-width: 720px;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(250, 249, 245, 0.94);
  box-shadow: 0 20rpx 48rpx rgba(20, 20, 19, 0.16);
  box-sizing: border-box;
}

.precheck-actions {
  display: grid;
  grid-template-columns: 92rpx minmax(0, 1fr) minmax(0, 1fr);
  align-items: center;
}

.precheck-view {
  position: relative;
  height: 100vh;
  min-height: 0;
  overflow: hidden;
  padding-bottom: 0;
}

.precheck-view .topbar {
  min-height: 68rpx;
  gap: 18rpx;
  margin-bottom: 16rpx;
}

.precheck-view .icon-button {
  flex-basis: 64rpx;
  width: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  font-size: 38rpx;
}

.precheck-view .page-title {
  font-size: 38rpx;
  letter-spacing: -1rpx;
}

.precheck-scroll {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 132rpx);
  right: 0;
  bottom: calc(env(safe-area-inset-bottom) + 154rpx);
  left: 0;
  height: auto;
  min-height: 0;
  overflow-x: hidden;
  box-sizing: border-box;
}

.precheck-view .word-list {
  width: 100%;
  min-height: 100%;
  box-sizing: border-box;
  gap: 14rpx;
  margin: 0;
  padding: 0 52rpx 22rpx;
}

.precheck-list {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  overflow-x: hidden;
  box-sizing: border-box;
}

.precheck-view .precheck-actions {
  width: calc(100vw - 104rpx);
  max-width: 668px;
  grid-template-columns: 76rpx minmax(0, 1fr) minmax(0, 1fr);
  padding: 14rpx 16rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(20, 20, 19, 0.98), rgba(79, 98, 60, 0.94));
  box-shadow: 0 22rpx 54rpx rgba(20, 20, 19, 0.24);
}

.bottom-actions.two {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  align-items: stretch;
}

.bottom-actions.status-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 176rpx;
  align-items: center;
}

.status-actions text {
  display: block;
  min-width: 0;
  color: #6e6a62;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-word;
}

.bottom-actions .primary-button,
.bottom-actions .secondary-button {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  padding: 0 20rpx;
  overflow: hidden;
}

.pill {
  min-width: 72rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  color: #141413;
  text-align: center;
  font-weight: 900;
}

.green {
  background: #788c5d;
}

.red {
  background: #d97757;
}

.blue {
  background: #6a9bcc;
}

.vocab-number {
  display: block;
  margin: 24rpx 0;
  font-size: 96rpx;
  font-weight: 900;
  color: #788c5d;
}

.precheck-row,
.review-card {
  padding: 28rpx;
  border: 2rpx solid rgba(20, 20, 19, 0.14);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.62);
  box-sizing: border-box;
}

.precheck-row {
  display: grid;
  gap: 22rpx;
}

.precheck-view .precheck-row {
  width: 100%;
  min-width: 0;
  gap: 10rpx;
  padding: 16rpx 22rpx;
  border-color: rgba(20, 20, 19, 0.1);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.58);
  box-shadow: 0 14rpx 36rpx rgba(20, 20, 19, 0.08);
  overflow: hidden;
}

.precheck-view .precheck-card-single {
  max-width: 620rpx;
  min-height: 560rpx;
  justify-content: center;
  gap: 42rpx;
  padding: 56rpx 44rpx;
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 50% 16%, rgba(217, 119, 87, 0.12), transparent 34%),
    rgba(250, 249, 245, 0.82);
}

.precheck-head {
  display: grid;
  grid-template-columns: 44rpx minmax(0, 1fr);
  align-items: center;
  gap: 18rpx;
}

.precheck-view .precheck-head {
  grid-template-columns: 34rpx minmax(0, 1fr);
  gap: 16rpx;
  min-width: 0;
}

.precheck-view .precheck-card-single .precheck-head {
  grid-template-columns: 1fr;
}

.precheck-view .precheck-card-single .precheck-main {
  justify-content: center;
}

.precheck-row.picked {
  border-color: #788c5d;
}

.index {
  color: #6e6a62;
  font-weight: 900;
}

.precheck-view .index {
  font-size: 28rpx;
}

.precheck-main {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 18rpx;
}

.select-toggle,
.sound-mini {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #faf9f5;
  color: #788c5d;
  font-weight: 900;
}

.select-toggle {
  width: 64rpx;
  height: 64rpx;
}

.precheck-view .select-toggle {
  width: 52rpx;
  height: 52rpx;
  font-size: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(120, 140, 93, 0.1);
}

.select-toggle.on {
  background: #d97757;
  color: #141413;
}

.sound-mini {
  width: 124rpx;
  min-width: 124rpx;
  height: 72rpx;
  font-size: 26rpx;
}

.word-link {
  display: block;
  min-width: 0;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.84);
  text-align: center;
  font-size: 40rpx;
  font-weight: 900;
  overflow-wrap: anywhere;
  line-height: 1.15;
}

.precheck-view .word-link {
  flex: 0 0 auto;
  min-width: auto;
  padding: 8rpx 16rpx;
  background: rgba(250, 249, 245, 0.96);
  color: #141413;
  font-size: 32rpx;
  white-space: nowrap;
  overflow: visible;
  text-overflow: clip;
}

.precheck-view .precheck-card-single .word-link {
  padding: 22rpx 34rpx;
  background: transparent;
  font-size: 68rpx;
  letter-spacing: -2rpx;
}

.meaning-inline {
  display: block;
  padding-left: 62rpx;
  color: #6e6a62;
  font-size: 32rpx;
  font-weight: 800;
  word-break: break-word;
}

.meaning-inline text {
  margin-right: 10rpx;
  color: #788c5d;
}

.precheck-view .meaning-inline {
  padding-left: 48rpx;
  font-size: 25rpx;
  line-height: 1.3;
}

.precheck-view .precheck-meaning {
  flex: 1 1 0;
  min-width: 0;
  padding-left: 0;
  color: #4f623c;
  font-size: 28rpx;
  font-weight: 900;
  text-align: right;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.precheck-view .precheck-meaning text {
  color: #d97757;
}

.segmented {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.precheck-view .segmented {
  display: flex;
  justify-content: center;
  gap: 14rpx;
  min-width: 0;
}

.segmented-button {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #faf9f5;
  color: #6e6a62;
  font-weight: 800;
  box-sizing: border-box;
}

.precheck-view .segmented-button {
  width: auto;
  min-width: 156rpx;
  min-height: 68rpx;
  padding: 0 26rpx;
  border-radius: 22rpx;
  border: 2rpx solid transparent;
  font-size: 28rpx;
  font-weight: 900;
}

.precheck-view .segmented-button.known {
  border-color: rgba(120, 140, 93, 0.28);
  background: rgba(120, 140, 93, 0.12);
  color: #4f623c;
}

.precheck-view .segmented-button.unfamiliar {
  border-color: rgba(217, 119, 87, 0.3);
  background: rgba(217, 119, 87, 0.12);
  color: #8f412b;
}

.segmented .selected {
  background: rgba(120, 140, 93, 0.22);
  color: #4f623c;
}

.segmented .danger {
  background: rgba(217, 119, 87, 0.22);
  color: #8f412b;
}

.selection-count {
  display: block;
  color: #141413;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: center;
}

.precheck-view .selection-count {
  padding: 8rpx 6rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
  font-size: 23rpx;
}

.precheck-view .bottom-actions .primary-button,
.precheck-view .bottom-actions .secondary-button {
  min-height: 72rpx;
  font-size: 28rpx;
}

.precheck-view .bottom-actions .secondary-button {
  background: rgba(255, 255, 255, 0.92);
  color: #4f623c;
}

.precheck-view .bottom-actions .primary-button {
  background: #d97757;
  color: #141413;
}

.precheck-view .bottom-actions .primary-button.disabled {
  background: rgba(255, 255, 255, 0.3);
  color: rgba(255, 255, 255, 0.68);
  opacity: 1;
}

.memory-image {
  display: grid;
  gap: 10rpx;
  margin: 24rpx 0;
  padding: 28rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(120, 140, 93, 0.16), rgba(217, 119, 87, 0.2));
}

.memory-mark {
  color: #4f623c;
  font-weight: 900;
}

.study-memory-image {
  margin: 4rpx 0 0;
  border: 2rpx solid rgba(120, 140, 93, 0.18);
  background:
    linear-gradient(135deg, rgba(120, 140, 93, 0.12), rgba(217, 119, 87, 0.14));
}

.usage-card {
  display: grid;
  gap: 22rpx;
  margin: 8rpx 0 0;
  padding: 26rpx;
  border: 2rpx solid rgba(120, 140, 93, 0.18);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.56);
  box-sizing: border-box;
}

.usage-section {
  display: grid;
  gap: 12rpx;
}

.usage-title {
  color: #4f623c;
  font-size: 24rpx;
  font-weight: 900;
}

.usage-chip {
  display: grid;
  gap: 4rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(250, 249, 245, 0.86);
  color: #141413;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.28;
}

.usage-chip text:last-child {
  color: #6e6a62;
  font-size: 24rpx;
  font-weight: 800;
}

.usage-example-en,
.usage-example-cn,
.usage-ai-label {
  display: block;
  line-height: 1.35;
}

.usage-example-en {
  color: #141413;
  font-size: 30rpx;
  font-weight: 900;
}

.usage-example-cn {
  color: #665d55;
  font-size: 26rpx;
  font-weight: 800;
}

.usage-ai-label {
  color: #8c8378;
  font-size: 22rpx;
  font-weight: 800;
  text-align: right;
}

.speaker-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  margin: 16rpx 0;
  border-radius: 999rpx;
  background: #141413;
  color: #faf9f5;
  font-weight: 900;
}

.sound-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 148rpx;
  min-height: 58rpx;
  margin: 4rpx 0 8rpx;
  padding: 0 26rpx;
  border: 2rpx solid rgba(120, 140, 93, 0.22);
  border-radius: 999rpx;
  background: rgba(120, 140, 93, 0.1);
  color: #4f623c;
  font-size: 25rpx;
  font-weight: 900;
}

.speaker-tile {
  width: 200rpx;
  height: 200rpx;
  border-radius: 56rpx;
  font-size: 36rpx;
