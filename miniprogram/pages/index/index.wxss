}

@media (max-width: 360px) {
  .home-progress-body {
    grid-template-columns: 1fr;
  }

  .home-progress-art {
    display: none;
  }
}

.precheck-view {
  position: relative !important;
  display: flex;
  min-height: 100vh !important;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: calc(env(safe-area-inset-top) + 96rpx) 40rpx calc(env(safe-area-inset-bottom) + 128rpx) !important;
  overflow: hidden !important;
  background: transparent !important;
}

.precheck-title {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 24rpx);
  left: 0;
  right: 0;
  color: var(--spec-secondary);
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}

.precheck-stage-card {
  display: flex;
  width: 560rpx;
  max-width: calc(100vw - 80rpx);
  height: 720rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
  border: 2rpx solid var(--spec-border);
  border-radius: 32rpx;
  background: var(--spec-card-elevated);
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.22);
  transition: transform 180ms ease, opacity 180ms ease, border-color 150ms ease;
  box-sizing: border-box;
}

.precheck-stage-card.hint-known {
  border-color: var(--spec-success-bright);
  transform: translateY(-18rpx) scale(0.99);
}

.precheck-stage-card.hint-unfamiliar {
  border-color: var(--spec-accent);
  transform: translateY(18rpx) scale(0.99);
}

.precheck-stage-card.exit-known {
  opacity: 0;
  transform: translateY(-220rpx) scale(0.92);
}

.precheck-stage-card.exit-unfamiliar {
  opacity: 0;
  transform: translateY(220rpx) scale(0.92);
}

.precheck-word {
  max-width: 92%;
  color: var(--spec-text);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 72rpx;
  font-weight: 900;
  line-height: 1.08;
  text-align: center;
  word-break: break-word;
}

.precheck-audio-dot {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: rgba(94, 138, 106, 0.12);
  color: var(--spec-label);
}

.precheck-hints {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 48rpx;
  color: var(--spec-label);
  opacity: 0.62;
}

.precheck-hint {
  display: grid;
  gap: 8rpx;
  justify-items: center;
  font-size: 26rpx;
  font-weight: 700;
}

.precheck-hint text:first-child {
  font-size: 42rpx;
  line-height: 1;
}

.precheck-bottom-status {
  position: fixed;
  right: 40rpx;
  bottom: calc(env(safe-area-inset-bottom) + 28rpx);
  left: 40rpx;
  display: flex;
  justify-content: space-between;
  color: var(--spec-label);
  font-size: 26rpx;
  font-weight: 700;
}

.precheck-bottom-status text:first-child {
  color: var(--spec-text);
  font-size: 28rpx;
  font-weight: 900;
}

.focus-flow {
  position: relative !important;
  display: flex !important;
  min-height: 100vh !important;
  align-items: center;
  justify-content: center;
  padding: calc(env(safe-area-inset-top) + 86rpx) 40rpx calc(env(safe-area-inset-bottom) + 150rpx) !important;
  overflow: hidden !important;
  background:
    radial-gradient(circle at 50% 36%, rgba(94, 138, 106, 0.12), transparent 36%),
    var(--spec-bg) !important;
}

.learning-light.focus-flow {
  background:
    radial-gradient(circle at 50% 34%, rgba(94, 138, 106, 0.1), transparent 36%),
    linear-gradient(180deg, #fbf8ef 0%, #f5f0e8 64%, #eee5d6 100%) !important;
}

.focus-flow::before {
  position: absolute;
  right: -40rpx;
  bottom: 108rpx;
  left: -40rpx;
  height: 360rpx;
  content: "";
  opacity: 0.46;
  pointer-events: none;
  background:
    radial-gradient(ellipse at 22% 100%, rgba(94, 138, 106, 0.22) 0 16%, transparent 17%),
    radial-gradient(ellipse at 78% 100%, rgba(94, 138, 106, 0.18) 0 20%, transparent 21%),
    linear-gradient(180deg, transparent, rgba(94, 138, 106, 0.11));
}

.focus-pause-handle {
  position: absolute !important;
  top: calc(env(safe-area-inset-top) + 260rpx) !important;
  left: 0 !important;
  z-index: 3;
  display: grid;
  gap: 10rpx;
  width: 54rpx;
  padding: 18rpx 0;
  border: 2rpx solid var(--spec-border);
  border-left: 0;
  border-radius: 0 24rpx 24rpx 0;
  color: var(--spec-label);
  background: rgba(255, 255, 255, 0.24);
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
  opacity: 0.65;
  writing-mode: vertical-rl;
}

.focus-progress {
  top: calc(env(safe-area-inset-top) + 72rpx) !important;
  gap: 32rpx !important;
}

.focus-dot {
  width: 14rpx !important;
  height: 14rpx !important;
  border: 0 !important;
  background: var(--spec-dot-pending, rgba(94, 138, 106, 0.25)) !important;
}

.focus-dot.done {
  background: var(--spec-success) !important;
}

.focus-dot.current {
  background: var(--spec-success-bright) !important;
  box-shadow: 0 0 0 18rpx rgba(94, 138, 106, 0.14) !important;
}

.focus-card {
  position: relative;
  z-index: 2;
  display: flex !important;
  width: 100% !important;
  min-height: 58vh !important;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 !important;
  border: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  text-align: center;
}

.focus-card .study-word,
.focus-card .test-word {
  max-width: 100%;
  margin: 0 !important;
  color: var(--spec-text) !important;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 96rpx !important;
  font-weight: 900 !important;
  line-height: 1.05;
  letter-spacing: -2rpx;
  word-break: break-word;
}

.focus-card .ipa {
  margin: 28rpx 0 0 !important;
  color: var(--spec-secondary) !important;
  font-size: 28rpx !important;
  font-weight: 400 !important;
}

.sound-orb {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: var(--spec-success-bright);
  background: rgba(94, 138, 106, 0.1);
  box-shadow:
    0 0 0 24rpx rgba(94, 138, 106, 0.08),
    0 0 0 48rpx rgba(94, 138, 106, 0.04);
}

.sound-orb.small {
  width: 80rpx;
  height: 80rpx;
  margin: 74rpx 0 52rpx;
}

.sound-orb.large {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 44rpx;
  box-shadow:
    0 0 0 40rpx rgba(94, 138, 106, 0.08),
    0 0 0 80rpx rgba(94, 138, 106, 0.04);
}

.speaker-tile.focus-speaker {
  width: 160rpx !important;
  height: 160rpx !important;
  min-height: 160rpx !important;
  margin: 0 0 44rpx !important;
  border: 0 !important;
  border-radius: 999rpx !important;
  color: var(--spec-success-bright) !important;
  background: rgba(94, 138, 106, 0.1) !important;
  box-shadow:
    0 0 0 40rpx rgba(94, 138, 106, 0.08),
    0 0 0 80rpx rgba(94, 138, 106, 0.04) !important;
  animation: soundOrbPulse 1.4s ease-in-out infinite;
}

.speaker-tile.focus-speaker .icon-soundwave {
  width: 92rpx;
  height: 92rpx;
}

.sound-orb.active,
.sound-orb.large {
  animation: soundOrbPulse 1.4s ease-in-out infinite;
}

.sound-orb .icon-soundwave {
  width: 58rpx;
  height: 58rpx;
}

.sound-orb.large .icon-soundwave {
  width: 92rpx;
  height: 92rpx;
}

.focus-card .meaning {
  max-width: 670rpx;
  margin: 0 !important;
  color: var(--spec-text) !important;
  font-size: 30rpx !important;
  font-weight: 700 !important;
  line-height: 1.35;
}

.focus-card .meaning text,
.option-pos {
  color: var(--spec-success-bright) !important;
}

.study-hint {
  display: block;
  margin-top: 42rpx;
  color: var(--spec-label);
  font-size: 22rpx;
  font-weight: 600;
  opacity: 0.7;
}

.audio-playing-text {
  color: var(--spec-secondary);
  font-size: 26rpx;
  font-weight: 700;
}

.reveal-card {
  display: grid;
  gap: 0;
  width: 670rpx;
  max-width: 100%;
  min-height: 120rpx;
  margin-top: 44rpx;
  padding: 32rpx 40rpx;
  border: 2rpx solid var(--spec-border);
  border-radius: 24rpx;
  background: var(--spec-card);
  animation: revealUp 150ms ease-out;
  box-sizing: border-box;
}

.reveal-card.ghost {
  color: var(--spec-label);
  opacity: 0.75;
}

.reveal-card .focus-reveal {
  min-height: 0 !important;
  padding: 0 !important;
  border: 0 !important;
  background: transparent !important;
  color: var(--spec-text) !important;
  font-size: 30rpx !important;
  font-weight: 700 !important;
  text-align: left;
}

.focus-actions {
  position: fixed !important;
  right: 40rpx !important;
  bottom: calc(env(safe-area-inset-bottom) + 32rpx) !important;
  left: 40rpx !important;
  z-index: 4;
}

.focus-primary {
  width: 670rpx !important;
  max-width: 100% !important;
  min-height: 88rpx !important;
  border-radius: 24rpx !important;
  background: linear-gradient(135deg, #d4935a, #c4823a) !important;
  color: #ffffff !important;
  font-size: 32rpx !important;
  font-weight: 900 !important;
  box-shadow: 0 16rpx 48rpx rgba(212, 147, 90, 0.3) !important;
}

@keyframes soundOrbPulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.9;
  }
  50% {
    transform: scale(1.08);
    opacity: 1;
  }
}

