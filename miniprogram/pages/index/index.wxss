/* Page specs v1: structure-first reconstruction from docs/design-outputs/page-specs. */
.app-shell {
  --spec-bg: #0b1a17;
  --spec-card: rgba(19, 40, 34, 0.85);
  --spec-card-elevated: rgba(25, 50, 42, 0.9);
  --spec-hint: #1e3d34;
  --spec-border: #24413e;
  --spec-text: #fff9ef;
  --spec-secondary: #a9b7b2;
  --spec-label: #5e8a7a;
  --spec-accent: #d97757;
  --spec-success: #5e8a7a;
  --spec-success-bright: #7abfa8;
  --spec-progress-track: #1e3d34;
  --spec-progress-fill: #d97757;
  min-height: 100vh !important;
  background:
    radial-gradient(circle at 50% 18%, rgba(122, 191, 168, 0.12), transparent 36%),
    linear-gradient(180deg, var(--spec-bg), var(--spec-bg)) !important;
  color: var(--spec-text) !important;
  font-family: "PingFang SC", -apple-system, system-ui, sans-serif;
}

.app-shell.learning-light {
  --spec-bg: #f5f0e8;
  --spec-card: rgba(255, 255, 255, 0.75);
  --spec-card-elevated: rgba(255, 255, 255, 0.9);
  --spec-hint: rgba(255, 255, 255, 0.6);
  --spec-border: rgba(180, 160, 130, 0.25);
  --spec-text: #2c2418;
  --spec-secondary: #7a6e5e;
  --spec-label: #a89880;
  --spec-accent: #d4935a;
  --spec-success: #5e8a6a;
  --spec-success-bright: #4a9b7a;
  --spec-progress-track: rgba(180, 160, 130, 0.2);
  --spec-progress-fill: #d4935a;
  background:
    linear-gradient(180deg, rgba(245, 240, 232, 0.98) 0%, rgba(245, 240, 232, 0.7) 42%, rgba(245, 240, 232, 0.92) 100%),
    radial-gradient(circle at 18% 78%, rgba(94, 138, 106, 0.15), transparent 28%),
    radial-gradient(circle at 86% 18%, rgba(212, 147, 90, 0.16), transparent 28%),
    var(--spec-bg) !important;
  color: var(--spec-text) !important;
}

.app-shell .view {
  color: var(--spec-text) !important;
}

.home-view {
  position: relative !important;
  min-height: 100vh !important;
  padding: calc(env(safe-area-inset-top) + 40rpx) 40rpx calc(env(safe-area-inset-bottom) + 168rpx) !important;
  overflow-x: hidden !important;
  overflow-y: visible !important;
  background: transparent !important;
}

.home-topline {
  position: sticky;
  top: 0;
  z-index: 2;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  align-items: center;
  gap: 24rpx;
  min-height: 88rpx;
  margin-bottom: 32rpx;
}

.home-book-select {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 16rpx;
  color: var(--spec-text);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
}

.home-book-select text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-cover-mini {
  display: flex;
  width: 68rpx;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  filter: drop-shadow(0 8rpx 12rpx rgba(44, 36, 24, 0.18));
  overflow: visible;
}

.home-icon {
  display: block;
  flex: 0 0 auto;
}

.book-cover-image {
  width: 68rpx;
  height: 78rpx;
}

.avatar-icon {
  width: 34rpx;
  height: 34rpx;
}

.section-icon {
  width: 44rpx;
  height: 44rpx;
}

.home-flag-image {
  width: 108rpx;
  height: 124rpx;
}

.card-icon-image {
  width: 48rpx;
  height: 48rpx;
}

.tab-icon-image {
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 4rpx;
}

.home-streak {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--spec-accent);
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
}

.streak-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: var(--spec-accent);
  box-shadow: 0 0 0 8rpx rgba(212, 147, 90, 0.14);
}

.home-avatar {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--spec-border);
  border-radius: 999rpx;
  background: var(--spec-card);
  color: var(--spec-success);
}

.home-main-card {
  position: relative;
  z-index: 2;
  width: 670rpx;
  max-width: 100%;
  margin: 0 auto 24rpx;
