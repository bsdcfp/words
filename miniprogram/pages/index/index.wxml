<view class="app-shell">
  <view wx:if="{{view == 'home'}}" class="view home-view">
    <view class="topbar">
      <view>
        <text class="eyebrow">{{home.levelLabel}} · {{home.groupName}}</text>
        <text class="page-title">今日计划</text>
      </view>
      <view class="profile-chip" bindtap="openProfile">我的</view>
    </view>
    <view wx:if="{{bootError}}" class="boot-error-card">
      <text class="card-title">启动时遇到问题</text>
      <text class="muted">{{bootError}}</text>
      <view class="secondary-button" bindtap="resetData">重置体验数据</view>
    </view>
    <view class="plan-panel">
      <text class="section-label">按记忆曲线安排</text>
      <text class="hero-title">今日至少完成 1 组</text>
      <text class="plan-copy">{{home.todayGroups > 0 ? '今日已完成 ' + home.todayGroups + ' 组，继续按计划学习。' : '每组 3 个词，完成后自动进入下一组。错过复习的词会回到识记。'}}</text>
      <view class="primary-button" bindtap="startDailyLearning">开始今日学习</view>
    </view>
    <view class="plan-grid">
      <view><text>{{home.planCount}}</text><text>最低组数</text></view>
      <view><text>{{home.todayGroups}}</text><text>今日已完成组</text></view>
      <view><text>{{home.weakCount}}</text><text>待巩固</text></view>
    </view>
    <view class="today-card">
      <view><text class="card-title">当前词书</text><text>{{home.groupName}}</text><text class="muted">完整词库 {{home.total}} 词，体验包 {{home.miniProgramTotal}} 词</text></view>
      <view><text class="card-title">连续学习</text><text>{{home.streakDays}} 天</text><text class="muted">{{home.streakText}}</text></view>
    </view>
    <view class="tab-bar">
      <view class="tab-item active" bindtap="openWordsTab">单词</view>
      <view class="tab-item" bindtap="openProfile">我的</view>
    </view>
  </view>

  <view wx:elif="{{view == 'profile'}}" class="view profile-view">
    <view class="topbar">
      <view>
        <text class="eyebrow">{{profile.userName}}</text>
        <text class="page-title">我的</text>
      </view>
      <view class="icon-button" bindtap="resetData">↺</view>
    </view>
    <view class="profile-hero">
      <view>
        <text class="section-label">当前词书</text>
        <text class="profile-book">{{profile.activeGroup}}</text>
        <text class="muted">完整词库 {{profile.total}} 词，体验包 {{profile.miniProgramTotal}} 词</text>
      </view>
      <view class="level-pill" bindtap="openLevelSelect">{{profile.levelLabel}}</view>
    </view>
    <view class="profile-grid">
      <view><text>{{profile.todayDone}}</text><text>今日已学</text></view>
      <view><text>{{profile.learnedCount}}</text><text>累计单词</text></view>
      <view><text>{{profile.todayMinutes}}</text><text>今日分钟</text></view>
      <view><text>{{profile.streakDays}}</text><text>连续天数</text></view>
    </view>
    <view class="profile-card action-card" hover-class="action-entry-pressed" bindtap="openMonthProgress">
      <view class="card-row"><text class="card-title">本周进展</text><text class="muted">累计打卡 {{profile.checkinDays}} 天</text><text class="entry-arrow">›</text></view>
      <view class="week-row">
        <view wx:for="{{profile.week}}" wx:key="key" class="week-dot {{item.active ? 'active' : ''}}">
          <text>{{item.day}}</text>
          <text>{{item.date}}</text>
        </view>
      </view>
      <text class="muted week-summary">最长连续 {{profile.longestStreak}} 天，打卡来自全部历史记录</text>
    </view>
    <view class="profile-list">
      <view class="list-button action-entry" hover-class="action-entry-pressed" bindtap="openLevelSelect"><text>选择单词水平</text><text>{{profile.startLevelLabel}}</text><text class="entry-arrow">›</text></view>
      <view class="list-button action-entry" hover-class="action-entry-pressed" bindtap="startTest"><text>词汇量测试</text><text>当前 {{profile.vocabulary}}</text><text class="entry-arrow">›</text></view>
      <view class="list-button action-entry" hover-class="action-entry-pressed" bindtap="openWrongBook"><text>错词本</text><text>{{profile.weakCount}} 个待巩固</text><text class="entry-arrow">›</text></view>
    </view>
    <view class="tab-bar">
      <view class="tab-item" bindtap="openWordsTab">单词</view>
      <view class="tab-item active" bindtap="openProfile">我的</view>
    </view>
  </view>

  <view wx:elif="{{view == 'month-progress'}}" class="view month-progress-view sticky-view">
    <view class="topbar compact"><view class="icon-button" bindtap="goBack">‹</view><text class="page-title">月度进展</text></view>
    <view class="month-panel">
      <picker mode="date" fields="month" value="{{monthProgress.pickerValue}}" bindchange="changeProgressMonth">
        <view class="month-picker">
          <text>{{monthProgress.title}}</text>
          <text>选择年月 ›</text>
        </view>
      </picker>
      <view class="month-switch">
        <view data-offset="-1" bindtap="shiftProgressMonth">上一月</view>
        <view>{{monthProgress.checkinDays}} 天打卡</view>
        <view data-offset="1" bindtap="shiftProgressMonth">下一月</view>
      </view>
      <view class="profile-grid month-summary">
        <view><text>{{monthProgress.checkinDays}}</text><text>打卡天数</text></view>
        <view><text>{{monthProgress.learnedWords}}</text><text>已学单词</text></view>
        <view><text>{{monthProgress.completedGroups}}</text><text>完成组数</text></view>
      </view>
      <view class="month-calendar">
        <text wx:for="{{monthProgress.weekdays}}" wx:key="*this" class="month-weekday">{{item}}</text>
        <view wx:for="{{monthProgress.cells}}" wx:key="key" class="month-day {{item.blank ? 'blank' : ''}} {{item.active ? 'active' : ''}}">
          <text wx:if="{{!item.blank}}">{{item.day}}</text>
          <text wx:if="{{item.active}}" class="month-day-meta">{{item.completedGroups}}组</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{view == 'level-select'}}" class="view level-view sticky-view">
    <view class="topbar compact"><view class="icon-button" bindtap="goBack">‹</view><text class="page-title">你现在是</text></view>
    <view class="level-panel">
      <text class="section-label">当前：{{levelSelect.currentLevel}}</text>
      <view wx:for="{{levelSelect.groups}}" wx:key="title" wx:for-item="group" class="level-group">
        <text class="level-title">{{group.title}}</text>
        <view class="level-options">
          <view wx:for="{{group.options}}" wx:key="id" wx:for-item="option" class="level-option" data-level-id="{{option.id}}" data-level-label="{{option.label}}" data-start-level="{{option.startLevel}}" bindtap="selectLevel">{{option.label}}</view>
        </view>
      </view>
      <view class="secondary-button" bindtap="skipLevelSelect">先跳过</view>
    </view>
  </view>

  <view wx:elif="{{view == 'test'}}" class="view sticky-view">
    <view class="topbar compact"><view class="icon-button" bindtap="goBack">‹</view><text class="progress-label">{{test.progress}}</text></view>
    <view class="question-panel">
      <text class="section-label">词汇量测试</text>
      <text class="test-word">{{test.question.word}}</text>
      <text class="muted">下面只选释义，不确定时点“不认识”</text>
      <view class="option-stack">
        <view wx:for="{{test.options}}" wx:key="*this" class="option-card test-option" hover-class="test-option-pressed" data-value="{{item}}" bindtap="answerTest">{{item}}</view>
      </view>
      <view class="secondary-button unknown-button" data-value="不认识" bindtap="answerTest">我不认识</view>
    </view>
    <view class="counter-bar"><text class="pill green">{{test.correct}}</text><text class="pill red">{{test.wrong}}</text><text class="pill blue">{{test.remain}}</text></view>
  </view>

  <view wx:elif="{{view == 'test-result'}}" class="view sticky-view">
    <view class="topbar compact"><view class="icon-button" bindtap="goBack">‹</view><text class="page-title">测评结果</text></view>
    <view class="result-panel">
      <text class="section-label">现实掌握词汇</text>
      <text class="vocab-number">{{testResult.vocabulary}}</text>
      <view class="copy-card"><text class="card-title">{{testResult.stage}}</text><text>{{testResult.calibrationText}}</text><text>正确率 {{testResult.accuracy}}%，不认识 {{testResult.unknown}} 个，误选 {{testResult.wrongChoice}} 个。{{testResult.advice}}</text></view>
      <view class="copy-card"><text class="card-title">分层表现</text><text>{{testResult.layerSummary}}</text></view>
      <view class="primary-button" bindtap="goHome">返回首页</view>
    </view>
  </view>

  <view wx:elif="{{view == 'precheck'}}" class="view precheck-view">
    <view class="topbar compact"><view class="icon-button" bindtap="goBack">‹</view><text class="page-title">训前检测</text></view>
    <scroll-view class="precheck-scroll" scroll-y="true" enhanced="true" show-scrollbar="{{false}}">
      <view class="word-list precheck-list">
        <view wx:for="{{precheck.candidates}}" wx:key="id" class="precheck-row {{item.selected ? 'picked' : ''}}">
          <view class="precheck-head">
            <text class="index">{{item.index}}</text>
            <view class="precheck-main">
              <view class="word-link" data-word-id="{{item.id}}" bindtap="openDetail">{{item.word}}</view>
              <text class="meaning-inline precheck-meaning"><text>{{item.pos}}</text>{{item.meaningText}}</text>
            </view>
          </view>
          <view class="segmented">
            <view class="segmented-button known {{item.status == 'known' ? 'selected' : ''}}" data-word-id="{{item.id}}" data-value="known" bindtap="markPrecheck">认识</view>
            <view class="segmented-button unfamiliar {{item.status == 'unfamiliar' ? 'selected danger' : ''}}" data-word-id="{{item.id}}" data-value="unfamiliar" bindtap="markPrecheck">不熟</view>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="bottom-actions precheck-actions">
      <text class="selection-count">已选 {{precheck.selectedCount}}/3</text>
      <view class="secondary-button" bindtap="autoSelect">自动选词</view>
      <view wx:if="{{precheck.canStart}}" class="primary-button small" bindtap="confirmPrecheck">开始识记</view>
      <view wx:else class="primary-button small disabled">开始识记</view>
    </view>
    <view wx:if="{{precheckNotice}}" class="transition-mask notice-mask">
      <view class="transition-card"><text>{{precheckNotice}}</text></view>
    </view>
  </view>

  <view wx:elif="{{view == 'word-study'}}" class="view study-view">
    <view class="topbar compact"><view class="icon-button" bindtap="goBack">‹</view><text class="progress-label">{{study.progress}}</text></view>
    <view wx:if="{{study.word}}" class="study-focus-card">
      <text class="section-label">单词识记</text>
      <text class="study-word">{{study.word.syllables}}</text>
      <text class="ipa">{{study.word.ipa}}</text>
      <text class="meaning"><text>{{study.word.pos}}</text>{{study.word.meaningText}}</text>
      <view class="study-tool-row">
        <view class="tool-button {{studyImageMode ? 'active' : ''}}" bindtap="toggleStudyImageMode">{{studyImageMode ? '收起图片' : '图片'}}</view>
        <view class="tool-button" data-word-id="{{study.word.id}}" bindtap="openDetail">搭配</view>
        <view class="tool-button primary" data-word-id="{{study.word.id}}" bindtap="speak">播放</view>
      </view>
      <view wx:if="{{studyImageMode}}" class="memory-image study-memory-image"><text class="memory-mark">记忆图</text><text class="strong">{{study.word.memoryMeaning}}</text><text>{{study.word.scene}}</text></view>
    </view>
    <view wx:if="{{study.word}}" class="bottom-actions two"><view class="secondary-button" data-value="1" bindtap="markStudy">还不熟</view><view class="primary-button small" data-value="3" bindtap="markStudy">已记住</view></view>
    <view wx:if="{{studyTransition}}" class="transition-mask">
      <view class="transition-card"><text>本组识记已完成，自动进入下一组</text></view>
    </view>
  </view>

  <view wx:elif="{{view == 'group-review'}}" class="view">
    <view class="topbar compact"><view class="icon-button" bindtap="goBack">‹</view><text class="page-title">{{review.isMixed ? '混组复习' : '本组复习'}}</text><text class="progress-label">{{review.progress}}</text></view>
    <view wx:if="{{!review.isMixed}}" class="review-stack">
      <view wx:if="{{review.word}}" class="audio-panel audio-minimal visual-question">
        <text class="test-word">{{review.word.word}}</text>
        <text class="ipa">{{review.word.ipa}}</text>
        <view class="option-stack">
          <view wx:for="{{review.question.options}}" wx:key="value" class="option-card {{item.statusClass}}" data-value="{{item.value}}" bindtap="answerGroupReview"><text><text class="option-pos">{{item.pos}}</text>{{item.first}}</text><text wx:if="{{item.rest}}" class="option-sub">{{item.rest}}</text></view>
        </view>
        <view class="audio-tools"><view data-word-id="{{review.word.id}}" bindtap="openDetail">看词卡</view><view data-word-id="{{review.word.id}}" bindtap="speak">播放</view></view>
        <view class="bottom-actions status-actions"><text>{{review.question.answered ? (review.question.isCorrect ? '回答正确' : '已加入本轮错词') : '本组看词辨义'}}</text><view wx:if="{{review.question.answered}}" class="primary-button small" bindtap="nextGroupReview">继续</view><view wx:else class="primary-button small disabled">继续</view></view>
      </view>
    </view>
    <view wx:else class="audio-panel audio-minimal">
      <text class="test-word">{{review.word.word}}</text>
      <text class="ipa">{{review.word.ipa}}</text>
      <view class="option-stack">
        <view wx:for="{{review.question.options}}" wx:key="value" class="option-card {{item.statusClass}}" data-value="{{item.value}}" bindtap="answerMixed"><text><text class="option-pos">{{item.pos}}</text>{{item.first}}</text><text wx:if="{{item.rest}}" class="option-sub">{{item.rest}}</text></view>
      </view>
      <view class="audio-tools"><view data-word-id="{{review.word.id}}" bindtap="openDetail">看词卡</view><view data-word-id="{{review.word.id}}" bindtap="speak">重播</view></view>
      <view class="bottom-actions status-actions"><text>{{review.question.answered ? (review.question.isCorrect ? '混组回答正确' : '混组已加入错词') : '混组看词辨义'}}</text><view wx:if="{{review.question.answered}}" class="primary-button small" bindtap="nextMixed">继续</view><view wx:else class="primary-button small disabled">继续</view></view>
    </view>
  </view>

  <view wx:elif="{{view == 'audio-meaning'}}" class="view audio-view">
    <view class="topbar compact"><view class="icon-button" bindtap="goBack">‹</view><text class="progress-label">{{audio.progress}}</text></view>
    <view class="audio-panel audio-minimal">
      <view class="speaker-tile" data-word-id="{{audio.word.id}}" bindtap="speak">播放</view>
      <view class="option-stack">
        <view wx:for="{{audio.question.options}}" wx:key="value" class="option-card {{item.statusClass}}" data-value="{{item.value}}" bindtap="answerAudio"><text><text class="option-pos">{{item.pos}}</text>{{item.first}}</text><text wx:if="{{item.rest}}" class="option-sub">{{item.rest}}</text></view>
      </view>
      <view class="audio-tools"><view data-word-id="{{audio.word.id}}" bindtap="openDetail">看词卡</view><view data-word-id="{{audio.word.id}}" bindtap="speak">重播</view></view>
    </view>
    <view class="bottom-actions status-actions"><text>{{audio.question.answered ? (audio.question.isCorrect ? '回答正确' : '已加入错词') : '听音辨义'}}</text><view wx:if="{{audio.question.answered}}" class="primary-button small" bindtap="nextAudio">继续</view><view wx:else class="primary-button small disabled">继续</view></view>
    <view wx:if="{{audioCompletionNotice}}" class="transition-mask">
      <view class="transition-card"><text>{{audioCompletionNotice}}</text><text wx:if="{{audioCompletionHint}}">{{audioCompletionHint}}</text></view>
    </view>
  </view>

  <view wx:elif="{{view == 'wrong-book'}}" class="view sticky-view">
    <view class="topbar compact"><view class="icon-button" bindtap="goBack">‹</view><text class="page-title">错词本</text></view>
    <view class="review-summary"><text>{{wrongBook.count}} 个词</text><text>优先复盘听音辨义和混组复习里的错词</text></view>
    <view class="review-stack">
      <view wx:for="{{wrongBook.words}}" wx:key="id" class="review-card detail-entry" hover-class="review-card-pressed" data-word-id="{{item.id}}" bindtap="openDetail"><view class="review-copy"><text class="card-title">{{item.word}}</text><text>{{item.ipa}}</text><text class="muted">{{item.meaningText}} · 错 {{item.wrongCount}} 次</text></view><view class="sound-mini" data-word-id="{{item.id}}" catchtap="speak">播放</view></view>
      <view wx:if="{{!wrongBook.count}}" class="empty-state"><text>当前没有错词。</text><view class="primary-button" bindtap="startDailyLearning">开始今日学习</view></view>
    </view>
  </view>

  <view wx:elif="{{view == 'daily-report'}}" class="view sticky-view">
    <view class="topbar compact"><view class="icon-button" bindtap="goBack">‹</view><text class="page-title">学习报告</text></view>
    <view class="report-panel">
      <text class="report-ring">{{report.accuracy}}%</text>
      <text class="section-label">发音辨义正确率</text>
      <view class="stats-grid"><view class="metric"><text>{{report.learnedCount}}</text><text>本组学习</text></view><view class="metric"><text>{{report.mixedReviewCount}}</text><text>混组复习</text></view><view class="metric"><text>{{report.audioCount}}</text><text>听音题</text></view></view>
      <view class="copy-card"><text class="card-title">下次复习</text><text>{{report.nextReview}} 优先复盘错词和即将遗忘词。</text></view>
      <view class="copy-card"><text class="card-title">薄弱词</text><text>{{report.weakWordText}}</text></view>
      <view class="copy-card"><text class="card-title">建议</text><text>{{report.summary}}</text></view>
      <view class="primary-button" bindtap="goHome">完成</view>
    </view>
  </view>

  <view wx:if="{{detail}}" class="modal-mask" bindtap="closeDetail">
    <view class="detail-card" catchtap="noop">
      <view class="icon-button close" bindtap="closeDetail">×</view>
      <text class="section-label">详细词卡</text>
      <text class="detail-word">{{detail.syllables}}</text>
      <text class="ipa">{{detail.ipa}}</text>
      <text class="meaning"><text>{{detail.pos}}</text>{{detail.meaningText}}</text>
      <view class="memory-image"><text class="strong">{{detail.memoryImage.meaning}}</text><text>{{detail.memoryImage.scene}}</text></view>
      <view class="copy-card"><text class="card-title">来源</text><text>{{detail.curriculumStage}} · 课标序号 {{detail.sourceIndex}}</text></view>
      <view class="copy-card"><text class="card-title">词组搭配</text><text>{{detail.collocationText}}</text></view>
    </view>
  </view>
</view>
