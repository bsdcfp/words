<view class="app-shell {{themeClass}}">
  <view wx:if="{{view == 'home'}}" class="view home-view {{home.hasSelectedLevel ? '' : 'first-run-home'}}">
    <view wx:if="{{bootError}}" class="boot-error-card">
      <text class="card-title">启动时遇到问题</text>
      <text class="muted">{{bootError}}</text>
      <view class="secondary-button" bindtap="resetData">重置体验数据</view>
    </view>
    <view wx:if="{{home.hasSelectedLevel}}" class="home-topline">
      <view class="home-book-select" bindtap="openLevelSelect" hover-class="home-link-pressed">
        <view class="book-cover-mini"><image class="home-icon book-cover-image" src="../../assets/v2/icons/shared-icon-open-book@3x.png" mode="aspectFit" /></view>
        <text>{{home.bookTitle}}</text>
        <view class="ui-icon icon-chevron"></view>
      </view>
      <view class="home-streak"><view class="streak-dot"></view><text>连续 {{home.streakDays}} 天</text></view>
    </view>
    <view wx:else class="home-welcome-panel">
      <text class="home-welcome-title">欢迎！</text>
      <text class="home-welcome-subtitle">先选择你的学习水平</text>
      <view class="home-welcome-mark"></view>
    </view>
    <image wx:if="{{!home.hasSelectedLevel}}" class="asset-desk-scene light-desk-scene" src="../../assets/v2/illustrations/shared-illustration-study-desk-light@3x.png" mode="aspectFit" />
    <view wx:if="{{home.hasSelectedLevel}}" class="home-main-card home-normal-card">
      <view class="home-card-section">
        <view class="goal-row">
          <view class="goal-left">
            <view class="section-title-row"><image class="home-icon section-icon" src="../../assets/v2/illustrations/shared-illustration-list-flag@3x.png" mode="aspectFit" /><text class="section-label">今日目标</text></view>
            <view class="target-line"><text class="target-number">{{home.planCount}}</text><text class="target-unit">个 List</text></view>
          </view>
          <view class="goal-flags">
            <image wx:for="{{home.planFlags}}" wx:key="*this" class="home-icon home-flag-image icon-flag {{item}}" src="{{item == 'done' ? '../../assets/icons/flag-done.svg' : '../../assets/icons/flag-todo.svg'}}" mode="aspectFit" />
          </view>
        </view>
      </view>
      <view class="home-divider"></view>
      <view class="home-card-section progress-section">
        <text class="section-label">单词书进度</text>
        <view class="home-progress-body">
          <view class="home-progress-copy">
            <view class="progress-number-row"><text class="progress-large">{{home.learnedCount}}</text><text>/ {{home.displayTotal}}</text><text>{{home.progressPercent}}%</text></view>
            <view class="progress-track"><view style="width: {{home.progressPercent}}%;"></view></view>
          </view>
          <image class="home-progress-art" src="../../assets/v2/illustrations/light-illustration-vocabulary-book@3x.png" mode="aspectFit" />
        </view>
      </view>
    </view>
    <view wx:else class="home-main-card first-run-panel">
      <view class="section-title-row">
        <image class="home-icon section-icon" src="../../assets/v2/icons/shared-icon-open-book@3x.png" mode="aspectFit" />
        <text class="section-label">单词书进度</text>
      </view>
      <text class="first-run-book-name">{{home.bookTitle}}</text>
      <view class="progress-number-row first-run-progress-row">
        <text class="progress-large">0</text>
        <text>/ {{home.displayTotal}}</text>
        <text>0%</text>
      </view>
      <view class="progress-track"><view style="width: 0%;"></view></view>
    </view>
    <view class="primary-button home-continue {{home.hasSelectedLevel ? '' : 'first-run-cta'}}" bindtap="startDailyLearning" hover-class="home-cta-pressed"><text>{{home.primaryActionText}}</text><view wx:if="{{!home.hasSelectedLevel}}" class="ui-icon icon-chevron cta-chevron"></view></view>
    <view wx:if="{{!home.hasSelectedLevel}}" class="home-first-note" bindtap="openProfile"><text>选择后可随时在【我的】中更改</text></view>
    <view wx:if="{{home.hasSelectedLevel}}" class="home-action-card" bindtap="openWrongBook" hover-class="action-entry-pressed">
      <image class="home-icon card-icon card-icon-image" src="../../assets/v2/icons/shared-icon-wrong-words@3x.png" mode="aspectFit" />
      <text class="home-action-title">{{home.weakCount}} 个错词待复习</text>
      <text class="home-action-subtitle">晚间入口已开启</text>
      <view class="entry-arrow ui-icon icon-chevron"></view>
    </view>
    <image class="asset-landscape light-landscape" src="../../assets/v2/backgrounds/light-bg-landscape-strip@3x.png" mode="aspectFill" />
  </view>

  <view wx:elif="{{view == 'profile'}}" class="view profile-view">
    <view class="profile-book-card action-card" hover-class="action-entry-pressed" bindtap="openLevelSelect">
      <image class="profile-book-image" src="../../assets/v2/illustrations/light-illustration-vocabulary-book@3x.png" mode="aspectFit" />
      <view class="profile-book-main">
        <view class="profile-book-titlerow">
          <text class="profile-book-title">{{profile.bookTitle}}</text>
          <view class="entry-arrow ui-icon icon-chevron"></view>
        </view>
        <view class="profile-book-progressrow">
          <text class="profile-book-learned">{{profile.learnedCount}}</text>
          <text class="profile-book-total"> / {{profile.displayTotal}}</text>
          <text class="profile-book-percent">{{profile.progressPercent}}%</text>
        </view>
        <view class="profile-progress-track"><view class="profile-progress-fill" style="width: {{profile.progressPercent}}%"></view></view>
        <text class="profile-book-hint">点击切换单词书或学习水平</text>
      </view>
    </view>

    <view class="profile-card data-card">
      <text class="section-heading">学习数据</text>
      <view class="stat-trio">
        <view class="stat-trio-cell"><text class="stat-trio-value">{{profile.todayDone}}</text><text class="stat-trio-label">今日学习</text></view>
        <view class="stat-trio-divider"></view>
        <view class="stat-trio-cell"><text class="stat-trio-value">{{profile.learnedCount}}</text><text class="stat-trio-label">累计学习</text></view>
        <view class="stat-trio-divider"></view>
        <view class="stat-trio-cell"><text class="stat-trio-value">{{profile.streakDays}}</text><text class="stat-trio-label">连续打卡</text></view>
      </view>
      <view class="cal-week-row" hover-class="action-entry-pressed" bindtap="openMonthProgress">
        <view wx:for="{{profile.week}}" wx:key="key" class="cal-col">
          <text class="cal-weekday">{{item.day}}</text>
          <view class="cal-date {{item.isToday ? 'today' : ''}}"><text>{{item.date}}</text></view>
          <view class="cal-mark {{item.active ? 'on' : ''}}"></view>
        </view>
      </view>
      <view class="wrong-review-row action-entry" hover-class="action-entry-pressed" bindtap="openWrongBook">
        <image class="asset-row-icon" src="../../assets/v2/icons/shared-icon-wrong-words@3x.png" mode="aspectFit" />
        <text class="wrong-review-text">{{profile.weakCount}} 个错词待复习</text>
        <view class="entry-arrow ui-icon icon-chevron"></view>
      </view>
    </view>

    <view class="profile-section">
      <view class="test-section-head">
        <text class="section-heading">测评</text>
        <text class="test-hint">入学测：初始水平检测</text>
        <text class="test-hint">阶段测：已学词检测</text>
      </view>
      <view class="profile-test-grid">
        <view class="profile-test-entry action-entry" hover-class="action-entry-pressed" bindtap="startTest"><image class="asset-row-icon" src="../../assets/v2/illustrations/shared-illustration-assessment-paper@3x.png" mode="aspectFit" /><text class="entry-title">入学测</text><text class="entry-meta">36 题</text><view class="entry-arrow ui-icon icon-chevron"></view></view>
        <view class="profile-test-entry action-entry" hover-class="action-entry-pressed" bindtap="startStageTest"><image class="asset-row-icon" src="../../assets/v2/illustrations/shared-illustration-focus-badge@3x.png" mode="aspectFit" /><text class="entry-title">阶段测</text><text class="entry-meta">{{profile.stageTestCount}} 题</text><view class="entry-arrow ui-icon icon-chevron"></view></view>
      </view>
    </view>

    <view class="profile-section">
      <text class="section-heading">学习设置</text>
      <view class="settings-list">
        <picker class="setting-row" mode="selector" range="{{profile.dailyTargetRange}}" value="{{profile.dailyTargetIndex}}" bindchange="setListGroupCount">
          <view class="setting-row-inner"><view class="ui-icon setting-icon icon-target"></view><text class="setting-label">每日目标</text><text class="setting-value">{{profile.dailyTargetLabel}}</text><view class="entry-arrow ui-icon icon-chevron"></view></view>
        </picker>
        <picker class="setting-row" mode="selector" range="{{profile.loopRange}}" value="{{profile.loopIndex}}" bindchange="setPronunciationLoopCount">
          <view class="setting-row-inner"><view class="ui-icon setting-icon icon-loop"></view><text class="setting-label">播放循环</text><text class="setting-value">{{profile.pronunciationLoopLabel}}</text><view class="entry-arrow ui-icon icon-chevron"></view></view>
        </picker>
        <view class="setting-row">
          <view class="setting-row-inner"><view class="ui-icon setting-icon icon-moon"></view><text class="setting-label">睡眠 / 起床时间</text>
            <view class="setting-value setting-time-pair">
              <picker mode="time" value="{{profile.sleepTime}}" bindchange="changeSleepTime"><text>{{profile.sleepTime}}</text></picker>
              <text class="setting-time-sep"> / </text>
              <picker mode="time" value="{{profile.wakeTime}}" bindchange="changeWakeTime"><text>{{profile.wakeTime}}</text></picker>
            </view>
            <view class="entry-arrow ui-icon icon-chevron"></view>
          </view>
        </view>
        <picker class="setting-row" mode="time" value="{{profile.wrongReminderTime}}" bindchange="changeWrongReminderTime">
          <view class="setting-row-inner"><view class="ui-icon setting-icon icon-bell"></view><text class="setting-label">错词提醒</text><text class="setting-value">{{profile.wrongReminderLabel}}</text><view class="entry-arrow ui-icon icon-chevron"></view></view>
        </picker>
        <view class="setting-row" hover-class="action-entry-pressed" bindtap="confirmReset">
          <view class="setting-row-inner"><view class="ui-icon setting-icon icon-reset"></view><text class="setting-label">数据重置</text><text class="setting-value"></text><view class="entry-arrow ui-icon icon-chevron"></view></view>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{view == 'month-progress'}}" class="view month-progress-view sticky-view">
    <view class="topbar">
      <view class="icon-button" bindtap="goBack"><view class="ui-icon icon-back"></view></view>
      <text class="page-title">学习进展</text>
      <view class="profile-toolbar-spacer"></view>
    </view>
    <view class="month-switcher">
      <view class="month-nav" hover-class="action-entry-pressed" data-offset="-1" bindtap="shiftProgressMonth"><view class="ui-icon icon-back"></view></view>
      <picker mode="date" fields="month" value="{{monthProgress.pickerValue}}" bindchange="changeProgressMonth">
        <view class="month-switcher-title"><text>{{monthProgress.title}}</text><view class="ui-icon icon-caret-down"></view></view>
      </picker>
      <view class="month-nav" hover-class="action-entry-pressed" data-offset="1" bindtap="shiftProgressMonth"><view class="ui-icon icon-chevron"></view></view>
    </view>

    <view class="month-panel month-cal-panel">
      <view class="month-calendar">
        <text wx:for="{{monthProgress.weekdays}}" wx:key="*this" class="month-weekday">{{item}}</text>
        <view wx:for="{{monthProgress.cells}}" wx:key="key" class="month-day {{item.otherMonth ? 'other' : ''}} {{item.active ? 'active' : ''}} {{item.isToday ? 'today' : ''}}">
          <text>{{item.day}}</text>
        </view>
      </view>
      <view class="month-legend">
        <view class="legend-item"><view class="legend-dot done"></view><text>已学完</text></view>
        <view class="legend-item"><view class="legend-dot todo"></view><text>未学完</text></view>
      </view>
      <image class="month-leaf" src="../../assets/icons/leaf-sprig.svg" mode="aspectFit" />
    </view>

    <view class="month-panel month-trend-panel">
      <text class="trend-head">本月已学单词</text>
      <view class="trend-amount"><text class="trend-amount-num">{{monthProgress.learnedWords}}</text><text class="trend-amount-unit"> 词</text></view>
      <view class="trend-chart" style="width: {{monthProgress.trend.width}}rpx; height: {{monthProgress.trend.height}}rpx;">
        <view wx:for="{{monthProgress.trend.segments}}" wx:key="key" class="trend-seg" style="left: {{item.x}}rpx; top: {{item.y}}rpx; width: {{item.width}}rpx; transform: rotate({{item.angle}}deg);"></view>
        <view wx:for="{{monthProgress.trend.points}}" wx:key="key" class="trend-pt" style="left: {{item.x}}rpx; top: {{item.y}}rpx;"><text class="trend-val">{{item.value}}</text></view>
      </view>
      <view class="trend-axis" style="padding: 0 {{monthProgress.trend.padX}}rpx;">
        <text wx:for="{{monthProgress.trend.points}}" wx:key="key">{{item.label}}</text>
      </view>
      <text class="trend-caption">每周一~周日为一周 · 单词数包含新学 + 复习</text>
    </view>

    <view class="month-panel stage-test-panel">
      <view class="stage-test-copy"><image class="asset-row-icon large" src="../../assets/v2/illustrations/shared-illustration-assessment-paper@3x.png" mode="aspectFit" /><view><text class="card-title">阶段测</text><text class="vocab-number compact">{{monthProgress.stageTestCount}}</text><text class="muted">从已学词中抽题检验掌握度</text></view></view>
      <view class="stage-skill-row"><text>看词辨义</text><text>听音辨义</text><text>中文回忆英文</text></view>
      <view class="primary-button" bindtap="startStageTest">开始阶段测</view>
      <text class="muted stage-note">阶段测不会打断日常学习进度，也不改变你的水平</text>
    </view>
  </view>

  <view wx:elif="{{view == 'level-select'}}" class="view level-view sticky-view">
    <view class="level-skip text-link" bindtap="skipLevelSelect">跳过</view>
    <view class="level-heading">
      <text class="level-main-title">你现在是</text>
      <text class="level-subtitle">选择一个适合的起点</text>
    </view>
    <view class="level-options single">
      <view wx:for="{{levelSelect.options}}" wx:key="id" wx:for-item="option" class="level-option {{option.enabled ? 'enabled' : 'disabled'}} {{option.selected ? 'selected' : ''}}" hover-class="{{option.enabled ? 'level-option-pressed' : 'none'}}" data-level-id="{{option.id}}" data-level-label="{{option.label}}" data-start-level="{{option.startLevel}}" data-enabled="{{option.enabled}}" bindtap="selectLevel">
        <image class="level-icon" src="{{option.iconSrc}}" mode="aspectFit" />
        <text class="level-option-label">{{option.label}}</text>
        <view wx:if="{{option.selected}}" class="level-check"><view class="ui-icon icon-check"></view></view>
      </view>
    </view>
    <view class="level-test-link" bindtap="takeLevelTest"><text>不确定？做个测试</text><view class="ui-icon icon-chevron"></view></view>
    <image class="asset-landscape level-landscape" src="../../assets/v2/backgrounds/light-bg-landscape-strip@3x.png" mode="aspectFill" />
  </view>

  <view wx:elif="{{view == 'test'}}" class="view sticky-view test-view">
    <view class="assess-topbar">
      <view class="icon-button compact assess-back" bindtap="goBack"><view class="ui-icon icon-back"></view></view>
      <view class="assess-count"><text class="assess-progress-current">{{test.current}}</text><text class="assess-progress-total"> / {{test.total}}</text></view>
    </view>
    <view class="assess-progress-track"><view class="assess-progress-fill" style="width: {{test.percent}}%"></view></view>
    <text class="assess-kind">{{test.kindLabel}}</text>
    <text class="assess-prompt">请选择最符合的中文释义</text>
    <text class="assess-word">{{test.question.word}}</text>
    <text wx:if="{{test.question.ipa}}" class="assess-ipa">{{test.question.ipa}}</text>
    <view class="assess-stack">
      <view wx:for="{{test.options}}" wx:key="value" class="assess-option" hover-class="assess-option-pressed" data-value="{{item.value}}" bindtap="answerTest">
        <view class="assess-letter">{{item.label}}</view>
        <text class="assess-text">{{item.text}}</text>
      </view>
      <view class="assess-option assess-unknown" hover-class="assess-option-pressed" data-value="不认识" bindtap="answerTest">
        <text class="assess-text">不认识</text>
      </view>
    </view>
  </view>

  <view wx:elif="{{view == 'test-result'}}" class="view sticky-view test-result-view">
    <view class="result-hero">
      <image class="result-confetti" src="../../assets/v2/effects/shared-effect-laurel-confetti@3x.png" mode="aspectFit" />
      <image class="result-book-check" src="../../assets/v2/illustrations/shared-illustration-assessment-book-check@3x.png" mode="aspectFit" />
    </view>
    <text class="result-title">{{testResult.isStage ? '阶段测完成！' : '测评完成！'}}</text>
    <view wx:if="{{testResult.isStage}}" class="result-panel">
      <text class="result-cap">已学词检测正确率</text>
      <text class="result-range">{{testResult.accuracy}}%</text>
      <view class="result-divider"></view>
      <text class="result-note">答对 {{testResult.correct}} / {{testResult.total}} 题（不改变你的学习水平）</text>
      <view class="result-encourage-card">
        <view class="result-spark">✦</view>
        <text class="result-encourage-text">{{testResult.encouragement}}</text>
      </view>
    </view>
    <view wx:else class="result-panel">
      <text class="result-cap">你的词汇量范围约为</text>
      <text class="result-range">{{testResult.vocabulary}}</text>
      <view class="result-divider"></view>
      <text class="result-note">初测估计，后续会结合真实学习表现校准</text>
      <view class="result-advice-card">
        <view class="result-advice-icon"><image src="../../assets/v2/icons/shared-icon-open-book@3x.png" mode="aspectFit" /></view>
        <view class="result-advice-copy">
          <text class="result-advice-label">建议</text>
          <text class="result-advice-text">建议从<text class="result-advice-hl">{{testResult.startLevelLabel}}</text>开始</text>
        </view>
      </view>
      <view class="result-encourage-card">
        <view class="result-spark">✦</view>
        <text class="result-encourage-text">{{testResult.encouragement}}</text>
      </view>
    </view>
    <view wx:if="{{testResult.isStage}}" class="primary-button result-start" bindtap="openProfile" hover-class="home-cta-pressed">完成</view>
    <view wx:else class="primary-button result-start" bindtap="startDailyLearning" hover-class="home-cta-pressed">开始学习</view>
    <view wx:if="{{!testResult.isStage}}" class="result-relevel" bindtap="openLevelSelect"><text>重新选择水平</text><view class="ui-icon icon-chevron"></view></view>
    <image class="asset-landscape level-landscape" src="../../assets/v2/backgrounds/light-bg-landscape-strip@3x.png" mode="aspectFill" />
  </view>

  <view wx:elif="{{view == 'precheck'}}" class="view precheck-view">
    <view class="precheck-title-row"><image class="precheck-leaf" src="../../assets/icons/leaf-sprig.svg" mode="aspectFit" /><text class="precheck-title">训前检测</text><image class="precheck-leaf right" src="../../assets/icons/leaf-sprig.svg" mode="aspectFit" /></view>
    <image class="precheck-ripple precheck-ripple-top" src="../../assets/v2/effects/precheck-scan-bars-top@3x.png" mode="aspectFit" />
    <view class="precheck-deck">
      <block wx:for="{{precheck.candidates}}" wx:key="id" wx:for-index="idx">
        <view
          wx:if="{{idx == 0}}"
          class="precheck-stage-card {{precheckSwipeClass}}"
          data-word-id="{{item.id}}"
          catchtouchstart="handlePrecheckTouchStart"
          catchtouchmove="handlePrecheckTouchMove"
          catchtouchend="handlePrecheckTouchEnd"
          catchtouchcancel="handlePrecheckTouchCancel"
        >
          <text class="precheck-word">{{item.word}}</text>
          <view class="precheck-audio-dot" data-word-id="{{item.id}}" catchtap="speak"><image class="precheck-speaker-img" src="../../assets/v2/icons/precheck-speaker-round@3x.png" mode="aspectFit" /></view>
          <view class="precheck-hints">
            <view class="precheck-hint known" data-word-id="{{item.id}}" data-value="known" bindtap="markPrecheck">
              <image class="precheck-arrow-img arrow-up" src="../../assets/v2/effects/precheck-arrow-up@3x.png" mode="aspectFit" />
              <text class="precheck-hint-sub">认识</text>
            </view>
            <view class="precheck-hint-divider"></view>
            <view class="precheck-hint unfamiliar" data-word-id="{{item.id}}" data-value="unfamiliar" bindtap="markPrecheck">
              <image class="precheck-arrow-img arrow-down" src="../../assets/v2/effects/precheck-arrow-down@3x.png" mode="aspectFit" />
              <text class="precheck-hint-sub">不熟</text>
            </view>
          </view>
        </view>
      </block>
    </view>
    <image class="precheck-ripple precheck-ripple-bottom" src="../../assets/v2/effects/precheck-scan-bars-bottom@3x.png" mode="aspectFit" />
    <view class="precheck-bottom-status">
      <view class="precheck-status-left"><text class="precheck-status-label">已筛出</text><text class="precheck-status-num">{{precheck.selectedCount}}</text><text class="precheck-status-total">/ {{precheck.targetCount}}</text></view>
      <view class="precheck-status-right"><text class="precheck-status-sub">今日待学</text><image class="precheck-status-book" src="../../assets/v2/illustrations/precheck-today-book-stack@3x.png" mode="aspectFit" /></view>
    </view>
    <image class="asset-landscape precheck-landscape" src="../../assets/v2/backgrounds/light-bg-landscape-strip@3x.png" mode="aspectFill" />
    <view wx:if="{{precheckNotice}}" class="transition-mask notice-mask">
      <view class="transition-card"><text>{{precheckNotice}}</text></view>
    </view>
  </view>

  <view wx:elif="{{view == 'word-study'}}" class="view study-view learning-view focus-flow {{study.themeClass}} {{focusEdgeFeedback ? 'edge-wrong' : ''}}" bindtap="handleLearningSurfaceTap">
    <view class="focus-pause-handle" catchlongpress="openPausePanel"><text>Ⅱ</text><text>长按侧边暂停</text></view>
    <view class="focus-progress" catchtap="noop"><view wx:for="{{study.progressDots}}" wx:key="key" class="focus-dot {{item.className}}"></view></view>
    <view wx:if="{{study.word}}" class="focus-card study-focus-card spec-study-card">
      <text class="study-word">{{study.word.syllables}}</text>
      <text class="ipa">{{study.word.ipa}}</text>
      <view class="sound-orb small read-pulse {{readAlongStatus ? 'active' : ''}}" data-word-id="{{study.word.id}}" catchtap="speak"><image class="asset-sound-icon" src="../../assets/v2/icons/shared-icon-sound-wave-round@3x.png" mode="aspectFit" /></view>
      <text class="meaning"><text>{{study.word.pos}}</text>{{study.word.meaningText}}</text>
      <text class="study-hint">轻点再听</text>
    </view>
    <image class="asset-landscape focus-landscape" src="../../assets/v2/backgrounds/light-bg-landscape-strip@3x.png" mode="aspectFill" />
    <view wx:if="{{study.word}}" class="focus-actions"><view class="primary-button focus-primary" data-value="3" catchtap="markStudy">记住了</view></view>
  </view>

  <view wx:elif="{{view == 'group-review'}}" class="view learn-spread learning-view focus-flow {{review.themeClass}} {{focusEdgeFeedback ? 'edge-wrong' : ''}}" bindtap="handleLearningSurfaceTap">
    <view class="focus-pause-handle" catchlongpress="openPausePanel"><text>Ⅱ</text><text>长按侧边暂停</text></view>
    <view class="focus-progress" catchtap="noop"><view wx:for="{{review.progressDots}}" wx:key="key" class="focus-dot {{item.className}} {{review.isMixed ? 'mixed' : 'review'}}"></view></view>
    <view wx:if="{{review.word}}" class="focus-card review-focus-card">
      <text class="test-word">{{review.word.word}}</text>
      <text class="ipa">{{review.word.ipa}}</text>
      <view class="sound-orb small" data-word-id="{{review.word.id}}" catchtap="speak"><image class="asset-sound-icon" src="../../assets/v2/icons/shared-icon-sound-wave-round@3x.png" mode="aspectFit" /></view>
      <text wx:if="{{!(reviewAnswerVisible || review.question.answered)}}" class="study-hint">⏱ 2 秒后揭示</text>
    </view>
    <image class="asset-landscape learn-landscape-band" src="../../assets/v2/backgrounds/light-bg-landscape-strip@3x.png" mode="aspectFill" />
    <view wx:if="{{review.word && (reviewAnswerVisible || review.question.answered)}}" class="reveal-sheet revealed">
      <view class="reveal-sheet-meaning"><text class="option-line"><text class="option-pos">{{review.word.pos}}</text>{{review.word.meaningText}}</text></view>
    </view>
    <view class="focus-actions">
      <view wx:if="{{review.isMixed}}" class="primary-button focus-primary" catchtap="rememberMixedReview">记住了</view>
      <view wx:else class="primary-button focus-primary" catchtap="rememberGroupReview">记住了</view>
    </view>
  </view>

  <view wx:elif="{{view == 'audio-meaning'}}" class="view audio-view learn-spread learning-view focus-flow {{audio.themeClass}} {{focusEdgeFeedback ? 'edge-wrong' : ''}}" bindtap="handleLearningSurfaceTap">
    <view class="focus-pause-handle" catchlongpress="openPausePanel"><text>Ⅱ</text><text>长按侧边暂停</text></view>
    <view class="focus-progress" catchtap="noop"><view wx:for="{{audio.progressDots}}" wx:key="key" class="focus-dot {{item.className}} audio"></view></view>
    <view class="focus-card audio-focus-card">
      <view class="speaker-tile focus-speaker" data-word-id="{{audio.word.id}}" catchtap="speak"><image class="asset-listening-icon" src="../../assets/v2/icons/shared-icon-listening-play@3x.png" mode="aspectFit" /></view>
      <text class="audio-playing-text">正在播放…</text>
      <text class="study-hint">听录音，回忆中文释义</text>
    </view>
    <image class="asset-landscape learn-landscape-band" src="../../assets/v2/backgrounds/light-bg-landscape-strip@3x.png" mode="aspectFill" />
    <view wx:if="{{audioAnswerVisible || audio.question.answered}}" class="reveal-sheet revealed">
      <view class="reveal-sheet-meaning">
        <text class="option-line"><text class="option-pos">{{audio.word.pos}}</text>{{audio.word.meaningText}}</text>
      </view>
    </view>
    <view class="focus-actions"><view class="primary-button focus-primary" catchtap="rememberAudio">记住了</view></view>
    <view class="audio-bottom-hint"><view class="audio-hint-bulb"></view><text>提示将在 2 秒后显示</text></view>
  </view>

  <view wx:elif="{{view == 'meaning-recall'}}" class="view audio-view learning-view focus-flow {{recall.themeClass}} {{focusEdgeFeedback ? 'edge-wrong' : ''}}" bindtap="handleLearningSurfaceTap">
    <view class="focus-topbar" catchtap="noop"><view class="icon-button focus-back" catchtap="goBack"><view class="ui-icon icon-back"></view></view><text>中文回忆英文</text></view>
    <view class="focus-pause-handle" catchlongpress="openPausePanel"><text>Ⅱ</text><text>长按侧边暂停</text></view>
    <view class="focus-progress" catchtap="noop"><view wx:for="{{recall.progressDots}}" wx:key="key" class="focus-dot {{item.className}} recall"></view></view>
    <view wx:if="{{recall.word}}" class="focus-card audio-panel audio-minimal meaning-recall-card">
      <view class="meaning-recall-prompt">
        <text class="option-line"><text class="option-pos">{{recall.word.pos}}</text>{{recall.word.meaningText}}</text>
      </view>
      <view class="meaning-word-reveal {{recallAnswerVisible ? 'visible' : ''}}">
        <text wx:if="{{recallAnswerVisible}}" class="test-word">{{recall.word.word}}</text>
        <text wx:else class="recall-placeholder">先在心里拼出英文</text>
      </view>
    </view>
    <view class="focus-actions"><view class="primary-button focus-primary" catchtap="rememberMeaningRecall">记住了</view></view>
  </view>

  <view wx:elif="{{view == 'wrong-book'}}" class="view sticky-view wrong-book-view">
    <view class="topbar compact wrongbook-topbar">
      <view class="icon-button" bindtap="goBack"><view class="ui-icon icon-back"></view></view>
      <text class="page-title">错词本</text>
      <view class="text-link wrongbook-edit" bindtap="toggleWrongBookEdit">{{wrongBookEditing ? '完成' : '编辑'}}</view>
    </view>
    <view class="wrongbook-summary">
      <view class="wrongbook-summary-top">
        <image class="wrongbook-icon" src="../../assets/v2/icons/shared-icon-wrong-words@3x.png" mode="aspectFit" />
        <view class="wrongbook-summary-copy">
          <text class="wrongbook-title">{{wrongBook.count}} 个错词待复习</text>
          <text class="wrongbook-subtitle">优先复习当前 List 的词</text>
        </view>
      </view>
      <view class="wrongbook-start" bindtap="startWrongReview" hover-class="home-cta-pressed">开始复习</view>
    </view>
    <view class="wrongbook-note"><image class="wrongbook-note-leaf" src="../../assets/icons/leaf-sprig.svg" mode="aspectFit" /><text>错词会随复习自动清除，不影响学习进度</text></view>
    <view class="review-stack wrongbook-list">
      <view wx:for="{{wrongBook.words}}" wx:key="id" class="wrongbook-row" hover-class="review-card-pressed" data-word-id="{{item.id}}" bindtap="openDetail">
        <text class="wrongbook-word">{{item.word}}</text>
        <text class="wrongbook-meaning"><text class="option-pos">{{item.pos}}</text>{{item.meaningText}}</text>
        <view wx:if="{{wrongBookEditing}}" class="wrongbook-pill remove" data-word-id="{{item.id}}" catchtap="removeWrongWord">移除</view>
        <view wx:elif="{{item.memorized}}" class="wrongbook-pill done">已记住</view>
        <view wx:else class="wrongbook-pill todo"><text>待复习</text><view class="ui-icon icon-chevron"></view></view>
      </view>
      <view wx:if="{{!wrongBook.count}}" class="empty-state"><text>当前没有错词。</text><view class="primary-button" bindtap="startDailyLearning">{{wrongBook.emptyActionText}}</view></view>
    </view>
    <view wx:if="{{wrongBook.count}}" class="wrongbook-foot">
      <view class="wrongbook-foot-icon"><image src="../../assets/icons/leaf-sprig.svg" mode="aspectFit" /></view>
      <view class="wrongbook-foot-copy">
        <text class="wrongbook-foot-title">坚持复习，记得更牢</text>
        <text class="wrongbook-foot-sub">复习时答对即「记住」，自动移出错词本</text>
      </view>
    </view>
  </view>

  <view wx:elif="{{view == 'daily-report'}}" class="view sticky-view celebration-view">
    <view class="celebrate-head">
      <image class="celebrate-confetti" src="../../assets/v2/effects/shared-effect-laurel-confetti@3x.png" mode="aspectFit" />
      <view class="celebrate-title-row">
        <image class="celebrate-check-inline" src="../../assets/v2/icons/shared-icon-completion-check@3x.png" mode="aspectFit" />
        <text class="celebrate-title">今日目标完成</text>
      </view>
      <text class="celebrate-subtitle">太棒了，今天的 List 都完成了</text>
      <view class="celebrate-underline"></view>
    </view>
    <view class="celebrate-stats">
      <view class="celebrate-stat">
        <view class="celebrate-stat-head"><image src="../../assets/icons/flag-done.svg" mode="aspectFit" /><text>今日学习</text></view>
        <view class="celebrate-stat-num"><text class="celebrate-num">{{report.todayLists}}</text><text class="celebrate-unit">List</text><text class="celebrate-num">{{report.doneWords}}</text><text class="celebrate-unit">词</text></view>
      </view>
      <view class="celebrate-stat">
        <view class="celebrate-stat-head"><image src="../../assets/v2/icons/shared-icon-open-book@3x.png" mode="aspectFit" /><text>累计学完</text></view>
        <view class="celebrate-stat-num"><text class="celebrate-num">{{report.totalLearned}}</text><text class="celebrate-unit">词</text></view>
      </view>
      <view class="celebrate-stat">
        <view class="celebrate-stat-head"><image src="../../assets/v2/illustrations/shared-illustration-monthly-calendar@3x.png" mode="aspectFit" /><text>学习时长</text></view>
        <view class="celebrate-stat-num"><text class="celebrate-num">{{report.doneHours}}</text><text class="celebrate-unit">小时</text></view>
      </view>
    </view>
    <view class="celebrate-book">
      <image class="celebrate-book-art" src="../../assets/v2/illustrations/vocabulary-book-hardcover@3x.png" mode="aspectFit" />
      <view class="celebrate-book-copy">
        <text class="celebrate-book-title">{{report.bookTitle}}</text>
        <view class="progress-number-row celebrate-progress-row"><text class="progress-large">{{report.totalLearned}}</text><text>/ {{report.displayTotal}}</text><text class="celebrate-percent">{{report.progressPercent}}%</text></view>
        <view class="progress-track"><view style="width: {{report.progressPercent}}%;"></view></view>
      </view>
    </view>
    <view class="celebrate-badge">
      <image class="celebrate-badge-art" src="../../assets/v2/illustrations/shared-illustration-focus-badge@3x.png" mode="aspectFit" />
      <view class="celebrate-badge-copy">
        <text class="celebrate-badge-label">获得徽章</text>
        <text class="celebrate-badge-name">{{report.badgeName}}</text>
        <view class="celebrate-points"><image src="../../assets/v2/icons/shared-icon-gold-star-token@3x.png" mode="aspectFit" /><text>+{{report.badgePoints}} 积分</text></view>
      </view>
    </view>
    <view class="celebrate-outline-cta" bindtap="goHome" hover-class="action-entry-pressed">已完成 {{report.doneWords}} 词、{{report.doneHours}} 小时</view>
    <view class="primary-button celebrate-filled-cta" bindtap="openWrongBook" hover-class="home-cta-pressed">错词复习</view>
    <view class="celebrate-hint"><image class="celebrate-hint-leaf" src="../../assets/icons/leaf-sprig.svg" mode="aspectFit" /><text>坚持每天进步一点，词汇量终将奔赴远方。</text></view>
    <image class="asset-landscape celebrate-landscape" src="../../assets/v2/backgrounds/light-bg-landscape-strip@3x.png" mode="aspectFill" />
  </view>

  <view wx:if="{{detail}}" class="modal-mask" bindtap="closeDetail">
    <view class="detail-card" catchtap="noop">
      <view class="icon-button close" bindtap="closeDetail"><view class="ui-icon icon-close"></view></view>
      <text class="section-label">详细词卡</text>
      <text class="detail-word">{{detail.syllables}}</text>
      <text class="ipa">{{detail.ipa}}</text>
      <text class="meaning"><text>{{detail.pos}}</text>{{detail.meaningText}}</text>
      <view class="memory-image"><text class="strong">{{detail.memoryImage.meaning}}</text><text>{{detail.memoryImage.scene}}</text></view>
      <view class="copy-card"><text class="card-title">词库信息</text><text>{{detail.curriculumStage}} · 课标序号 {{detail.sourceIndex}}</text></view>
      <view wx:if="{{detail.usage.hasUsageContent}}" class="usage-card detail-usage-card">
        <view wx:if="{{detail.usage.collocations.length}}" class="usage-section">
          <text class="usage-title">搭配</text>
          <view wx:for="{{detail.usage.collocations}}" wx:key="text" class="usage-chip"><text>{{item.text}}</text><text wx:if="{{item.cn}}">{{item.cn}}</text></view>
        </view>
        <view wx:if="{{detail.usage.example}}" class="usage-section">
          <text class="usage-title">例句</text>
          <text class="usage-example-en">{{detail.usage.example.en}}</text>
          <text wx:if="{{detail.usage.example.cn}}" class="usage-example-cn">{{detail.usage.example.cn}}</text>
        </view>
        <text wx:if="{{detail.usage.aiLabel}}" class="usage-ai-label">{{detail.usage.aiLabel}}</text>
      </view>
      <view wx:else class="copy-card"><text class="card-title">例句与搭配</text><text>授权词典数据待接入。</text></view>
    </view>
  </view>
  <view wx:if="{{focusPauseVisible}}" class="modal-mask focus-pause-mask" catchtap="closePausePanel">
    <view class="focus-pause-card" catchtap="noop">
      <text class="pause-count">{{focusPause.learnedText}}</text>
      <view class="primary-button" catchtap="closePausePanel">继续学习</view>
      <view class="secondary-button" catchtap="pauseToHome">暂停休息</view>
      <view class="secondary-button" catchtap="pauseToProfile">调整计划</view>
    </view>
  </view>
  <view wx:if="{{audioCompletionNotice}}" class="transition-mask notice-mask">
    <view class="transition-card">
      <text>{{audioCompletionNotice}}</text>
      <text wx:if="{{audioCompletionHint}}" class="transition-hint">{{audioCompletionHint}}</text>
    </view>
  </view>
  <view wx:if="{{view == 'home'}}" class="tab-bar bottom-tab-bar">
    <view class="tab-item active" bindtap="openWordsTab">
      <image class="home-icon tab-icon-image" src="../../assets/v2/icons/shared-icon-open-book@3x.png" mode="aspectFit" />
      <text>单词</text>
    </view>
    <view class="tab-item" bindtap="openProfile">
      <image class="home-icon tab-icon-image muted-tab-icon" src="../../assets/icons/user.svg" mode="aspectFit" />
      <text>我的</text>
    </view>
  </view>
  <view wx:if="{{view == 'profile'}}" class="tab-bar bottom-tab-bar">
    <view class="tab-item" bindtap="openWordsTab">
      <image class="home-icon tab-icon-image muted-tab-icon" src="../../assets/v2/icons/shared-icon-open-book@3x.png" mode="aspectFit" />
      <text>单词</text>
    </view>
    <view class="tab-item active" bindtap="openProfile">
      <image class="home-icon tab-icon-image" src="../../assets/icons/user.svg" mode="aspectFit" />
      <text>我的</text>
    </view>
  </view>
</view>
