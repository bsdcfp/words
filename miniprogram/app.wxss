page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 16% 4%, rgba(120, 168, 150, 0.08), transparent 30%),
    radial-gradient(circle at 88% 14%, rgba(232, 166, 76, 0.07), transparent 28%),
    linear-gradient(180deg, #fcf9f3 0%, #f7f2e8 56%, #f2ecdf 100%);
  color: #2c2b26;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button {
  font: inherit;
  margin: 0;
  box-sizing: border-box;
}

button::after {
  border: 0;
}
