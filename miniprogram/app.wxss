page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 18% 8%, rgba(103, 216, 200, 0.12), transparent 32%),
    radial-gradient(circle at 84% 86%, rgba(215, 128, 85, 0.1), transparent 32%),
    linear-gradient(180deg, #f8f5ec 0%, #eee3d4 56%, #f6efe4 100%);
  color: #1b201f;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button {
  font: inherit;
  margin: 0;
  box-sizing: border-box;
}

button::after {
  border: 0;
}
