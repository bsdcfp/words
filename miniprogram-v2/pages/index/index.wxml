<!-- ===================================================
  首页 — 05-home-normal 视觉规格
  =================================================== -->
<view class="page-root">

  <!-- ① 状态栏占位 -->
  <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>

  <!-- ② 顶部渐变遮罩（氛围层，绝对定位，不占流） -->
  <view class="top-gradient-overlay"></view>

  <!-- ③ 顶部导航栏 -->
  <view class="navbar">
    <!-- 左侧：书本图标 + 书名 + 下拉箭头 -->
    <view class="navbar-left" hover-class="navbar-left-hover" catchtap="onBookSelectorTap">
      <view class="navbar-book-icon">
        <text class="navbar-book-icon-text">书</text>
      </view>
      <text class="navbar-book-name">{{bookName}}</text>
      <text class="navbar-arrow">⌄</text>
    </view>
    <!-- 右侧：连续打卡 -->
    <view class="navbar-right">
      <view class="streak-dot"></view>
      <text class="streak-label">连续 {{streakDays}} 天</text>
    </view>
  </view>

  <!-- ④ 主内容滚动区 -->
  <scroll-view class="content-scroll" scroll-y="true" enhanced="true" show-scrollbar="false">

    <!-- 间距：导航栏到第一张卡片 -->
    <view class="gap-section"></view>

    <!-- ─── 卡片 1：单词书进度 ─── -->
    <view class="card card-progress">
      <!-- 卡片头部：书封面 + 标签行 -->
      <view class="progress-header">
        <view class="book-cover-thumb">
          <text class="book-cover-thumb-text">封</text>
        </view>
        <text class="card-label">单词书进度</text>
      </view>

      <!-- 书名 -->
      <view class="gap-label"></view>
      <text class="book-title">{{bookName}}</text>

      <!-- 进度数字 + 百分比 -->
      <view class="gap-title"></view>
      <view class="progress-numbers">
        <text class="progress-number-main">{{bookLearned}}</text>
        <text class="progress-number-sep"> / </text>
        <text class="progress-number-total">{{bookTotal}}</text>
        <text class="progress-number-percent">{{progressPercent}}</text>
      </view>

      <!-- 进度条 -->
      <view class="gap-numbers"></view>
      <view class="progress-track">
        <view class="progress-fill" style="width: {{progressWidth}};"></view>
      </view>

      <!-- 里程碑旗帜（均分 5 个） -->
      <view class="gap-bar"></view>
      <view class="milestone-flags">
        <view class="milestone-flag" wx:for="{{[1,2,3,4,5]}}" wx:key="index">
          <text class="milestone-flag-icon">🚩</text>
        </view>
      </view>
    </view>

    <!-- 间距：卡片之间 -->
    <view class="gap-card"></view>

    <!-- ─── 卡片 2：今日目标 ─── -->
    <view class="card card-goal">
      <!-- 标签 -->
      <view class="goal-label-row">
        <view class="goal-dot"></view>
        <text class="card-label">今日目标</text>
      </view>

      <!-- 大数字 + 单位 -->
      <view class="goal-number-row">
        <text class="goal-number-display">{{goalTotal}}</text>
        <text class="goal-number-unit">个 List</text>
      </view>

      <!-- 旗帜进度 -->
      <view class="goal-flags">
        <view
          class="goal-flag-item {{item.done ? 'goal-flag-done' : 'goal-flag-pending'}}"
          wx:for="{{goalFlags}}"
          wx:key="index"
        >
          <text class="goal-flag-icon">🚩</text>
        </view>
      </view>

      <!-- CTA 按钮 -->
      <view
        class="btn-cta"
        hover-class="btn-cta-hover"
        catchtap="onContinueTap"
      >
        <text class="btn-cta-text">继续</text>
      </view>
    </view>

    <!-- 间距：卡片之间 -->
    <view class="gap-card"></view>

    <!-- ─── 错词提示条 ─── -->
    <view
      class="wrong-words-bar"
      hover-class="wrong-words-bar-hover"
      catchtap="onWrongWordsTap"
    >
      <!-- 左侧 -->
      <view class="wrong-words-left">
        <view class="wrong-words-icon">
          <text class="wrong-words-icon-text">✕</text>
        </view>
        <text class="wrong-words-text">{{wrongCount}} 个错词待复习</text>
      </view>
      <!-- 右侧 -->
      <text class="wrong-words-hint">晚间入口已开启</text>
    </view>

    <!-- 底部内容间距（给 tab 栏留空间） -->
    <view class="content-bottom-spacer" style="height: calc(120rpx + {{safeAreaBottom}}px + 40rpx);"></view>
  </scroll-view>

  <!-- ⑤ 底部 Tab 栏（fixed 定位） -->
  <view class="tabbar" style="padding-bottom: {{safeAreaBottom}}px;">
    <view class="tabbar-divider"></view>
    <view class="tabbar-inner">
      <!-- Tab: 单词 -->
      <view
        class="tab-item {{currentView === 'home' ? 'tab-item-active' : 'tab-item-inactive'}}"
        data-view="home"
        catchtap="onTabTap"
      >
        <text class="tab-icon">📖</text>
        <text class="tab-label">单词</text>
      </view>
      <!-- Tab: 我的 -->
      <view
        class="tab-item {{currentView === 'profile' ? 'tab-item-active' : 'tab-item-inactive'}}"
        data-view="profile"
        catchtap="onTabTap"
      >
        <text class="tab-icon">👤</text>
        <text class="tab-label">我的</text>
      </view>
    </view>
  </view>

</view>
