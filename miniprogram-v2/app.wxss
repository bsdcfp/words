/* ===================================================
   全局设计 Token — Dark 主题 (默认)
   =================================================== */
.theme-dark, page {
  /* 背景 */
  --bg-primary: #0B1A17;
  --bg-card: rgba(19, 40, 34, 0.85);
  --bg-card-solid: #132822;
  --bg-card-elevated: rgba(25, 50, 42, 0.90);
  --bg-hint: #1E3D34;
  --bg-tabbar: rgba(10, 22, 19, 0.96);
  --bg-input: #0F261F;

  /* 描边 */
  --border-card: #24413E;
  --border-option: rgba(94, 138, 122, 0.3);
  --border-option-selected: #5E8A7A;
  --border-divider: #1E3D34;

  /* 文字 */
  --text-primary: #FFF9EF;
  --text-secondary: #A9B7B2;
  --text-label: #5E8A7A;
  --text-disabled: rgba(169, 183, 178, 0.4);

  /* 强调 */
  --accent: #D97757;
  --accent-hover: rgba(217, 119, 87, 0.85);
  --accent-glow: rgba(217, 119, 87, 0.25);
  --success: #5E8A7A;
  --success-bright: #7ABFA8;
  --error-flash: rgba(217, 87, 87, 0.6);

  /* 进度 */
  --progress-track: #1E3D34;
  --progress-fill: #D97757;
  --dot-complete: #5E8A7A;
  --dot-current: #7ABFA8;
  --dot-pending: rgba(94, 138, 122, 0.25);

  /* Tab */
  --tab-inactive: #5E8A7A;
  --tab-active: #D97757;

  /* 间距 */
  --page-margin: 40rpx;
  --card-padding: 48rpx;
  --card-gap: 24rpx;
  --section-gap: 32rpx;
  --item-gap: 16rpx;
  --label-gap: 12rpx;

  /* 圆角 */
  --radius-card: 40rpx;
  --radius-button: 24rpx;
  --radius-pill: 999rpx;
  --radius-option: 20rpx;
  --radius-bar: 6rpx;
  --radius-input: 16rpx;
}

/* ===================================================
   Light 主题
   =================================================== */
.theme-light {
  /* 背景 */
  --bg-primary: #F5F0E8;
  --bg-card: rgba(255, 255, 255, 0.75);
  --bg-card-solid: #FFFFFF;
  --bg-card-elevated: rgba(255, 255, 255, 0.90);
  --bg-hint: rgba(255, 255, 255, 0.60);
  --bg-tabbar: rgba(255, 255, 255, 0.96);
  --bg-input: rgba(255, 255, 255, 0.50);

  /* 描边 */
  --border-card: rgba(180, 160, 130, 0.25);
  --border-option: rgba(180, 160, 130, 0.3);
  --border-option-selected: #8B7355;
  --border-divider: rgba(180, 160, 130, 0.2);

  /* 文字 */
  --text-primary: #2C2418;
  --text-secondary: #7A6E5E;
  --text-label: #A89880;
  --text-disabled: rgba(122, 110, 94, 0.4);

  /* 强调 */
  --accent: #D4935A;
  --accent-hover: rgba(212, 147, 90, 0.85);
  --accent-glow: rgba(212, 147, 90, 0.25);
  --success: #5E8A6A;
  --success-bright: #4A9B7A;
  --error-flash: rgba(200, 80, 80, 0.4);

  /* 进度 */
  --progress-track: rgba(180, 160, 130, 0.2);
  --progress-fill: #D4935A;
  --dot-complete: #5E8A6A;
  --dot-current: #4A9B7A;
  --dot-pending: rgba(94, 138, 106, 0.25);

  /* Tab */
  --tab-inactive: #A89880;
  --tab-active: #D4935A;
}

/* ===================================================
   全局重置
   =================================================== */
page {
  background-color: #0B1A17;
  background-color: var(--bg-primary, #0B1A17);
  font-family: PingFang SC, -apple-system, system-ui, sans-serif;
  font-size: 28rpx;
  color: #FFF9EF;
  color: var(--text-primary, #FFF9EF);
  box-sizing: border-box;
}

* {
  box-sizing: border-box;
}
